#include <tunables/global>

# Docker's default container policy, with only bubblewrap's staging mounts
# permitted. All mount destinations are confined to bubblewrap's temporary
# /tmp and /newroot trees. The container receives no CAP_SYS_ADMIN, so the
# kernel additionally permits these operations only inside bubblewrap's
# unprivileged user/mount namespaces.
profile kandev-codex flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,

  # Bubblewrap namespace initialization and staging root.
  mount options=(rw,rslave,silent) -> /,
  mount fstype=tmpfs options in (rw,nosuid,nodev) ** -> /tmp/,
  mount options in (rw,rbind,silent) /tmp/newroot/ -> /tmp/newroot/,
  pivot_root oldroot=/tmp/oldroot/ /tmp/,

  # Filesystems created inside the staging root.
  mount fstype=tmpfs options in (rw,nosuid,nodev) ** -> /newroot{,/**},
  mount fstype=devpts options in (rw,nosuid,noexec) ** -> /newroot/dev/pts/,
  # A PID namespace needs a private procfs. Confine that mount to Bubblewrap's
  # staging root so a guarded process cannot remount or inspect host procfs.
  mount fstype=proc -> /newroot/proc/,

  # Bind existing container paths into the staging root, then make selected
  # paths read-only. Sources cannot escape the already-confined container root.
  mount options in (rw,rbind,silent) /oldroot{,/**} -> /newroot{,/**},
  remount options in (ro,nosuid,nodev,noexec,bind,silent,relatime) /newroot{,/**},

  # Detach the old root after switching to the completed sandbox tree.
  mount options=(rw,rprivate,silent) -> /oldroot/,
  pivot_root oldroot=/newroot/ /newroot/,

  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (send,receive) peer=kandev-codex,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/kernel/security/** rwklx,

  ptrace (trace,read) peer=kandev-codex,
}
