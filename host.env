# host.env — REAL machine-specific values for THIS host. GIT-IGNORED, never pushed.
#
# ── Agent reference (placeholder → real value mapping) ───────────────────────
# The committed files in this repo use generic placeholders so the repo can be
# public. When working on THIS machine, treat the placeholders as aliases for
# the real values below:
#
#   Placeholder (in repo)      Real value (this deployment)
#   ─────────────────────      ────────────────────────────
#   office-desktop / alice     sfl-desktop / ayattara      (office workstation)
#   home-server   / bob        mini-desktop / alassane     (always-on hub)
#   laptop        / carol      yattara-pc  / yattara       (portable fallback)
#   10.0.0.20                  10.0.0.182                  (hub LAN IP)
#   192.168.1.10               192.168.50.211              (office LAN IP)
#   board.office               board.sfl                   (office UI hostname)
#   example-corp / Corp        savoirfairelinux / SFL      (employer / VPN)
#   Code/work-project          Code/scsl                   (private work repo)
#   host-id office/home/laptop sfl/mini/yattara            (per-host replica ids)
#
# This host is the OFFICE workstation (host-id "sfl").
# ─────────────────────────────────────────────────────────────────────────────

# Hub (always-on machine storing the Litestream replica + restic repo)
MINI_HOST=10.0.0.182
MINI_USER=alassane

# Office / workstation satellite (used by sync-*-office.sh, run from the hub)
OFFICE_HOST=sfl-desktop
OFFICE_USER=ayattara
OFFICE_PING_IP=192.168.50.211

# This host's identity (matches the existing ~/.kandev-host-id)
KANDEV_HOST_ID=sfl

# SSH key that reaches the hub over SFTP (Litestream restore / restic backup)
SSH_KEY=$HOME/.ssh/ayattara_key
LITESTREAM_KEY=$HOME/.ssh/ayattara_key
