+	response, err = h.handleGetOwnQuestionStatus(ctx, makeWSMessage(t, ws.ActionMCPGetOwnQuestionStatus, map[string]any{"session_id": "own-session", "question_ids": []string{q[0].ID}}))
+	require.NoError(t, err)
