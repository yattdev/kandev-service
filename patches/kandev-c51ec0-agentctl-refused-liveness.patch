diff --git a/apps/backend/internal/agent/runtime/lifecycle/manager_interaction.go b/apps/backend/internal/agent/runtime/lifecycle/manager_interaction.go
index 8b963a9c8..cfed8aeb8 100644
--- a/apps/backend/internal/agent/runtime/lifecycle/manager_interaction.go
+++ b/apps/backend/internal/agent/runtime/lifecycle/manager_interaction.go
@@ -7,6 +7,7 @@ import (
 	"maps"
 	"sort"
 	"strings"
+	"syscall"
 	"time"
 
 	"go.uber.org/zap"
@@ -1415,6 +1416,17 @@ func (m *Manager) ProbeAgentRunningForSession(ctx context.Context, sessionID str
 
 	status, err := execution.agentctl.GetStatus(ctx)
 	if err != nil {
+		// agentctl is bound to a loopback port owned by this execution. Once the
+		// startup grace has elapsed, an actively refused connection means that
+		// listener no longer exists, so the runtime is definitively not live.
+		// Preserve fail-closed behavior for timeouts and all other ambiguous
+		// transport failures.
+		if errors.Is(err, syscall.ECONNREFUSED) {
+			m.logger.Debug("agentctl status listener is gone",
+				zap.String("session_id", sessionID),
+				zap.Error(err))
+			return false, nil
+		}
 		m.logger.Debug("failed to get agentctl status",
 			zap.String("session_id", sessionID),
 			zap.Error(err))
