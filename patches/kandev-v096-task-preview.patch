diff --git a/apps/backend/internal/taskpreview/grant.go b/apps/backend/internal/taskpreview/grant.go
new file mode 100644
index 0000000000..661ecd8ea2
--- /dev/null
+++ b/apps/backend/internal/taskpreview/grant.go
@@ -0,0 +1,182 @@
+// Package taskpreview implements an operator-registered single-target preview.
+package taskpreview
+
+import (
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/url"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const Lifetime = 24 * time.Hour
+
+var ErrDenied = errors.New("preview access denied")
+var uuidPattern = regexp.MustCompile(`^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$`)
+var digestPattern = regexp.MustCompile(`^[a-f0-9]{64}$`)
+var noncePattern = regexp.MustCompile(`^[a-f0-9]{32}$`)
+var projectPattern = regexp.MustCompile(`^kd_[a-f0-9]{24}$`)
+var servicePattern = regexp.MustCompile(`^[a-z][a-z0-9_-]{0,63}$`)
+
+// Grant is operator-installed; HTTP callers cannot select or register targets.
+type Grant struct {
+	ID             string `json:"id"`
+	ApprovalID     string `json:"approval_id"`
+	ApprovalSHA256 string `json:"approval_sha256"`
+	EnvironmentID  string `json:"environment_id"`
+	TaskID         string `json:"task_id"`
+	WorkspaceID    string `json:"workspace_id"`
+	UserID         string `json:"user_id"`
+	TaskRoot       string `json:"task_root"`
+	CWD            string `json:"cwd"`
+	ContainerID    string `json:"container_id"`
+	ImageID        string `json:"image_id"`
+	Project        string `json:"project"`
+	Service        string `json:"service"`
+	HostPort       int    `json:"host_port"`
+	ContainerPort  int    `json:"container_port"`
+	ModelPath      string `json:"model_path"`
+	ClaimPath      string `json:"claim_path"`
+	ModelSHA256    string `json:"model_sha256"`
+	MainOrigin     string `json:"main_origin"`
+	PreviewOrigin  string `json:"preview_origin"`
+	ListenAddress  string `json:"listen_address"`
+	IssuedAt       int64  `json:"issued_at"`
+	ExpiresAt      int64  `json:"expires_at"`
+}
+
+func (g Grant) Validate() error {
+	for _, id := range []string{g.ID, g.ApprovalID, g.EnvironmentID, g.TaskID, g.WorkspaceID} {
+		if !uuidPattern.MatchString(id) {
+			return ErrDenied
+		}
+	}
+	main, err := origin(g.MainOrigin)
+	if err != nil {
+		return err
+	}
+	preview, err := origin(g.PreviewOrigin)
+	if err != nil || strings.EqualFold(main.Hostname(), preview.Hostname()) {
+		return ErrDenied
+	}
+	if !privateListener(g.ListenAddress, preview.Port()) || !digestPattern.MatchString(g.ApprovalSHA256) {
+		return ErrDenied
+	}
+	if g.validateTarget() != nil || g.validatePaths() != nil || g.IssuedAt <= 0 || g.ExpiresAt-g.IssuedAt != int64(Lifetime/time.Second) {
+		return ErrDenied
+	}
+	return nil
+}
+
+func validPort(port int) bool { return port >= 1024 && port <= 65535 }
+func (g Grant) validateTarget() error {
+	if g.UserID == "" || len(g.UserID) > 128 || !digestPattern.MatchString(g.ContainerID) ||
+		!strings.HasPrefix(g.ImageID, "sha256:") || !digestPattern.MatchString(strings.TrimPrefix(g.ImageID, "sha256:")) ||
+		!projectPattern.MatchString(g.Project) || !servicePattern.MatchString(g.Service) ||
+		!validPort(g.HostPort) || !validPort(g.ContainerPort) || !digestPattern.MatchString(g.ModelSHA256) {
+		return ErrDenied
+	}
+	return nil
+}
+func (g Grant) validatePaths() error {
+	if !strings.HasPrefix(g.TaskRoot, "/data/tasks/") || !strings.HasPrefix(g.CWD, g.TaskRoot+"/") ||
+		filepath.Clean(g.TaskRoot) != g.TaskRoot || filepath.Clean(g.CWD) != g.CWD {
+		return ErrDenied
+	}
+	rootHash := sha256.Sum256([]byte(g.TaskRoot))
+	projectHash := sha256.Sum256([]byte(g.Project))
+	filename := hex.EncodeToString(projectHash[:]) + ".json"
+	registry := filepath.Dir(filepath.Dir(g.ModelPath))
+	if !filepath.IsAbs(g.ModelPath) || filepath.Base(registry) != "agent-docker-models" ||
+		filepath.Base(filepath.Dir(g.ModelPath)) != hex.EncodeToString(rootHash[:]) || filepath.Base(g.ModelPath) != filename ||
+		g.ClaimPath != filepath.Join(registry, "projects", filename) {
+		return ErrDenied
+	}
+	return nil
+}
+
+func privateListener(address, publicPort string) bool {
+	host, port, err := net.SplitHostPort(address)
+	ip := net.ParseIP(host)
+	if publicPort == "" {
+		publicPort = "443"
+	}
+	number, portErr := strconv.Atoi(port)
+	return err == nil && portErr == nil && number >= 1024 && number <= 65535 && port == publicPort && ip != nil && (ip.IsPrivate() || ip.IsLoopback())
+}
+
+func origin(raw string) (*url.URL, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "https" || u.Host == "" || u.User != nil || u.Path != "" || u.RawQuery != "" || u.Fragment != "" || u.Port() == "443" || u.Hostname() != strings.ToLower(u.Hostname()) {
+		return nil, ErrDenied
+	}
+	return u, nil
+}
+func (g Grant) Active(now time.Time) bool {
+	return now.Unix() >= g.IssuedAt && now.Unix() < g.ExpiresAt
+}
+func (g Grant) Digest() string {
+	b, _ := json.Marshal(g)
+	sum := sha256.Sum256(b)
+	return hex.EncodeToString(sum[:])
+}
+
+type Claims struct {
+	Grant   string `json:"grant"`
+	Binding string `json:"binding"`
+	User    string `json:"user"`
+	Nonce   string `json:"nonce"`
+	Issued  int64  `json:"issued"`
+	Expires int64  `json:"expires"`
+}
+
+func newClaims(g Grant, now time.Time, ttl time.Duration) Claims {
+	var nonce [16]byte
+	if _, err := rand.Read(nonce[:]); err != nil {
+		panic(err)
+	}
+	exp := now.Add(ttl).Unix()
+	if exp > g.ExpiresAt {
+		exp = g.ExpiresAt
+	}
+	return Claims{g.ID, g.Digest(), g.UserID, hex.EncodeToString(nonce[:]), now.Unix(), exp}
+}
+func sign(key []byte, purpose string, c Claims) string {
+	b, _ := json.Marshal(c)
+	raw := base64.RawURLEncoding.EncodeToString(b)
+	h := hmac.New(sha256.New, key)
+	h.Write([]byte(purpose + "." + raw))
+	return raw + "." + base64.RawURLEncoding.EncodeToString(h.Sum(nil))
+}
+func verify(key []byte, purpose, token string, g Grant, now time.Time) (Claims, error) {
+	var c Claims
+	parts := strings.Split(token, ".")
+	if len(parts) != 2 || len(token) > 2048 {
+		return c, ErrDenied
+	}
+	h := hmac.New(sha256.New, key)
+	h.Write([]byte(purpose + "." + parts[0]))
+	mac, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil || !hmac.Equal(mac, h.Sum(nil)) {
+		return c, ErrDenied
+	}
+	b, err := base64.RawURLEncoding.DecodeString(parts[0])
+	if err != nil || json.Unmarshal(b, &c) != nil || !validClaims(c, g, now) {
+		return c, ErrDenied
+	}
+	return c, nil
+}
+
+func validClaims(c Claims, g Grant, now time.Time) bool {
+	return noncePattern.MatchString(c.Nonce) && c.Grant == g.ID && c.Binding == g.Digest() && c.User == g.UserID &&
+		c.Issued <= now.Unix() && c.Issued >= g.IssuedAt && c.Expires > now.Unix() && c.Expires <= g.ExpiresAt && g.Active(now)
+}
diff --git a/apps/backend/internal/taskpreview/inspector.go b/apps/backend/internal/taskpreview/inspector.go
new file mode 100644
index 0000000000..f815003770
--- /dev/null
+++ b/apps/backend/internal/taskpreview/inspector.go
@@ -0,0 +1,94 @@
+package taskpreview
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"os/exec"
+	"strconv"
+	"time"
+)
+
+type Inspector interface {
+	Validate(context.Context, Grant) error
+}
+type DockerInspector struct {
+	Binary string
+	Models bool // only the outer backend reads its existing exact model/claim paths
+}
+
+func (d DockerInspector) Validate(ctx context.Context, g Grant) error {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	format := `{"id":{{json .Id}},"image":{{json .Image}},"running":{{json .State.Running}},"labels":{"com.docker.compose.project":{{json (index .Config.Labels "com.docker.compose.project")}},"com.docker.compose.service":{{json (index .Config.Labels "com.docker.compose.service")}}},"ports":{{json .NetworkSettings.Ports}}}`
+	command := exec.CommandContext(ctx, d.Binary, "inspect", "--type", "container", "--format", format, g.ContainerID)
+	command.Env = []string{"PATH=/usr/bin:/bin", "DOCKER_HOST=unix:///var/run/docker.sock", "DOCKER_CONFIG=/run/kandev-preview-empty-docker-config"}
+	b, err := command.Output()
+	if err != nil || len(b) > 16384 {
+		return ErrDenied
+	}
+	if err := ValidateInspection(b, g); err != nil {
+		return err
+	}
+	if d.Models {
+		return validateModel(g)
+	}
+	return nil
+}
+func ValidateInspection(b []byte, g Grant) error {
+	var record struct {
+		ID      string            `json:"id"`
+		Image   string            `json:"image"`
+		Running bool              `json:"running"`
+		Labels  map[string]string `json:"labels"`
+		Ports   map[string][]struct {
+			HostIP   string `json:"HostIp"`
+			HostPort string `json:"HostPort"`
+		} `json:"ports"`
+	}
+	if json.Unmarshal(b, &record) != nil || record.ID != g.ContainerID || record.Image != g.ImageID || !record.Running ||
+		record.Labels["com.docker.compose.project"] != g.Project || record.Labels["com.docker.compose.service"] != g.Service {
+		return ErrDenied
+	}
+	ports := record.Ports[strconv.Itoa(g.ContainerPort)+"/tcp"]
+	if len(record.Ports) != 1 || len(ports) != 1 || ports[0].HostIP != "127.0.0.1" || ports[0].HostPort != strconv.Itoa(g.HostPort) {
+		return ErrDenied
+	}
+	return nil
+}
+func boundedFile(path string) ([]byte, error) {
+	f, err := privateFile(path)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = f.Close() }()
+	fi, err := f.Stat()
+	if err != nil || fi.Size() > 1048576 {
+		return nil, ErrDenied
+	}
+	return io.ReadAll(io.LimitReader(f, 1048577))
+}
+func validateModel(g Grant) error {
+	b, err := boundedFile(g.ModelPath)
+	if err != nil {
+		return ErrDenied
+	}
+	hash := sha256.Sum256(b)
+	if hex.EncodeToString(hash[:]) != g.ModelSHA256 {
+		return ErrDenied
+	}
+	for _, path := range []string{g.ModelPath, g.ClaimPath} {
+		b, err = boundedFile(path)
+		var record struct {
+			TaskRoot string `json:"task_root"`
+			CWD      string `json:"cwd"`
+			Project  string `json:"project"`
+		}
+		if err != nil || json.Unmarshal(b, &record) != nil || record.TaskRoot != g.TaskRoot || record.CWD != g.CWD || record.Project != g.Project {
+			return ErrDenied
+		}
+	}
+	return nil
+}
diff --git a/apps/backend/internal/taskpreview/preview_test.go b/apps/backend/internal/taskpreview/preview_test.go
new file mode 100644
index 0000000000..50fcd32c1c
--- /dev/null
+++ b/apps/backend/internal/taskpreview/preview_test.go
@@ -0,0 +1,374 @@
+package taskpreview
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type roundTrip func(*http.Request) (*http.Response, error)
+
+func (f roundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type inspectFunc func(context.Context, Grant) error
+
+func (f inspectFunc) Validate(c context.Context, g Grant) error { return f(c, g) }
+
+type fixture struct {
+	store     Store
+	grant     Grant
+	key       []byte
+	clock     atomic.Int64
+	allow     atomic.Bool
+	container atomic.Bool
+	checks    atomic.Int64
+	upstream  *httptest.Server
+	control   *Control
+	gate      *Gateway
+}
+
+func newFixture(t *testing.T) *fixture {
+	t.Helper()
+	f := &fixture{store: Store{Directory: t.TempDir()}, key: []byte(strings.Repeat("k", 32))}
+	f.clock.Store(1700000000)
+	f.allow.Store(true)
+	f.container.Store(true)
+	if err := os.Chmod(f.store.Directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Mkdir(filepath.Join(f.store.Directory, "nonces"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	f.upstream = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if strings.Contains(r.Header.Get("Cookie"), cookieName) || r.Header.Get("Authorization") != "" {
+			t.Error("ingress credential reached trial")
+		}
+		w.Header().Add("Set-Cookie", cookieName+"=forged; Path=/")
+		w.Header().Add("Set-Cookie", "trial=local; Path=/")
+		w.Header().Set("Content-Type", "text/html")
+		_, _ = fmt.Fprint(w, "synthetic-trial:"+r.URL.Path)
+	}))
+	t.Cleanup(f.upstream.Close)
+	u, _ := url.Parse(f.upstream.URL)
+	port, _ := strconv.Atoi(u.Port())
+	f.grant = Grant{ID: "85278886-f97b-4219-b7ba-9182f7059c69", ApprovalID: "5047d7b6-8074-4e24-a025-7912eb4223d8", TaskID: "afdb2ef3-06ca-4cd5-a074-c4e691679da9", WorkspaceID: "2e62401b-5ffe-4050-bc1b-d49ea5d5dbcd", UserID: "owner", TaskRoot: "/data/tasks/fixture", CWD: "/data/tasks/fixture/ct", ContainerID: strings.Repeat("a", 64), ImageID: "sha256:" + strings.Repeat("b", 64), Project: "kd_" + strings.Repeat("c", 24), Service: "core", HostPort: port, ContainerPort: 59430, MainOrigin: "https://main.example.test", PreviewOrigin: "https://isolated.example.test:59433", IssuedAt: f.clock.Load(), ExpiresAt: f.clock.Load() + 86400}
+	f.grant.ApprovalSHA256 = strings.Repeat("a", 64)
+	f.grant.EnvironmentID = "0e3a05ec-e777-42a1-bdca-7dd4a8e75dbb"
+	f.grant.ListenAddress = "127.0.0.1:59433"
+	model, _ := json.Marshal(map[string]string{"task_root": f.grant.TaskRoot, "cwd": f.grant.CWD, "project": f.grant.Project})
+	rootHash := sha256.Sum256([]byte(f.grant.TaskRoot))
+	projectHash := sha256.Sum256([]byte(f.grant.Project))
+	registry := filepath.Join(f.store.Directory, "agent-docker-models")
+	f.grant.ModelPath = filepath.Join(registry, hex.EncodeToString(rootHash[:]), hex.EncodeToString(projectHash[:])+".json")
+	f.grant.ClaimPath = filepath.Join(registry, "projects", hex.EncodeToString(projectHash[:])+".json")
+	for _, path := range []string{f.grant.ModelPath, f.grant.ClaimPath} {
+		if e := os.MkdirAll(filepath.Dir(path), 0700); e != nil {
+			t.Fatal(e)
+		}
+	}
+	sum := sha256.Sum256(model)
+	f.grant.ModelSHA256 = hex.EncodeToString(sum[:])
+	for _, p := range []string{f.grant.ModelPath, f.grant.ClaimPath} {
+		if err := os.WriteFile(p, model, 0600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	f.save(t)
+	if err := os.WriteFile(filepath.Join(f.store.Directory, "key"), f.key, 0600); err != nil {
+		t.Fatal(err)
+	}
+	f.control = &Control{Store: f.store, Now: f.now, Identity: func(r *http.Request) (Principal, bool) {
+		user := r.Header.Get("Test-User")
+		return Principal{UserID: user, SessionID: "native-session", Synthetic: user == "synthetic"}, user != ""
+	}, Authorize: func(_ context.Context, user string, g Grant) error {
+		f.checks.Add(1)
+		if !f.allow.Load() || user != "owner" || g.TaskID != f.grant.TaskID || g.WorkspaceID != f.grant.WorkspaceID {
+			return ErrDenied
+		}
+		return nil
+	}}
+	client := &http.Client{Timeout: time.Second, Transport: roundTrip(func(r *http.Request) (*http.Response, error) {
+		if r.URL.String() != f.grant.MainOrigin+ControlPrefix+"check" {
+			return nil, ErrDenied
+		}
+		w := httptest.NewRecorder()
+		f.control.ServeHTTP(w, r)
+		return w.Result(), nil
+	})}
+	f.control.Inspector = inspectFunc(func(_ context.Context, g Grant) error {
+		if !f.container.Load() {
+			return ErrDenied
+		}
+		b, _ := json.Marshal(map[string]any{"id": g.ContainerID, "image": g.ImageID, "running": true, "labels": map[string]string{"com.docker.compose.project": g.Project, "com.docker.compose.service": g.Service}, "ports": map[string]any{"59430/tcp": []map[string]string{{"HostIp": "127.0.0.1", "HostPort": strconv.Itoa(g.HostPort)}}}})
+		if err := ValidateInspection(b, g); err != nil {
+			return err
+		}
+		return validateModel(g)
+	})
+	f.gate = &Gateway{Store: f.store, Now: f.now, Client: client}
+	return f
+}
+func (f *fixture) now() time.Time { return time.Unix(f.clock.Load(), 0) }
+func (f *fixture) save(t *testing.T) {
+	t.Helper()
+	b, _ := json.Marshal(f.grant)
+	if e := os.WriteFile(filepath.Join(f.store.Directory, "manifest.json"), b, 0600); e != nil {
+		t.Fatal(e)
+	}
+}
+func (f *fixture) session() string {
+	return sign(f.key, "session", newClaims(f.grant, f.now(), Lifetime))
+}
+func (f *fixture) request(method, path, token string) *httptest.ResponseRecorder {
+	r := httptest.NewRequest(method, f.grant.PreviewOrigin+path, nil)
+	r.Header.Set("Origin", f.grant.PreviewOrigin)
+	if token != "" {
+		r.AddCookie(&http.Cookie{Name: cookieName, Value: token})
+		r.AddCookie(&http.Cookie{Name: "trial", Value: "local"})
+	}
+	r.Header.Set("Authorization", "must-not-reach-trial")
+	w := httptest.NewRecorder()
+	f.gate.ServeHTTP(w, r)
+	return w
+}
+
+func TestAuthorizedTrialAndParkedLifetime(t *testing.T) {
+	f := newFixture(t)
+	token := f.session()
+	first := f.request("GET", "/health", token)
+	if first.Code != 200 || first.Body.String() != "synthetic-trial:/health" {
+		t.Fatalf("authorized request: %d", first.Code)
+	}
+	if strings.Contains(first.Header().Get("Content-Security-Policy"), "default-src 'none'") {
+		t.Fatal("app scripts would be blocked")
+	}
+	for _, c := range first.Result().Cookies() {
+		if c.Name == cookieName || !c.Secure {
+			t.Fatal("cookie isolation failed")
+		}
+	}
+	// No executor/session lookup exists: parking does not revoke the registered
+	// running container. Advance through its fixed, independently issued lifetime.
+	f.clock.Add(86399)
+	if f.request("GET", "/", token).Code != 200 {
+		t.Fatal("parked grant expired early")
+	}
+	f.clock.Add(1)
+	if f.request("GET", "/", token).Code != 403 {
+		t.Fatal("grant survived fixed expiry")
+	}
+}
