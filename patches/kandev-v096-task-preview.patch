diff --git a/apps/backend/internal/backendapp/task_preview.go b/apps/backend/internal/backendapp/task_preview.go
new file mode 100644
index 0000000000..4227e50224
--- /dev/null
+++ b/apps/backend/internal/backendapp/task_preview.go
@@ -0,0 +1,62 @@
+package backendapp
+
+import (
+	"context"
+	"github.com/gin-gonic/gin"
+	"github.com/kandev/kandev/internal/auth"
+	"github.com/kandev/kandev/internal/auth/authn"
+	taskmodels "github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/taskpreview"
+	"net/http"
+	"path/filepath"
+	"time"
+)
+
+func registerTaskPreviewRoutes(p routeParams) {
+	if p.authSvc == nil || p.taskSvc == nil {
+		return
+	}
+	control := &taskpreview.Control{Store: taskpreview.Store{Directory: "/run/kandev-task-preview"},
+		Inspector: taskpreview.DockerInspector{Binary: "/usr/bin/docker", Models: true}, Now: time.Now}
+	control.Identity = func(r *http.Request) (taskpreview.Principal, bool) {
+		id, ok := authn.IdentityFromContext(r.Context())
+		return taskpreview.Principal{UserID: id.UserID, SessionID: id.SessionID, Synthetic: id.Synthetic}, ok
+	}
+	control.Authorize = func(ctx context.Context, userID string, g taskpreview.Grant) error {
+		return authorizeTaskPreview(p, ctx, userID, g)
+	}
+
+	for _, path := range []string{"authorize", "credentials"} {
+		p.router.GET(taskpreview.ControlPrefix+path, gin.WrapH(control))
+	}
+	p.router.POST(taskpreview.ControlPrefix+"check", gin.WrapH(control))
+}
+
+func authorizeTaskPreview(p routeParams, ctx context.Context, userID string, g taskpreview.Grant) error {
+	if p.authSvc.Mode() != auth.ModeEnabled || userID != g.UserID {
+		return taskpreview.ErrDenied
+	}
+	identity, ok := p.authSvc.IdentityForUser(ctx, userID)
+	if !ok {
+		return taskpreview.ErrDenied
+	}
+	task, err := p.taskSvc.GetTask(authn.WithIdentity(ctx, identity), g.TaskID)
+	if err != nil || task.WorkspaceID != g.WorkspaceID || task.ArchivedAt != nil {
+		return taskpreview.ErrDenied
+	}
+	environment, err := p.taskSvc.GetTaskEnvironmentByTaskID(ctx, g.TaskID)
+	if err != nil || !previewEnvironmentMatches(environment, g) {
+		return taskpreview.ErrDenied
+	}
+	return nil
+}
+func previewEnvironmentMatches(environment *taskmodels.TaskEnvironment, g taskpreview.Grant) bool {
+	if environment == nil || environment.ID != g.EnvironmentID || environment.TaskID != g.TaskID {
+		return false
+	}
+	root := environment.WorkspacePath
+	if root == "" && environment.TaskDirName != "" {
+		root = filepath.Join("/data/tasks", environment.TaskDirName)
+	}
+	return root == g.TaskRoot
+}
diff --git a/apps/backend/internal/backendapp/task_preview_test.go b/apps/backend/internal/backendapp/task_preview_test.go
new file mode 100644
index 0000000000..142aa35075
--- /dev/null
+++ b/apps/backend/internal/backendapp/task_preview_test.go
@@ -0,0 +1,38 @@
+package backendapp
+
+import (
+	taskmodels "github.com/kandev/kandev/internal/task/models"
+	"github.com/kandev/kandev/internal/taskpreview"
+	"testing"
+)
+
+func TestTaskPreviewRetainedEnvironmentOwnership(t *testing.T) {
+	g := taskpreview.Grant{TaskID: "task", EnvironmentID: "environment", TaskRoot: "/data/tasks/owned"}
+	environment := &taskmodels.TaskEnvironment{ID: g.EnvironmentID, TaskID: g.TaskID, WorkspacePath: g.TaskRoot}
+	if !previewEnvironmentMatches(environment, g) {
+		t.Fatal("registered task root denied")
+	}
+	environment.Status = taskmodels.TaskEnvironmentStatus("parked")
+	if !previewEnvironmentMatches(environment, g) {
+		t.Fatal("parking invalidated ownership")
+	}
+	for _, mutate := range []func(*taskmodels.TaskEnvironment){
+		func(e *taskmodels.TaskEnvironment) { e.ID = "replacement" },
+		func(e *taskmodels.TaskEnvironment) { e.TaskID = "other-task" },
+		func(e *taskmodels.TaskEnvironment) { e.WorkspacePath = "/data/tasks/other" },
+	} {
+		copy := *environment
+		mutate(&copy)
+		if previewEnvironmentMatches(&copy, g) {
+			t.Fatal("substituted ownership accepted")
+		}
+	}
+	if previewEnvironmentMatches(nil, g) {
+		t.Fatal("missing ownership accepted")
+	}
+	environment.WorkspacePath = ""
+	environment.TaskDirName = "owned"
+	if !previewEnvironmentMatches(environment, g) {
+		t.Fatal("legacy retained task-directory identity denied")
+	}
+}
diff --git a/apps/backend/internal/taskpreview/control.go b/apps/backend/internal/taskpreview/control.go
new file mode 100644
index 0000000000..a733128d08
--- /dev/null
+++ b/apps/backend/internal/taskpreview/control.go
@@ -0,0 +1,150 @@
+package taskpreview
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"html"
+	"net"
+	"net/http"
+	"time"
+)
+
+const ControlPrefix = "/api/v1/task-preview/"
+const cookieName = "__Host-kandev-preview"
+
+type Principal struct {
+	UserID, SessionID string
+	Synthetic         bool
+}
+type Authorize func(context.Context, string, Grant) error
+type Control struct {
+	Store     Store
+	Inspector Inspector
+	Authorize Authorize
+	Identity  func(*http.Request) (Principal, bool)
+	Now       func() time.Time
+}
+
+func safeHeaders(w http.ResponseWriter) {
+	w.Header().Set("Cache-Control", "private, no-store")
+	w.Header().Set("Referrer-Policy", "no-referrer")
+	w.Header().Set("X-Content-Type-Options", "nosniff")
+	w.Header().Set("Content-Security-Policy", "default-src 'none'; frame-ancestors 'none'; base-uri 'none'")
+}
+func denied(w http.ResponseWriter) {
+	safeHeaders(w)
+	http.Error(w, "preview access denied", http.StatusForbidden)
+}
+func (c *Control) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	safeHeaders(w)
+	g, key, err := c.Store.Load()
+	if err != nil || !g.Active(c.Now()) {
+		denied(w)
+		return
+	}
+	if r.URL.Path == ControlPrefix+"check" {
+		c.check(w, r, g, key)
+		return
+	}
+	if !c.browserAllowed(r, g) {
+		denied(w)
+		return
+	}
+	if !g.Active(c.Now()) || c.Store.Revoked() {
+		denied(w)
+		return
+	}
+	switch r.URL.Path {
+	case ControlPrefix + "authorize":
+		if r.Method != http.MethodGet || r.URL.RawQuery != "" {
+			denied(w)
+			return
+		}
+		c.handoff(w, g, key)
+	case ControlPrefix + "credentials":
+		c.credentials(w, r)
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func (c *Control) browserAllowed(r *http.Request, g Grant) bool {
+	p, ok := c.Identity(r)
+	if !ok || p.Synthetic || p.SessionID == "" || p.UserID != g.UserID || c.Authorize(r.Context(), p.UserID, g) != nil {
+		return false
+	}
+	if !secureMainRequest(r) || "https://"+r.Host != g.MainOrigin || r.Header.Get("Origin") != "" && r.Header.Get("Origin") != g.MainOrigin {
+		return false
+	}
+	return c.Inspector != nil && c.Inspector.Validate(r.Context(), g) == nil
+}
+func (c *Control) credentials(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet || r.URL.RawQuery != "" || r.Header.Get("Sec-Fetch-Site") == "cross-site" {
+		denied(w)
+		return
+	}
+	b, err := c.Store.read("login.json", 8192)
+	if err != nil {
+		http.Error(w, "owner login delivery pending", http.StatusNotFound)
+		return
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = w.Write(b)
+}
+
+// Only a local TLS terminator may assert the public scheme. A remote caller
+// cannot use X-Forwarded-Proto to obtain a browser ticket over cleartext.
+func secureMainRequest(r *http.Request) bool {
+	if r.TLS != nil {
+		return true
+	}
+	host, _, err := net.SplitHostPort(r.RemoteAddr)
+	ip := net.ParseIP(host)
+	return err == nil && ip != nil && ip.IsLoopback() && r.Header.Get("X-Forwarded-Proto") == "https"
+}
+func (c *Control) handoff(w http.ResponseWriter, g Grant, key []byte) {
+	ticket := sign(key, "ticket", newClaims(g, c.Now(), time.Minute))
+	script := "document.forms[0].submit()"
+	digest := sha256.Sum256([]byte(script))
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.Header().Set("Content-Security-Policy", "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action "+g.PreviewOrigin+"; script-src 'sha256-"+base64.StdEncoding.EncodeToString(digest[:])+"'")
+	_, _ = w.Write([]byte(`<form method="post" action="` + html.EscapeString(g.PreviewOrigin) + `/__preview/redeem"><input type="hidden" name="ticket" value="` + html.EscapeString(ticket) + `"></form><script>` + script + `</script>`))
+}
+func (c *Control) check(w http.ResponseWriter, r *http.Request, g Grant, key []byte) {
+	if r.Method != http.MethodPost || r.URL.RawQuery != "" {
+		denied(w)
+		return
+	}
+	var req struct {
+		Proof  string `json:"proof"`
+		Revoke bool   `json:"revoke"`
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4096)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if decoder.Decode(&req) != nil {
+		denied(w)
+		return
+	}
+	purpose := "check"
+	if req.Revoke {
+		purpose = "revoke"
+	}
+	claims, err := verify(key, purpose, req.Proof, g, c.Now())
+	if err != nil || claims.Expires-claims.Issued > 15 || c.Authorize(r.Context(), claims.User, g) != nil ||
+		c.Inspector == nil || c.Inspector.Validate(r.Context(), g) != nil {
+		denied(w)
+		return
+	}
+	if !g.Active(c.Now()) || c.Store.Revoked() {
+		denied(w)
+		return
+	}
+	if req.Revoke && c.Store.Revoke() != nil {
+		denied(w)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
diff --git a/apps/backend/internal/taskpreview/gateway.go b/apps/backend/internal/taskpreview/gateway.go
new file mode 100644
index 0000000000..589ee28ad5
--- /dev/null
+++ b/apps/backend/internal/taskpreview/gateway.go
@@ -0,0 +1,202 @@
+package taskpreview
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"net/http"
+	"net/http/httputil"
+	"net/url"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type Gateway struct {
+	Store  Store
+	Client *http.Client
+	Now    func() time.Time
+}
+
+func (g *Gateway) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	safeHeaders(w)
+	grant, key, err := g.Store.Load()
+	if err != nil || !grant.Active(g.Now()) || "https://"+r.Host != grant.PreviewOrigin || r.URL.RawQuery != "" && strings.HasPrefix(r.URL.Path, "/__preview/") {
+		denied(w)
+		return
+	}
+	if r.URL.Path == "/__preview/redeem" {
+		g.redeem(w, r, grant, key)
+		return
+	}
+	if r.Header.Get("Service-Worker") != "" {
+		denied(w)
+		return
+	}
+	claims, err := g.browserSession(r, grant, key)
+	if err != nil || g.authorize(r.Context(), grant, key, claims.User) != nil {
+		denied(w)
+		return
+	}
+	if r.URL.Path == "/__preview/revoke" {
+		if r.Method != http.MethodPost || g.remoteAction(r.Context(), grant, key, claims.User, "revoke") != nil {
+			denied(w)
+			return
+		}
+		w.WriteHeader(http.StatusNoContent)
+		return
+	}
+	if strings.HasPrefix(r.URL.Path, "/__preview/") {
+		http.NotFound(w, r)
+		return
+	}
+	g.proxy(w, r, grant, key)
+}
+
+func (g *Gateway) browserSession(r *http.Request, grant Grant, key []byte) (Claims, error) {
+	if !allowedOrigin(r, grant.PreviewOrigin) {
+		return Claims{}, ErrDenied
+	}
+	cookies := 0
+	token := ""
+	for _, cookie := range r.Cookies() {
+		if cookie.Name == cookieName {
+			cookies++
+			token = cookie.Value
+		}
+	}
+	claims, err := verify(key, "session", token, grant, g.Now())
+	if cookies != 1 || err != nil {
+		return Claims{}, ErrDenied
+	}
+	return claims, nil
+}
+func allowedOrigin(r *http.Request, origin string) bool {
+	o := r.Header.Get("Origin")
+	if o != "" {
+		return o == origin
+	}
+	return (r.Method == http.MethodGet || r.Method == http.MethodHead) && r.Header.Get("Upgrade") == "" && r.Header.Get("Sec-Fetch-Site") != "cross-site"
+}
+func (g *Gateway) redeem(w http.ResponseWriter, r *http.Request, grant Grant, key []byte) {
+	if r.Method != http.MethodPost || r.Header.Get("Origin") != grant.MainOrigin {
+		denied(w)
+		return
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, 4096)
+	if r.ParseForm() != nil || len(r.PostForm) != 1 || len(r.PostForm["ticket"]) != 1 {
+		denied(w)
+		return
+	}
+	claims, err := verify(key, "ticket", r.PostForm.Get("ticket"), grant, g.Now())
+	if err != nil || claims.Expires-claims.Issued > 60 || g.authorize(r.Context(), grant, key, claims.User) != nil || g.Store.Redeem(claims) != nil {
+		denied(w)
+		return
+	}
+	session := sign(key, "session", newClaims(grant, g.Now(), Lifetime))
+	http.SetCookie(w, &http.Cookie{Name: cookieName, Value: session, Path: "/", Secure: true, HttpOnly: true, SameSite: http.SameSiteStrictMode, Expires: time.Unix(grant.ExpiresAt, 0)})
+	// Finish a document at the preview origin before navigating: a cross-site
+	// 303 chain can suppress a newly issued SameSite=Strict cookie.
+	script := `location.replace("/")`
+	digest := sha256.Sum256([]byte(script))
+	w.Header().Set("Content-Type", "text/html; charset=utf-8")
+	w.Header().Set("Content-Security-Policy", "default-src 'none'; base-uri 'none'; frame-ancestors 'none'; script-src 'sha256-"+base64.StdEncoding.EncodeToString(digest[:])+"'")
+	_, _ = w.Write([]byte("<script>" + script + "</script>"))
+}
+func (g *Gateway) authorize(ctx context.Context, grant Grant, key []byte, user string) error {
+	return g.remoteAction(ctx, grant, key, user, "check")
+}
+func (g *Gateway) remoteAction(ctx context.Context, grant Grant, key []byte, user, purpose string) error {
+	claims := newClaims(grant, g.Now(), 15*time.Second)
+	claims.User = user
+	b, _ := json.Marshal(map[string]any{"proof": sign(key, purpose, claims), "revoke": purpose == "revoke"})
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, grant.MainOrigin+ControlPrefix+"check", bytes.NewReader(b))
+	if err != nil {
+		return ErrDenied
+	}
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := g.Client.Do(req)
+	if err != nil {
+		return ErrDenied
+	}
+	defer func() { _ = resp.Body.Close() }()
+	if resp.StatusCode != http.StatusNoContent {
+		return ErrDenied
+	}
+	return nil
+}
+func (g *Gateway) proxy(w http.ResponseWriter, r *http.Request, grant Grant, key []byte) {
+	ctx, cancel := context.WithTimeout(r.Context(), time.Unix(grant.ExpiresAt, 0).Sub(g.Now()))
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		g.watch(ctx, cancel, grant, key)
+	}()
+	defer func() { cancel(); <-done }()
+	target, _ := url.Parse("http://127.0.0.1:" + strconv.Itoa(grant.HostPort))
+	proxy := &httputil.ReverseProxy{Rewrite: func(p *httputil.ProxyRequest) {
+		p.SetURL(target)
+		// The outer gate already validated the browser Origin. Normalise the
+		// inner HTTP hop for the unchanged trial's same-origin/CSRF checks;
+		// never require a trust-proxy setting or trial restart.
+		p.Out.Host = target.Host
+		if p.In.Header.Get("Origin") != "" {
+			p.Out.Header.Set("Origin", target.Scheme+"://"+target.Host)
+		}
+		p.Out.Header.Del("Authorization")
+		p.Out.Header.Del("Proxy-Authorization")
+		p.Out.Header.Del("Cookie")
+		for _, cookie := range p.In.Cookies() {
+			if cookie.Name != cookieName {
+				p.Out.AddCookie(cookie)
+			}
+		}
+		p.Out.Header.Del("Forwarded")
+		p.Out.Header.Del("X-Forwarded-Host")
+		p.Out.Header.Del("X-Forwarded-For")
+		p.Out.Header.Del("X-Forwarded-Proto")
+	}, ModifyResponse: func(resp *http.Response) error {
+		if loc, err := url.Parse(resp.Header.Get("Location")); err == nil && loc.Host == target.Host {
+			public, _ := url.Parse(grant.PreviewOrigin)
+			loc.Scheme, loc.Host = public.Scheme, public.Host
+			resp.Header.Set("Location", loc.String())
+		}
+		cookies := resp.Cookies()
+		resp.Header.Del("Set-Cookie")
+		for _, cookie := range cookies {
+			if cookie.Name == cookieName || cookie.Domain != "" {
+				continue
+			}
+			cookie.Secure = true
+			resp.Header.Add("Set-Cookie", cookie.String())
+		}
+		resp.Header.Set("Cache-Control", "private, no-store")
+		resp.Header.Set("Referrer-Policy", "no-referrer")
+		resp.Header.Set("X-Content-Type-Options", "nosniff")
+		resp.Header.Set("X-Frame-Options", "DENY")
+		resp.Header.Add("Content-Security-Policy", "frame-ancestors 'none'")
+		return nil
+	}, ErrorHandler: func(w http.ResponseWriter, _ *http.Request, _ error) {
+		http.Error(w, "preview upstream unavailable", http.StatusBadGateway)
+	}, FlushInterval: -1}
+	w.Header().Del("Content-Security-Policy")
+	proxy.ServeHTTP(w, r.WithContext(ctx))
+}
+func (g *Gateway) watch(ctx context.Context, cancel context.CancelFunc, grant Grant, key []byte) {
+	ticker := time.NewTicker(time.Second)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			current, _, err := g.Store.Load()
+			if err != nil || current.Digest() != grant.Digest() || !grant.Active(g.Now()) || g.authorize(ctx, grant, key, grant.UserID) != nil {
+				cancel()
+				return
+			}
+		}
+	}
+}
