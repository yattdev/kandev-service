@@ -0,0 +1,71 @@
+package taskpreview
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strconv"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestOwnershipLossBeforeDialSendsNoTrialRequest(t *testing.T) {
+	f := newFixture(t)
+	f.upstream.Close()
+	var requests, inspections atomic.Int64
+	f.upstream = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		requests.Add(1)
+		w.WriteHeader(http.StatusOK)
+	}))
+	t.Cleanup(f.upstream.Close)
+	u, _ := url.Parse(f.upstream.URL)
+	f.grant.HostPort, _ = strconv.Atoi(u.Port())
+	f.save(t)
+	original := f.control.Inspector
+	f.control.Inspector = inspectFunc(func(ctx context.Context, g Grant) error {
+		inspections.Add(1)
+		err := original.Validate(ctx, g)
+		// The first answer was valid when read, but ownership changes before
+		// the gateway receives that answer and establishes the target socket.
+		if err == nil {
+			f.container.Store(false)
+		}
+		return err
+	})
+	w := f.request(http.MethodGet, "/", f.session())
+	if requests.Load() != 0 || inspections.Load() < 2 || w.Code != http.StatusBadGateway {
+		t.Fatalf("ownership changed before dial: requests=%d inspections=%d status=%d", requests.Load(), inspections.Load(), w.Code)
+	}
+}
+
+func TestSameContainerRestartDoesNotRetainGrant(t *testing.T) {
+	f := newFixture(t)
+	started := time.Unix(f.clock.Load()-60, 0).UTC().Format(time.RFC3339Nano)
+	record := map[string]any{"id": f.grant.ContainerID, "image": f.grant.ImageID,
+		"running": true, "started_at": started,
+		"labels": map[string]string{"com.docker.compose.project": f.grant.Project, "com.docker.compose.service": f.grant.Service},
+		"ports":  map[string]any{"59430/tcp": []map[string]string{{"HostIp": "127.0.0.1", "HostPort": strconv.Itoa(f.grant.HostPort)}}}}
+	raw, _ := json.Marshal(record)
+	if ValidateInspection(raw, f.grant) != nil {
+		t.Fatal("original container boot denied")
+	}
+	record["started_at"] = time.Unix(f.clock.Load(), 0).UTC().Format(time.RFC3339Nano)
+	raw, _ = json.Marshal(record)
+	if ValidateInspection(raw, f.grant) == nil {
+		t.Fatal("a restarted container retained the original grant")
+	}
+}
+
+func TestContainerBootTimestampRequiredForGrant(t *testing.T) {
+	f := newFixture(t)
+	for _, value := range []string{"", "invalid", time.Unix(f.grant.IssuedAt+60, 0).UTC().Format(time.RFC3339Nano)} {
+		grant := f.grant
+		grant.ContainerStartedAt = value
+		if grant.Validate() == nil {
+			t.Fatal("missing, invalid or future container boot was accepted")
+		}
+	}
+}
diff --git a/apps/backend/internal/taskpreview/gateway.go b/apps/backend/internal/taskpreview/gateway.go
index 589ee28ad5..eb7f93c593 100644
--- a/apps/backend/internal/taskpreview/gateway.go
+++ b/apps/backend/internal/taskpreview/gateway.go
@@ -6,6 +6,7 @@ import (
 	"crypto/sha256"
 	"encoding/base64"
 	"encoding/json"
+	"net"
 	"net/http"
 	"net/http/httputil"
 	"net/url"
@@ -136,7 +137,7 @@ func (g *Gateway) proxy(w http.ResponseWriter, r *http.Request, grant Grant, key
 	}()
 	defer func() { cancel(); <-done }()
 	target, _ := url.Parse("http://127.0.0.1:" + strconv.Itoa(grant.HostPort))
-	proxy := &httputil.ReverseProxy{Rewrite: func(p *httputil.ProxyRequest) {
+	proxy := &httputil.ReverseProxy{Transport: g.boundTransport(target.Host, grant, key), Rewrite: func(p *httputil.ProxyRequest) {
 		p.SetURL(target)
 		// The outer gate already validated the browser Origin. Normalise the
 		// inner HTTP hop for the unchanged trial's same-origin/CSRF checks;
@@ -184,6 +185,27 @@ func (g *Gateway) proxy(w http.ResponseWriter, r *http.Request, grant Grant, key
 	w.Header().Del("Content-Security-Policy")
 	proxy.ServeHTTP(w, r.WithContext(ctx))
 }
+
+func (g *Gateway) boundTransport(target string, grant Grant, key []byte) *http.Transport {
+	// Every request uses a fresh socket. Reauthorize after TCP establishment,
+	// before RoundTrip may write headers or body. A pinned container boot also
+	// prevents stop/rebind/restart from laundering an already-accepted socket.
+	return &http.Transport{DisableKeepAlives: true, DialContext: func(ctx context.Context, network, address string) (net.Conn, error) {
+		if address != target {
+			return nil, ErrDenied
+		}
+		dialer := net.Dialer{Timeout: 5 * time.Second}
+		conn, err := dialer.DialContext(ctx, network, address)
+		if err != nil {
+			return nil, err
+		}
+		if g.authorize(ctx, grant, key, grant.UserID) != nil {
+			_ = conn.Close()
+			return nil, ErrDenied
+		}
+		return conn, nil
+	}}
+}
 func (g *Gateway) watch(ctx context.Context, cancel context.CancelFunc, grant Grant, key []byte) {
 	ticker := time.NewTicker(time.Second)
 	defer ticker.Stop()
