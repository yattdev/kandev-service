+package mcp
+
+import (
+	"context"
+	"github.com/mark3labs/mcp-go/mcp"
+	"github.com/mark3labs/mcp-go/server"
+)
+
+const ownDistributionToolName = "verify_own_distribution_binding_kandev"
+
+func (s *Server) registerOwnDistributionTool() {
+	options := []mcp.ToolOption{mcp.WithDescription("Read and verify this authenticated caller's exact active task/session queue incarnation, environment ownership generation and registered repository against a reviewed inert distribution receipt. Requires externally supplied immutable receipt/manifest hashes. Static receipt, branch/head, Git marker/HEAD/index and original PROMPT preservation only; no native binary, server, test, credential, queue, acknowledgement, lifecycle or product admission. Foreign, incomplete, terminal, protected or changed bindings fail closed."), mcp.WithReadOnlyHintAnnotation(true), mcp.WithDestructiveHintAnnotation(false), mcp.WithIdempotentHintAnnotation(true), mcp.WithOpenWorldHintAnnotation(false)}
+	for _, key := range []string{"repository_id", "packet_path", "delivery_id", "receipt_sha256", "manifest_sha256"} {
+		options = append(options, mcp.WithString(key, mcp.Required()))
+	}
+	s.mcpServer.AddTool(mcp.NewTool(ownDistributionToolName, options...), s.wrapSensitiveHandler(ownDistributionToolName, s.ownDistributionHandler()))
+}
+func (s *Server) ownDistributionHandler() server.ToolHandlerFunc {
+	return func(ctx context.Context, req mcp.CallToolRequest) (*mcp.CallToolResult, error) {
+		payload := map[string]any{"task_id": s.taskID, "session_id": s.sessionID}
+		for _, key := range []string{"repository_id", "packet_path", "delivery_id", "receipt_sha256", "manifest_sha256"} {
+			value := req.GetString(key, "")
+			if value == "" {
+				return mcp.NewToolResultError("exact reviewed distribution identities/hashes required"), nil
+			}
+			payload[key] = value
+		}
+		var result map[string]interface{}
+		if s.backend.RequestPayload(ctx, "mcp.verify_own_distribution_binding", payload, &result) != nil {
+			return mcp.NewToolResultError("own distribution verification unavailable or refused; no acceptance"), nil
+		}
+		return ownQuestionToolResult(result), nil
+	}
+}
