diff --git a/apps/backend/internal/mcp/handlers/own_distribution.go b/apps/backend/internal/mcp/handlers/own_distribution.go
new file mode 100644
index 000000000..1d7af3df9
--- /dev/null
+++ b/apps/backend/internal/mcp/handlers/own_distribution.go
@@ -0,0 +1,152 @@
+package handlers
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"path/filepath"
+	"reflect"
+	"strings"
+
+	mcpprofile "github.com/kandev/kandev/internal/mcp/profile"
+	mcpscope "github.com/kandev/kandev/internal/mcp/scope"
+	"github.com/kandev/kandev/internal/task/artifactbinding"
+	"github.com/kandev/kandev/internal/task/models"
+	ws "github.com/kandev/kandev/pkg/websocket"
+)
+
+type ownDistributionRequest struct {
+	TaskID       string `json:"task_id"`
+	SessionID    string `json:"session_id"`
+	PacketPath   string `json:"packet_path"`
+	DeliveryID   string `json:"delivery_id"`
+	ReceiptSHA   string `json:"receipt_sha256"`
+	ManifestSHA  string `json:"manifest_sha256"`
+	RepositoryID string `json:"repository_id"`
+}
+type distributionEnvironmentReader interface {
+	GetTaskEnvironment(context.Context, string) (*models.TaskEnvironment, error)
+}
+
+func (h *Handlers) handleOwnDistribution(ctx context.Context, msg *ws.Message) (*ws.Message, error) {
+	var req ownDistributionRequest
+	d := json.NewDecoder(bytes.NewReader(msg.Payload))
+	d.DisallowUnknownFields()
+	if d.Decode(&req) != nil {
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeValidation, "exact own-distribution contract required", nil)
+	}
+	caller, err := h.authorizeOwnQuestion(ctx, ownQuestionRequest{TaskID: req.TaskID, SessionID: req.SessionID})
+	p, _ := mcpscope.PrincipalFromContext(ctx)
+	if err != nil || p.Surface != mcpprofile.SurfaceKanbanTask {
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeForbidden, "authenticated ordinary own caller required", nil)
+	}
+	current, err := h.readDistributionBinding(ctx, caller, req.SessionID, req.RepositoryID)
+	if err != nil {
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeConflict, "complete active own binding unavailable; preserve receipt", nil)
+	}
+	receipt, err := artifactbinding.Verify(current, req.PacketPath, req.DeliveryID, req.ReceiptSHA, req.ManifestSHA)
+	if err != nil {
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeConflict, err.Error(), nil)
+	}
+	// Revalidate caller and durable ownership after static file reads.
+	caller, err = h.authorizeOwnQuestion(ctx, ownQuestionRequest{TaskID: req.TaskID, SessionID: req.SessionID})
+	if err != nil {
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeConflict, "own binding changed during verification", nil)
+	}
+	final, err := h.readDistributionBinding(ctx, caller, req.SessionID, req.RepositoryID)
+	if err != nil || !reflect.DeepEqual(final, current) {
+		return ws.NewError(msg.ID, msg.Action, ws.ErrorCodeConflict, "own binding changed during verification", nil)
+	}
+	return ws.NewResponse(msg.ID, msg.Action, receipt)
+}
+func (h *Handlers) readDistributionBinding(ctx context.Context, task *models.Task, sessionID, repoID string) (artifactbinding.Binding, error) {
+	empty := artifactbinding.Binding{}
+	if task == nil || task.ArchivedAt != nil || task.WorkflowStepID == "" {
+		return empty, errors.New("ineligible task")
+	}
+	state := strings.ToUpper(string(task.State))
+	if state == "DONE" || state == "COMPLETED" || state == "CANCELLED" || state == "FAILED" {
+		return empty, errors.New("terminal task")
+	}
+	step, err := h.taskSvc.GetWorkflowStep(ctx, task.WorkflowStepID)
+	if err != nil || step == nil || strings.NewReplacer(" ", "", "-", "").Replace(strings.ToLower(step.Name)) == "todeploy" {
+		return empty, errors.New("protected or unknown lane")
+	}
+	session, err := h.sessionRepo.GetTaskSession(ctx, sessionID)
+	if err != nil || session == nil {
+		return empty, errors.New("session unavailable")
+	}
+	reader, ok := h.sessionRepo.(distributionEnvironmentReader)
+	if !ok {
+		return empty, errors.New("environment reader unavailable")
+	}
+	env, err := reader.GetTaskEnvironment(ctx, session.TaskEnvironmentID)
+	if err != nil {
+		return empty, errors.New("environment unavailable")
+	}
+	return distributionBinding(task, session, env, repoID)
+}
+func distributionBinding(task *models.Task, s *models.TaskSession, e *models.TaskEnvironment, repoID string) (artifactbinding.Binding, error) {
+	empty := artifactbinding.Binding{}
+	if !validDistributionOwnership(task, s, e, repoID) {
+		return empty, errors.New("incomplete ownership")
+	}
+	if !distributionSessionActive(s.State) {
+		return empty, errors.New("inactive session")
+	}
+	attached := false
+	for _, r := range task.Repositories {
+		if r != nil && r.RepositoryID == repoID {
+			attached = true
+		}
+	}
+	if !attached {
+		return empty, errors.New("unregistered repository")
+	}
+	row, err := distributionRepo(e, repoID)
+	if err != nil {
+		return empty, err
+	}
+	root := filepath.Clean(e.WorkspacePath)
+	path := filepath.Clean(row.WorktreePath)
+	if !validDistributionPath(e, root, path, row.WorktreePath) {
+		return empty, errors.New("worktree binding differs")
+	}
+	return artifactbinding.Binding{TaskID: task.ID, WorkspaceID: task.WorkspaceID, RepositoryID: repoID, SessionID: s.ID, SessionIncarnationID: s.QueueIncarnationID, EnvironmentID: e.ID, OwnershipGeneration: e.OwnershipGeneration, WorktreeID: row.WorktreeID, Worktree: path, Branch: row.WorktreeBranch}, nil
+}
+func validDistributionOwnership(t *models.Task, s *models.TaskSession, e *models.TaskEnvironment, repo string) bool {
+	if t == nil || s == nil || e == nil {
+		return false
+	}
+	return repo != "" && s.TaskID == t.ID && e.TaskID == t.ID && e.ID == s.TaskEnvironmentID && e.Status == models.TaskEnvironmentStatusReady && e.OwnershipGeneration > 0 && s.QueueIncarnationID != "" && s.CompletedAt == nil
+}
+func distributionSessionActive(state models.TaskSessionState) bool {
+	switch state {
+	case models.TaskSessionStateCreated, models.TaskSessionStateStarting, models.TaskSessionStateRunning, models.TaskSessionStateWaitingForInput:
+		return true
+	default:
+		return false
+	}
+}
+func distributionRepo(e *models.TaskEnvironment, id string) (*models.TaskEnvironmentRepo, error) {
+	var row *models.TaskEnvironmentRepo
+	for _, r := range e.Repos {
+		if r != nil && r.RepositoryID == id {
+			if row != nil {
+				return nil, errors.New("ambiguous repository")
+			}
+			row = r
+		}
+	}
+	if row == nil {
+		return nil, errors.New("missing worktree")
+	}
+	if row.TaskEnvironmentID != e.ID || row.Status != "active" || row.DeletedAt != nil || row.WorktreeID == "" || row.WorktreeBranch == "" || row.ErrorMessage != "" {
+		return nil, errors.New("inactive worktree")
+	}
+	return row, nil
+}
+func validDistributionPath(e *models.TaskEnvironment, root, path, raw string) bool {
+	return filepath.IsAbs(path) && e.TaskDirName != "" && filepath.Base(root) == e.TaskDirName && filepath.Dir(path) == root && path == raw
+}
