+// Package artifactbinding verifies a caller-owned inert distribution receipt.
+package artifactbinding
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"path/filepath"
+	"reflect"
+	"regexp"
+	"strings"
+)
+
+var errBinding = errors.New("own distribution binding or preservation differs; no acceptance")
+var digestPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+var headPattern = regexp.MustCompile(`^[0-9a-f]{40}$`)
+
+type Binding struct {
+	TaskID               string `json:"task_id"`
+	WorkspaceID          string `json:"workspace_id"`
+	RepositoryID         string `json:"repository_id"`
+	SessionID            string `json:"session_id"`
+	SessionIncarnationID string `json:"session_incarnation_id"`
+	EnvironmentID        string `json:"environment_id"`
+	OwnershipGeneration  int64  `json:"ownership_generation"`
+	WorktreeID           string `json:"worktree_id"`
+	Worktree             string `json:"worktree"`
+	Branch               string `json:"branch"`
+	Head                 string `json:"head"`
+}
+type preservation struct {
+	Head       string  `json:"head"`
+	GitMarker  string  `json:"git_marker_sha256"`
+	HeadMarker string  `json:"head_marker_sha256"`
+	Index      string  `json:"index_sha256"`
+	Prompt     *string `json:"prompt_sha256"`
+}
+type packetReceipt struct {
+	DeliveryID   string       `json:"delivery_id"`
+	Binding      Binding      `json:"binding"`
+	ManifestSHA  string       `json:"manifest_sha256"`
+	Preservation preservation `json:"preservation"`
+}
+type Receipt struct {
+	Version           string       `json:"version"`
+	Status            string       `json:"status"`
+	Binding           Binding      `json:"binding"`
+	DeliveryID        string       `json:"delivery_id"`
+	ReceiptSHA        string       `json:"receipt_sha256"`
+	ManifestSHA       string       `json:"manifest_sha256"`
+	PacketPath        string       `json:"packet_path"`
+	Preservation      preservation `json:"preservation"`
+	NativeProbesRun   bool         `json:"native_probes_run"`
+	ProductAcceptance bool         `json:"product_acceptance"`
+}
+
+func validBinding(b Binding) bool {
+	return b.TaskID != "" && b.WorkspaceID != "" && b.RepositoryID != "" && b.SessionID != "" && b.SessionIncarnationID != "" && b.EnvironmentID != "" && b.OwnershipGeneration > 0 && b.WorktreeID != "" && filepath.IsAbs(b.Worktree) && b.Branch != "" && !strings.Contains(b.Branch, "..") && !strings.HasPrefix(b.Branch, "/") && !strings.ContainsAny(b.Branch, "\\\n\r\x00")
+}
+func hash(raw []byte) string { h := sha256.Sum256(raw); return hex.EncodeToString(h[:]) }
+
+// Verify performs only static reads. Identity comes from the authenticated backend,
+// while expected digests come from the reviewed delivery contract, never the packet.
+func Verify(current Binding, slot, delivery, receiptSHA, manifestSHA string) (*Receipt, error) {
+	if !validBinding(current) || !validSlot(slot, delivery, receiptSHA, manifestSHA) {
+		return nil, errBinding
+	}
+	root := filepath.Join(current.Worktree, slot)
+	pinned, raw, err := readPinned(root, delivery, receiptSHA, manifestSHA)
+	if err != nil {
+		return nil, errBinding
+	}
+	current.Head = pinned.Binding.Head
+	if !reflect.DeepEqual(pinned.Binding, current) {
+		return nil, errBinding
+	}
+	if verifyGit(current, pinned.Preservation) != nil {
+		return nil, errBinding
+	}
+	again, err := readStatic(filepath.Join(root, "receipt.json"), true)
+	if err != nil || !bytes.Equal(again, raw) || !matchesFile(filepath.Join(root, "manifest.json"), manifestSHA, true) {
+		return nil, errBinding
+	}
+	return &Receipt{Version: "own-distribution-binding/v1", Status: "own_binding_verified", Binding: current, DeliveryID: delivery, ReceiptSHA: receiptSHA, ManifestSHA: manifestSHA, PacketPath: slot, Preservation: pinned.Preservation}, nil
+}
+func validSlot(slot, delivery, receiptSHA, manifestSHA string) bool {
+	return digestPattern.MatchString(receiptSHA) && digestPattern.MatchString(manifestSHA) && delivery != "" && filepath.Clean(slot) == slot && strings.HasPrefix(slot, ".kandev/diagnostics/") && !strings.Contains(slot, "..") && !strings.ContainsAny(slot, "\\\x00")
+}
+func readPinned(root, delivery, receiptSHA, manifestSHA string) (packetReceipt, []byte, error) {
+	var pinned packetReceipt
+	raw, err := readStatic(filepath.Join(root, "receipt.json"), true)
+	if err != nil || hash(raw) != receiptSHA {
+		return pinned, nil, errBinding
+	}
+	if json.Unmarshal(raw, &pinned) != nil || pinned.DeliveryID != delivery || pinned.ManifestSHA != manifestSHA || !headPattern.MatchString(pinned.Binding.Head) {
+		return pinned, nil, errBinding
+	}
+	if !matchesFile(filepath.Join(root, "manifest.json"), manifestSHA, true) {
+		return pinned, nil, errBinding
+	}
+	return pinned, raw, nil
+}
+func matchesFile(path, digest string, private bool) bool {
+	raw, err := readStatic(path, private)
+	return err == nil && hash(raw) == digest
+}
+
+func verifyGit(b Binding, p preservation) error {
+	if p.Head != b.Head || !validPreservation(p) {
+		return errBinding
+	}
+	admin, err := gitAdmin(b.Worktree, p.GitMarker)
+	if err != nil {
+		return errBinding
+	}
+	if !matchesFile(filepath.Join(admin, "HEAD"), p.HeadMarker, false) || !matchesFile(filepath.Join(admin, "index"), p.Index, false) {
+		return errBinding
+	}
+	head, err := readStatic(filepath.Join(admin, "HEAD"), false)
+	if err != nil || string(head) != "ref: refs/heads/"+b.Branch+"\n" {
+		return errBinding
+	}
+	if verifyRef(admin, b) != nil || verifyPrompt(b.Worktree, p.Prompt) != nil {
+		return errBinding
+	}
+	if !matchesFile(filepath.Join(admin, "index"), p.Index, false) || !matchesFile(filepath.Join(admin, "HEAD"), p.HeadMarker, false) || !matchesFile(filepath.Join(b.Worktree, ".git"), p.GitMarker, false) {
+		return errBinding
+	}
+	return nil
+}
+func validPreservation(p preservation) bool {
+	return digestPattern.MatchString(p.GitMarker) && digestPattern.MatchString(p.HeadMarker) && digestPattern.MatchString(p.Index)
+}
+func gitAdmin(root, digest string) (string, error) {
+	marker, err := readStatic(filepath.Join(root, ".git"), false)
+	if err != nil || hash(marker) != digest || !bytes.HasPrefix(marker, []byte("gitdir: ")) {
+		return "", errBinding
+	}
+	admin := strings.TrimSpace(strings.TrimPrefix(string(marker), "gitdir: "))
+	if !filepath.IsAbs(admin) {
+		admin = filepath.Join(root, admin)
+	}
+	return filepath.Clean(admin), nil
+}
+func verifyRef(admin string, b Binding) error {
+	common := admin
+	if raw, err := readStatic(filepath.Join(admin, "commondir"), false); err == nil {
+		common = strings.TrimSpace(string(raw))
+		if !filepath.IsAbs(common) {
+			common = filepath.Join(admin, common)
+		}
+	} else if !os.IsNotExist(err) {
+		return errBinding
+	}
+	ref, err := readStatic(filepath.Join(common, "refs", "heads", b.Branch), false)
+	if err != nil || strings.TrimSpace(string(ref)) != b.Head {
+		return errBinding
+	}
+	return nil
+}
+func verifyPrompt(root string, pinned *string) error {
+	prompt, err := readStatic(filepath.Join(root, "PROMPT.md"), false)
+	if pinned == nil {
+		if !os.IsNotExist(err) {
+			return errBinding
+		}
+		return nil
+	}
+	if err != nil || !digestPattern.MatchString(*pinned) || hash(prompt) != *pinned {
+		return errBinding
+	}
+	return nil
+}
+
+// readStatic rejects symbolic links throughout a path and bounds memory use.
+func readStatic(path string, private bool) ([]byte, error) {
+	path = filepath.Clean(path)
+	if checkParents(path, private) != nil {
+		return nil, errBinding
+	}
+	before, err := os.Lstat(path)
+	if err != nil {
+		return nil, err
+	}
+	if !before.Mode().IsRegular() || before.Size() > 2*1024*1024 || (private && before.Mode().Perm()&0077 != 0) {
+		return nil, errBinding
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = f.Close() }()
+	opened, err := f.Stat()
+	if err != nil || !os.SameFile(before, opened) {
+		return nil, errBinding
+	}
+	raw, err := io.ReadAll(io.LimitReader(f, 2*1024*1024+1))
+	if err != nil || len(raw) > 2*1024*1024 || !unchangedFile(path, before) {
+		return nil, errBinding
+	}
+	return raw, nil
+}
+func checkParents(path string, private bool) error {
+	for dir := filepath.Dir(path); ; dir = filepath.Dir(dir) {
+		info, err := os.Lstat(dir)
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {
+			return errBinding
+		}
+		if private && dir == filepath.Dir(path) && info.Mode().Perm()&0077 != 0 {
+			return errBinding
+		}
+		if filepath.Dir(dir) == dir {
+			return nil
+		}
+	}
+}
+func unchangedFile(path string, before os.FileInfo) bool {
+	after, err := os.Lstat(path)
+	return err == nil && os.SameFile(before, after) && before.Size() == after.Size() && before.ModTime().Equal(after.ModTime())
+}
diff --git a/apps/backend/internal/task/artifactbinding/binding_test.go b/apps/backend/internal/task/artifactbinding/binding_test.go
new file mode 100644
index 000000000..ce0478ca1
--- /dev/null
+++ b/apps/backend/internal/task/artifactbinding/binding_test.go
@@ -0,0 +1,83 @@
+package artifactbinding
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"github.com/stretchr/testify/require"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func sum(raw []byte) string { h := sha256.Sum256(raw); return hex.EncodeToString(h[:]) }
+func fixture(t *testing.T) (Binding, string, string, string) {
+	t.Helper()
+	root := t.TempDir()
+	admin := filepath.Join(root, ".admin")
+	slot := filepath.Join(root, ".kandev", "diagnostics", "packet")
+	require.NoError(t, os.MkdirAll(admin, 0700))
+	require.NoError(t, os.MkdirAll(slot, 0700))
+	marker := []byte("gitdir: " + admin + "\n")
+	head := []byte("ref: refs/heads/feature/test\n")
+	index := []byte("synthetic index")
+	for path, raw := range map[string][]byte{filepath.Join(root, ".git"): marker, filepath.Join(admin, "HEAD"): head, filepath.Join(admin, "index"): index} {
+		require.NoError(t, os.WriteFile(path, raw, 0600))
+	}
+	require.NoError(t, os.MkdirAll(filepath.Join(admin, "refs", "heads", "feature"), 0700))
+	require.NoError(t, os.WriteFile(filepath.Join(admin, "refs", "heads", "feature", "test"), []byte("1111111111111111111111111111111111111111\n"), 0600))
+	b := Binding{TaskID: "task", WorkspaceID: "ws", RepositoryID: "repo", SessionID: "session", SessionIncarnationID: "inc", EnvironmentID: "env", OwnershipGeneration: 1, WorktreeID: "wt", Worktree: root, Branch: "feature/test"}
+	r := map[string]any{"delivery_id": "delivery", "binding": b, "manifest_sha256": sum([]byte("manifest")), "preservation": map[string]any{"head": "1111111111111111111111111111111111111111", "git_marker_sha256": sum(marker), "head_marker_sha256": sum(head), "index_sha256": sum(index), "prompt_sha256": nil}}
+	var rb map[string]any
+	raw, _ := json.Marshal(r)
+	require.NoError(t, json.Unmarshal(raw, &rb))
+	rb["binding"].(map[string]any)["head"] = "1111111111111111111111111111111111111111"
+	raw, _ = json.Marshal(rb)
+	require.NoError(t, os.WriteFile(filepath.Join(slot, "receipt.json"), raw, 0600))
+	require.NoError(t, os.WriteFile(filepath.Join(slot, "manifest.json"), []byte("manifest"), 0600))
+	return b, ".kandev/diagnostics/packet", sum(raw), sum([]byte("manifest"))
+}
+func TestVerifyOwnBinding(t *testing.T) {
+	b, slot, r, m := fixture(t)
+	result, err := Verify(b, slot, "delivery", r, m)
+	require.NoError(t, err)
+	require.Equal(t, "own_binding_verified", result.Status)
+	require.Equal(t, "inc", result.Binding.SessionIncarnationID)
+	require.Equal(t, int64(1), result.Binding.OwnershipGeneration)
+	for _, mutate := range []func(*Binding){func(b *Binding) { b.TaskID = "foreign" }, func(b *Binding) { b.WorkspaceID = "foreign" }, func(b *Binding) { b.SessionID = "foreign" }, func(b *Binding) { b.SessionIncarnationID = "replacement" }, func(b *Binding) { b.OwnershipGeneration++ }, func(b *Binding) { b.EnvironmentID = "replacement" }, func(b *Binding) { b.RepositoryID = "foreign" }, func(b *Binding) { b.Branch = "foreign" }, func(b *Binding) { b.WorktreeID = "replacement" }} {
+		other := b
+		mutate(&other)
+		_, err = Verify(other, slot, "delivery", r, m)
+		require.Error(t, err)
+	}
+}
+func TestVerifyPreservationAndNoEscape(t *testing.T) {
+	for _, name := range []string{"head", "index", "marker", "prompt", "receipt", "manifest", "symlink", "escape", "incomplete"} {
+		t.Run(name, func(t *testing.T) {
+			b, slot, r, m := fixture(t)
+			switch name {
+			case "head":
+				require.NoError(t, os.WriteFile(filepath.Join(b.Worktree, ".admin/refs/heads/feature/test"), []byte("2222222222222222222222222222222222222222\n"), 0600))
+			case "index":
+				require.NoError(t, os.WriteFile(filepath.Join(b.Worktree, ".admin/index"), []byte("drift"), 0600))
+			case "marker":
+				require.NoError(t, os.WriteFile(filepath.Join(b.Worktree, ".git"), []byte("foreign"), 0600))
+			case "prompt":
+				require.NoError(t, os.WriteFile(filepath.Join(b.Worktree, "PROMPT.md"), []byte("drift"), 0600))
+			case "receipt":
+				r = sum([]byte("wrong"))
+			case "manifest":
+				m = sum([]byte("wrong"))
+			case "symlink":
+				require.NoError(t, os.Rename(filepath.Join(b.Worktree, slot), filepath.Join(b.Worktree, "moved")))
+				require.NoError(t, os.Symlink(filepath.Join(b.Worktree, "moved"), filepath.Join(b.Worktree, slot)))
+			case "escape":
+				slot = ".kandev/diagnostics/../../../outside"
+			case "incomplete":
+				b.SessionIncarnationID = ""
+			}
+			_, err := Verify(b, slot, "delivery", r, m)
+			require.Error(t, err)
+		})
+	}
+}
