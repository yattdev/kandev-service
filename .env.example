# .env — secrets injected into the kandev container at runtime.
#
# This file is git-ignored. Never commit it.
# Copy from .env.example and fill in your values.
#
# Restart the container after editing:
#   docker compose up -d --force-recreate

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token for `gh` CLI and any tool that calls the GitHub API.
# Create at: https://github.com/settings/tokens
# Required scopes: repo, read:org, gist (add workflow if you manage Actions)
GH_TOKEN=

# ── GitLab ────────────────────────────────────────────────────────────────────
# Personal access token for `glab` CLI and any tool that calls the GitLab API.
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
# Required scopes: api, read_user, read_repository, write_repository
GITLAB_TOKEN=

# SFL self-managed GitLab instance (if different from gitlab.com)
# Uncomment and set if you use gitlab.savoirfairelinux.com for API calls.
# GITLAB_HOST=gitlab.savoirfairelinux.com
