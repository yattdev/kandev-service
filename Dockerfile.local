# Dockerfile.local — extends the upstream kandev image with extra packages.
# Build via docker-compose.override.yml (automatic) or manually:
#   docker build --network=host -f Dockerfile.local -t kandev-local:latest .
ARG BASE_IMAGE=ghcr.io/kdlbs/kandev:latest
FROM ${BASE_IMAGE}

USER root

# ── Provenance labels (read by update.sh to decide when to reconcile) ─────────
# flavor=release marks this as a clean release-tracking build (as opposed to a
# temporary main-branch build from Dockerfile.main-branch, which overrides it to
# flavor=main-branch). base-id records the exact upstream image ID this was built
# on, so update.sh can rebuild when the deployed image drifts off the current
# upstream :latest even if `docker pull` reports "up to date". BASE_IMAGE_ID is
# passed by update.sh; it is only used for labelling and defaults to "unknown".
ARG BASE_IMAGE_ID=unknown
LABEL com.kandev.flavor=release
LABEL com.kandev.base-id=${BASE_IMAGE_ID}

# ── Core tools ────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    bubblewrap \
    openssh-client \
    curl \
    gnupg \
    ca-certificates \
    mariadb-client \
    postgresql-client \
    sudo \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# ── Passwordless sudo for kandev ───────────────────────────────────────────────
# Agents running as `kandev` occasionally need root for one-off tasks inside the
# container (installing a missing apt package, mounting something, adjusting
# permissions on a path they don't own, etc.) without dropping into `docker exec
# -u root`. NOPASSWD avoids needing an interactive password prompt (kandev has
# none set) for every non-interactive agent invocation. Scoped to the kandev
# user only — it does not change what the docker socket / docker group grants.
RUN echo 'kandev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/kandev \
    && chmod 0440 /etc/sudoers.d/kandev

# ── GitHub CLI (gh) ───────────────────────────────────────────────────────────
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] \
        https://cli.github.com/packages stable main" \
      | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# ── GitLab CLI (glab) ─────────────────────────────────────────────────────────
# Version resolved via GitLab's own API; download URL uses the generic packages endpoint.
RUN ARCH=$(dpkg --print-architecture) \
    && GLAB_VER=$(curl -fsSL \
        "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases?per_page=1" \
        | grep -o '"tag_name":"[^"]*"' | head -1 | sed 's/"tag_name":"v//;s/"//') \
    && DL_URL="https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${GLAB_VER}/glab_${GLAB_VER}_linux_${ARCH}.deb" \
    && curl -fsSL "$DL_URL" -o /tmp/glab.deb \
    && dpkg -i /tmp/glab.deb \
    && rm /tmp/glab.deb

# ── Docker CLI + Compose plugin ───────────────────────────────────────────────
# Installs the Docker CLI and Compose v2 plugin so that docker/docker compose
# commands inside the container talk to the host daemon via the mounted socket.
RUN curl -fsSL https://download.docker.com/linux/debian/gpg \
      | gpg --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] \
        https://download.docker.com/linux/debian bookworm stable" \
      | tee /etc/apt/sources.list.d/docker.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends \
        docker-ce-cli \
        docker-compose-plugin \
        docker-buildx-plugin \
    && rm -rf /var/lib/apt/lists/*

# ── Python 3 ──────────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# ── Docker socket group ────────────────────────────────────────────────────────
# GID 984 matches the host's docker group (office-desktop: getent group docker).
# kandev is added to this group so it can access the mounted /var/run/docker.sock.
# DOCKER_GID can be overridden at build time if the host GID differs.
ARG DOCKER_GID=984
RUN if getent group docker > /dev/null 2>&1; then \
        groupmod -g ${DOCKER_GID} docker; \
    else \
        groupadd -g ${DOCKER_GID} docker; \
    fi \
    && usermod -aG docker kandev

# NOTE: the host-path wrapper that shadows this CLI is installed near the end of
# this file, so that editing it does not invalidate the cache for the expensive
# toolchain and Chrome layers below.

# ── Build toolchain + dev headers ─────────────────────────────────────────────
# Needed so that (a) pip/npm/gem can compile native extensions on demand and
# (b) mise can build Ruby and PHP from source. Baking these once means projects
# never require a Dockerfile edit just to satisfy a build-time dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    cmake \
    autoconf \
    bison \
    re2c \
    unzip \
    zip \
    xz-utils \
    file \
    libssl-dev \
    zlib1g-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libffi-dev \
    liblzma-dev \
    libncurses-dev \
    libgdbm-dev \
    libyaml-dev \
    libxml2-dev \
    libxslt1-dev \
    libcurl4-openssl-dev \
    libonig-dev \
    libgd-dev \
    libpng-dev \
    libicu-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    libgmp-dev \
    libsodium-dev \
    libpq-dev \
    libzip-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Headless browser (Chrome / Chromium) + chromedriver ───────────────────────
# Many projects run browser tests (karma ChromeHeadless, Jest+puppeteer,
# Playwright, Selenium, Rails system tests, Laravel Dusk). None of that works on
# the upstream image, which ships no browser at all.
#
# Layout:
#   * amd64  → Google Chrome stable from Google's own apt repo (real Chrome,
#              matches what CI and developers use).
#   * others → Debian's `chromium` (Google publishes no arm64 Linux build).
#   * /usr/bin/google-chrome and /usr/bin/chromium always both resolve to the
#     installed browser, so tooling finds it under either name.
#   * chromedriver is version-matched to the installed Chrome via the
#     Chrome-for-Testing endpoint (Selenium/WebDriver clients).
#
# Fonts and X/GTK libraries are installed first: the browser packages pull most
# of them in, but headless rendering produces blank boxes ("tofu") without real
# font packages, and Playwright's own browser downloads need the same libs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-liberation \
    fonts-dejavu-core \
    fonts-noto-core \
    fonts-noto-color-emoji \
    fonts-noto-cjk \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libasound2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    libpango-1.0-0 \
    libcairo2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH="$(dpkg --print-architecture)" \
    && if [ "$ARCH" = "amd64" ]; then \
        curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
          | gpg --dearmor -o /usr/share/keyrings/google-chrome-keyring.gpg \
        && chmod go+r /usr/share/keyrings/google-chrome-keyring.gpg \
        && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome-keyring.gpg] \
            https://dl.google.com/linux/chrome/deb/ stable main" \
          | tee /etc/apt/sources.list.d/google-chrome.list > /dev/null \
        && apt-get update \
        && apt-get install -y --no-install-recommends google-chrome-stable \
        && ln -sf /usr/bin/google-chrome /usr/bin/chromium \
        && ln -sf /usr/bin/google-chrome /usr/bin/chromium-browser ; \
       else \
        apt-get update \
        && apt-get install -y --no-install-recommends chromium chromium-driver \
        && ln -sf /usr/bin/chromium /usr/bin/google-chrome \
        && ln -sf /usr/bin/chromium /usr/bin/google-chrome-stable ; \
       fi \
    && rm -rf /var/lib/apt/lists/*

# chromedriver matching the installed Chrome (amd64 only — the chromium package
# already ships its own driver on other architectures). Falls back to the
# current "last known good" stable driver if the exact build isn't published.
RUN if [ "$(dpkg --print-architecture)" = "amd64" ]; then \
        CHROME_VER="$(google-chrome --version | awk '{print $3}')" \
        && DRV_URL="https://storage.googleapis.com/chrome-for-testing-public/${CHROME_VER}/linux64/chromedriver-linux64.zip" \
        && (curl -fsSL "$DRV_URL" -o /tmp/chromedriver.zip \
            || { LKG_URL=$(curl -fsSL https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions-with-downloads.json \
                    | tr ',' '\n' | grep -o '"url":"[^"]*chromedriver-linux64.zip"' \
                    | head -1 | sed 's/"url":"//;s/"$//') \
                 && curl -fsSL "$LKG_URL" -o /tmp/chromedriver.zip; }) \
        && unzip -jo /tmp/chromedriver.zip 'chromedriver-linux64/chromedriver' -d /usr/local/bin \
        && chmod +x /usr/local/bin/chromedriver \
        && rm /tmp/chromedriver.zip ; \
    fi

# ── --no-sandbox wrapper ──────────────────────────────────────────────────────
# Chrome's setuid sandbox needs unprivileged user namespaces, which Docker's
# default seccomp profile blocks — every launch dies with
#   "Failed to move to new namespace: ... errno = Operation not permitted".
# The alternatives are seccomp=unconfined / --cap-add=SYS_ADMIN on the whole
# kandev container (weakens isolation for one feature) or making every project
# define a custom ChromeHeadlessNoSandbox launcher. Instead, /usr/local/bin
# (ahead of /usr/bin on PATH) shadows the browser with a wrapper that injects
# the flag, so stock `ng test --browsers=ChromeHeadless`, puppeteer, lighthouse
# and chromedriver all work unmodified. The unwrapped binary stays reachable at
# /usr/bin/google-chrome for anything that wants it.
RUN printf '%s\n' \
      '#!/bin/sh' \
      '# Injects --no-sandbox (Docker seccomp blocks Chrome'"'"'s sandbox).' \
      '# Unwrapped binary: /usr/bin/google-chrome' \
      'exec /usr/bin/google-chrome --no-sandbox "$@"' \
      > /usr/local/bin/google-chrome \
    && chmod +x /usr/local/bin/google-chrome \
    && ln -sf /usr/local/bin/google-chrome /usr/local/bin/google-chrome-stable \
    && ln -sf /usr/local/bin/google-chrome /usr/local/bin/chromium \
    && ln -sf /usr/local/bin/google-chrome /usr/local/bin/chromium-browser \
    && ln -sf /usr/local/bin/google-chrome /usr/local/bin/chrome

# Canonical browser paths for the usual test runners:
#   CHROME_BIN                 karma-chrome-launcher (ChromeHeadless), many CI scripts
#   CHROMIUM_BIN               karma's ChromiumHeadless launcher
#   CHROME_PATH                lighthouse, chrome-launcher
#   PUPPETEER_EXECUTABLE_PATH  puppeteer / jest-puppeteer use the system browser
#   PUPPETEER_SKIP_DOWNLOAD    don't re-download a private Chrome on every npm install
# Playwright is deliberately left alone: it pins its own browser builds and
# installs them to ~/.cache/ms-playwright, which is persistent because
# HOME=/data/home lives on the bind mount (`npx playwright install chromium`).
# Playwright passes --no-sandbox itself when it detects it runs as root/in CI;
# if a run trips over the sandbox, launch with `chromiumSandbox: false`.
ENV CHROME_BIN=/usr/local/bin/google-chrome \
    CHROMIUM_BIN=/usr/local/bin/google-chrome \
    CHROME_PATH=/usr/local/bin/google-chrome \
    PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/google-chrome \
    PUPPETEER_SKIP_DOWNLOAD=true

# ── mise (polyglot version manager) ───────────────────────────────────────────
# mise reads each project's mise.toml / .tool-versions / .nvmrc / .python-version
# and installs the exact runtime version on demand into the persistent /data
# volume — so the container matches the host's multi-language toolset without
# per-project Dockerfile edits. Global defaults live in /etc/mise/config.toml.
RUN install -dm 755 /etc/apt/keyrings \
    && curl -fsSL https://mise.jdx.dev/gpg-key.pub \
      | gpg --dearmor -o /etc/apt/keyrings/mise-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/mise-archive-keyring.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/mise-archive-keyring.gpg arch=$(dpkg --print-architecture)] \
        https://mise.jdx.dev/deb stable main" \
      | tee /etc/apt/sources.list.d/mise.list > /dev/null \
    && apt-get update && apt-get install -y --no-install-recommends mise \
    && rm -rf /var/lib/apt/lists/*

# System-wide mise defaults (global tool versions matched to the host).
COPY mise.default.toml /etc/mise/config.toml

# Put mise's shim directory on PATH for ALL processes (including non-interactive
# `bash -c` invocations used by agents). HOME=/data/home lives on the persistent
# volume, so mise installs tools to /data/home/.local/share/mise which survives
# rebuilds. The directory may be empty until setup-toolchains.sh runs — an empty
# PATH entry is harmless.
ENV PATH="/data/home/.local/share/mise/shims:${PATH}"

# ...but ENV alone is NOT enough for LOGIN shells. Debian's /etc/profile
# *overwrites* PATH with a hardcoded list (it does not append to the inherited
# value), so anything starting a login shell — `bash -lc`, `su -`, `ssh host cmd`,
# some agent/CI runners — silently throws the line above away and every
# mise-managed tool disappears:
#     $ docker exec -u kandev kandev bash -lc 'go version'
#     bash: go: command not found          # same for node/python/java/ruby/php
# while the identical command with `bash -c` works. /etc/profile sources
# /etc/profile.d/*.sh *after* clobbering PATH, so a drop-in there is what puts
# the shims back. Idempotent: only prepends entries that are not already present,
# so it is a no-op for the non-login shells that already inherit the ENV.
RUN printf '%s\n' \
      '# Re-prepend the image PATH prefix that /etc/profile clobbers.' \
      '# See the mise section of Dockerfile.local for why this is needed.' \
      '# Listed back-to-front: each is prepended, so the LAST one ends up first,' \
      '# reproducing the image ENV order (mise shims ahead of the npm global bin).' \
      'for _d in /data/.npm-global/bin /data/home/.local/share/mise/shims; do' \
      '  case ":$PATH:" in' \
      '    *":$_d:"*) ;;' \
      '    *) PATH="$_d:$PATH" ;;' \
      '  esac' \
      'done' \
      'unset _d' \
      'export PATH' \
    > /etc/profile.d/10-kandev-path.sh \
    && chmod 0644 /etc/profile.d/10-kandev-path.sh

# ── Git: trust all directories ────────────────────────────────────────────────
# Prevents "dubious ownership" errors for repos owned by root (docker leftovers)
# or repos where the host path (/home/alice/...) differs from the container
# path (/data/home/...) in the global gitconfig safe.directory entries.
RUN git config --system safe.directory '*'

# ── Host-path wrapper for the Docker CLI ──────────────────────────────────────
# The mounted /var/run/docker.sock points at the HOST daemon, so that daemon
# resolves every bind-mount source on the HOST filesystem. Container-only paths
# (/data/..., /data/home/Code/...) do not exist up there, and Docker does not
# error on a missing source — it silently creates an empty root-owned directory
# and mounts that. Sibling containers then come up with an empty /app and stray
# root-owned trees accumulate on the host.
#
# /usr/local/bin (ahead of /usr/bin on PATH) shadows the CLI with a wrapper that
# maps those paths back to their host equivalents, using the KANDEV_HOST_* env
# vars set in docker-compose.override.yml — the same shadowing trick as the
# google-chrome --no-sandbox wrapper above. The untouched CLI stays reachable at
# /usr/bin/docker. Kept last so edits here don't bust the toolchain cache.
COPY docker-host-path-wrapper.sh /usr/local/bin/docker
RUN chmod +x /usr/local/bin/docker

# ── Entrypoint: tolerate read-only bind mounts ────────────────────────────────
# The upstream entrypoint runs `chown -R kandev:kandev /data` under `set -e`.
# It crashes when it hits our :ro mounts (~/.ssh, ~/.gitconfig) because chown
# cannot change ownership on a read-only filesystem — causing an infinite restart
# loop. The patched version adds `|| true` so chown proceeds on all writable
# paths and silently skips the read-only ones instead of aborting startup.
COPY docker-entrypoint-local.sh /usr/local/bin/docker-entrypoint.sh
COPY scripts/codex-sandbox-preflight.sh /usr/local/bin/codex-sandbox-preflight
COPY scripts/kandev-agent-guard /usr/local/bin/kandev-agent-guard
COPY scripts/kandev-agent-docker-broker /usr/local/bin/kandev-agent-docker-broker
COPY scripts/kandev-agent-docker-client /usr/local/bin/kandev-agent-docker-client
COPY scripts/kandev-agent-docker-token /usr/local/bin/kandev-agent-docker-token
RUN chmod +x /usr/local/bin/docker-entrypoint.sh /usr/local/bin/codex-sandbox-preflight \
    /usr/local/bin/kandev-agent-guard /usr/local/bin/kandev-agent-docker-broker \
    /usr/local/bin/kandev-agent-docker-client /usr/local/bin/kandev-agent-docker-token
