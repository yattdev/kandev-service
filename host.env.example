# host.env.example — machine-specific values for a kandev satellite/hub.
#
# Copy this to `host.env` (which is git-ignored) on each host and fill in your
# real LAN topology. Every script in this repo sources `host.env` if present, so
# the committed files can ship with generic placeholders while your real hosts,
# users and IPs stay private and never get pushed to a public remote.
#
#   cp host.env.example host.env
#   $EDITOR host.env
#
# All values are optional — anything you leave unset falls back to the generic
# ${VAR:-default} placeholder baked into each script.

# ── Hub (always-on machine that stores the Litestream replica + restic repo) ──
MINI_HOST=10.0.0.20          # hub LAN IP (or hostname)
MINI_USER=bob                # hub login user

# ── Office / workstation satellite (used by the sync-*-office.sh helpers) ─────
OFFICE_HOST=office-desktop   # SSH host alias of the office workstation
OFFICE_USER=alice            # office workstation login user
OFFICE_PING_IP=192.168.1.10  # office workstation LAN IP (reachability preflight)

# ── This host's identity ─────────────────────────────────────────────────────
# Short label written to ~/.kandev-host-id and used as this host's dedicated
# replica sub-directory on the hub. Must be unique per host (e.g. office, laptop).
# KANDEV_HOST_ID=office

# ── SSH key used to reach the hub over SFTP (Litestream restore / restic) ─────
# SSH_KEY=$HOME/.ssh/id_ed25519
# LITESTREAM_KEY=$HOME/.config/litestream/litestream-key
