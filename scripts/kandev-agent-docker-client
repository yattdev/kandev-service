#!/usr/bin/env python3
"""Docker-compatible client for the task-scoped Kandev Compose broker."""

from __future__ import annotations

import json
import os
import select
import socket
import struct
import sys


def write_all(stream, output: str) -> None:
    """Drain output to a possibly nonblocking terminal file descriptor.

    Agent terminal pipes can be O_NONBLOCK.  TextIOWrapper.write() then raises
    BlockingIOError for a long Compose result instead of waiting for the
    consumer, which incorrectly turns a successful Compose command into a
    failed hook.  Use short raw writes and wait for writability between them.
    """
    data = output.encode("utf-8", errors="replace")
    descriptor = stream.fileno()
    offset = 0
    while offset < len(data):
        try:
            written = os.write(descriptor, data[offset:])
        except InterruptedError:
            continue
        except BlockingIOError:
            select.select([], [descriptor], [])
            continue
        if written <= 0:
            raise BrokenPipeError("terminal output stream closed")
        offset += written


def audit_receipt(response: dict[str, object]) -> str:
    """Return the non-secret destructive-command correlation receipt."""
    audit_id = response.get("audit_id")
    resolved_project = response.get("resolved_project")
    if isinstance(audit_id, str) and isinstance(resolved_project, str):
        return f"kandev-agent-docker: audit_id={audit_id} resolved_project={resolved_project}\n"
    return ""


def send_stdin(connection: socket.socket, enabled: bool) -> None:
    """Frame redirected stdin without buffering it in the guarded client.

    A zero-length frame is an explicit EOF marker.  This distinguishes a
    completed empty stream from a connection that disappeared while an import
    was in progress, and lets the broker feed large input with normal pipe
    backpressure instead of accepting an implicit, truncated EOF.
    """
    stream = getattr(sys.stdin, "buffer", sys.stdin)
    if not enabled or sys.stdin.isatty():
        connection.sendall(struct.pack("!I", 0))
        return
    while True:
        chunk = stream.read(1024 * 1024)
        if not chunk:
            break
        if isinstance(chunk, str):
            chunk = chunk.encode()
        connection.sendall(struct.pack("!I", len(chunk)))
        connection.sendall(chunk)
    connection.sendall(struct.pack("!I", 0))


def should_stream_stdin(args: list[str]) -> bool:
    """Only noninteractive `compose exec -T` owns redirected stdin.

    Reading stdin for commands such as `compose version` can consume the
    remainder of a shell script supplied on stdin.  The guarded import path is
    explicitly `exec -T`; all other Compose commands receive a framed empty
    stream and cannot accidentally drain their caller.
    """
    if not args or args[0] != "compose":
        return False
    value_options = {
        "-f", "--file", "--profile", "--env-file", "--project-directory",
        "--parallel", "--progress", "--ansi",
    }
    index = 1
    while index < len(args):
        arg = args[index]
        if not arg.startswith("-"):
            break
        index += 2 if arg in value_options else 1
    return index < len(args) and args[index] == "exec" and "-T" in args[index + 1 :]


def main() -> int:
    socket_path = os.environ.get("KANDEV_AGENT_DOCKER_SOCKET", "/run/kandev-agent-docker.sock")
    token = os.environ.get("KANDEV_AGENT_DOCKER_TOKEN", "")
    task_root = os.environ.get("KANDEV_AGENT_DOCKER_ROOT", "")
    if not token or not task_root:
        print("docker: task-scoped broker credentials are unavailable", file=sys.stderr)
        return 78
    request = {
        "token": token,
        "task_root": task_root,
        "cwd": os.path.realpath(os.getcwd()),
        "args": sys.argv[1:],
        # Compose interpolation needs a few command-scoped values, but the
        # broker remains the policy boundary: it accepts only this allow-list.
        "compose_environment": {
            key: os.environ[key]
            for key in ("COMPOSE_PROJECT_NAME", "DB_PORT", "WEB_PORT")
            if key in os.environ
        },
    }
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.connect(socket_path)
            connection.sendall(json.dumps(request).encode() + b"\n")
            send_stdin(connection, should_stream_stdin(sys.argv[1:]))
            connection.shutdown(socket.SHUT_WR)
            chunks: list[bytes] = []
            while True:
                chunk = connection.recv(1024 * 1024)
                if not chunk:
                    break
                chunks.append(chunk)
        response = json.loads(b"".join(chunks))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"docker: task-scoped broker is unavailable: {exc}", file=sys.stderr)
        return 78
    write_all(sys.stdout, str(response.get("stdout", "")))
    write_all(sys.stderr, str(response.get("stderr", "")))
    write_all(sys.stderr, audit_receipt(response))
    return int(response.get("returncode", 70))


if __name__ == "__main__":
    raise SystemExit(main())
