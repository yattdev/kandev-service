#!/usr/bin/env python3
"""Constrained Docker Compose broker for filesystem-guarded Kandev agents.

The broker runs outside Bubblewrap and owns the host Docker socket. Agents only
receive this broker's Unix socket plus a task-scoped HMAC token. The raw Docker
API is never exposed inside an agent namespace.
"""

from __future__ import annotations

import hashlib
import hmac
import copy
from contextlib import contextmanager
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import secrets
import selectors
import stat
import socketserver
import sqlite3
import subprocess
import sys
import tempfile
import threading
import time
from typing import Any
import urllib.error
import urllib.request
import uuid


SOCKET_PATH = Path(os.environ.get("KANDEV_AGENT_DOCKER_BROKER_SOCKET", "/run/kandev-agent-docker/broker.sock"))
KEY_PATH = Path(os.environ.get("KANDEV_AGENT_DOCKER_BROKER_KEY", "/run/kandev-agent-docker/broker.key"))
DOCKER_BIN = os.environ.get("KANDEV_AGENT_DOCKER_HOST_CLI", "/usr/local/bin/docker")
GUARD_BIN = os.environ.get("KANDEV_AGENT_GUARD_BIN", "/usr/local/bin/kandev-agent-guard")
COMPOSE_PLUGIN = os.environ.get(
    "KANDEV_AGENT_COMPOSE_PLUGIN", "/usr/libexec/docker/cli-plugins/docker-compose"
)
MODEL_DIR = Path(os.environ.get("KANDEV_AGENT_DOCKER_MODEL_DIR", "/data/agent-docker-models"))
KANDEV_DB = Path(os.environ.get("KANDEV_AGENT_DB_PATH", "/data/data/kandev.db"))
COORDINATOR_REPOSITORY = os.environ.get(
    "KANDEV_COORDINATOR_REPOSITORY", "/data/home/Code/coordinator"
)
COORDINATOR_AUDIT_LOG = Path(
    os.environ.get(
        "KANDEV_COORDINATOR_AUDIT_LOG", "/data/logs/coordinator-source-audit.jsonl"
    )
)
COMPOSE_AUDIT_LOG = Path(
    os.environ.get("KANDEV_AGENT_DOCKER_AUDIT_LOG", "/data/logs/agent-compose-audit.jsonl")
)
SUPPORT_QUEUE = Path(os.environ.get("KANDEV_SUPPORT_QUEUE", "/data/support-broker"))
MAX_REQUEST = 1024 * 1024
MAX_OUTPUT = 16 * 1024 * 1024
COMMAND_TIMEOUT = 30 * 60
MAX_EXPORT = int(os.environ.get("KANDEV_COORDINATOR_MAX_EXPORT_BYTES", str(4 * 1024**3)))
MAX_STATIC_BACKUP = int(os.environ.get("KANDEV_COORDINATOR_MAX_STATIC_BACKUP_BYTES", str(4 * 1024**3)))
MAX_LOG_LINES = 1000
MAX_DESCRIPTION_BYTES = 1024 * 1024
CONTAINER_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")
SAFE_OUTPUT_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$")
TASK_ID_RE = re.compile(
    r"^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-"
    r"[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
)
TASK_DIR_RE = re.compile(r"^[A-Za-z0-9_-]+$")
COMPOSE_ENV_KEYS = {"COMPOSE_PROJECT_NAME", "DB_PORT", "WEB_PORT"}
COMPOSE_PROJECT_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$")
STATIC_BACKUP_NAME = "last_db.sql"
AUDIT_LOCK = threading.Lock()
EXPORT_LOCK = threading.Lock()
ACTIVE_TASK_SESSION_STATES = {"CREATED", "STARTING", "RUNNING", "WAITING_FOR_INPUT"}
ACTIVE_TASK_ENVIRONMENT_STATES = {"creating", "ready"}
ACTIVE_EXECUTOR_STATES = {"starting", "prepared", "running", "ready"}
RUNTIME_IDENTITY_LABELS = {
    "kandev.managed",
    "kandev.task_id",
    "kandev.session_id",
    "kandev.task_environment_id",
}

COMPOSE_VALUE_OPTIONS = {
    "-f",
    "--file",
    "--profile",
    "--env-file",
    "--project-directory",
    "--parallel",
    "--progress",
    "--ansi",
}
COMPOSE_FLAG_OPTIONS = {"--compatibility", "--dry-run", "--all-resources"}
PATH_OPTIONS = {"-f", "--file", "--env-file", "--project-directory"}
MODEL_COMMANDS = {"build", "config", "create", "pull", "run", "up"}
SAFE_EXISTING_COMMANDS = {
    "down",
    "events",
    "exec",
    "images",
    "kill",
