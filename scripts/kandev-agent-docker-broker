class BrokerError(RuntimeError):
    pass


class ComposeAuditError(BrokerError):
    """A denied destructive request whose durable correlation ID is safe to show."""

    def __init__(self, message: str, audit_id: str, project: str):
        super().__init__(message)
        self.audit_id = audit_id
        self.project = project


def is_within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def resolve_inside(value: str, cwd: Path, root: Path, *, must_exist: bool = True) -> Path:
    candidate = Path(value)
    if not candidate.is_absolute():
        candidate = cwd / candidate
    try:
        resolved = candidate.resolve(strict=must_exist)
    except OSError as exc:
        raise BrokerError(f"path is unavailable: {value}: {exc}") from exc
    if not is_within(resolved, root):
        raise BrokerError(f"path is outside this agent task: {value}")
    return resolved


def translate_to_host(path: Path) -> Path:
    mappings = [
        (Path("/data/home/Code"), os.environ.get("KANDEV_HOST_CODE_DIR", "")),
        (Path("/data"), os.environ.get("KANDEV_HOST_DATA_DIR", "")),
    ]
    host_code = os.environ.get("KANDEV_HOST_CODE_DIR", "")
    if host_code:
        mappings.insert(0, (Path(host_code), host_code))
    for source, destination in mappings:
        if not destination:
            continue
        try:
            relative = path.relative_to(source)
        except ValueError:
            continue
        return (Path(destination) / relative).resolve(strict=True)
    raise BrokerError(f"task path has no configured host mapping: {path}")


def translate_to_host_lexical(path: Path) -> Path:
    """Map a container path without resolving symlinks.

    Static-backup delivery must reject symlink traversal, so resolving before
    validation would hide a malicious source or registered-root symlink.
    """
    mappings = [
        (Path("/data/home/Code"), os.environ.get("KANDEV_HOST_CODE_DIR", "")),
        (Path("/data"), os.environ.get("KANDEV_HOST_DATA_DIR", "")),
    ]
    host_code = os.environ.get("KANDEV_HOST_CODE_DIR", "")
    if host_code:
        mappings.insert(0, (Path(host_code), host_code))
    for source, destination in mappings:
        if not destination:
            continue
        try:
            relative = path.relative_to(source)
        except ValueError:
            continue
        return Path(destination) / relative
    raise BrokerError(f"task path has no configured host mapping: {path}")


def project_name(task_root: Path) -> str:
    digest = hashlib.sha256(str(task_root).encode()).hexdigest()[:16]
    return f"kd_{digest}"


def scoped_project_name(
    task_root: Path, environment: dict[str, str], cwd: Path | None = None
) -> str:
    """Automatically isolate projects by task and clone, retaining existing owners."""
    selected = environment.get("COMPOSE_PROJECT_NAME")
    if selected and selected.startswith("kd_"):
        return selected  # Existing explicitly scoped projects keep their identity.
    if selected and not COMPOSE_PROJECT_NAME_RE.fullmatch(selected):
        raise BrokerError("invalid Compose project name")
    cwd = cwd or task_root
    legacy = project_name(task_root)
    if selected is None:
        try:
            owner = json.loads(project_claim_path(legacy).read_text())
        except (FileNotFoundError, json.JSONDecodeError):
            owner = None
        if owner == project_owner(task_root, cwd, legacy) or cwd == task_root:
            return legacy
    digest = hashlib.sha256(f"{task_root}\0{cwd}\0{selected or ''}".encode()).hexdigest()[:24]
    return f"kd_{digest}"


def model_path(task_root: Path, project: str) -> Path:
    owner = hashlib.sha256(str(task_root).encode()).hexdigest()
    key = hashlib.sha256(project.encode()).hexdigest()
    return MODEL_DIR / owner / f"{key}.json"


def project_claim_path(project: str) -> Path:
    return MODEL_DIR / "projects" / f"{hashlib.sha256(project.encode()).hexdigest()}.json"


def project_owner(task_root: Path, cwd: Path, project: str) -> dict[str, str]:
    return {"task_root": str(task_root), "cwd": str(cwd), "project": project}


def claim_project(task_root: Path, cwd: Path, project: str, *, create: bool = True) -> None:
    """Atomically bind a guarded project to one task and one clone."""
    destination = project_claim_path(project)
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    expected = project_owner(task_root, cwd, project)
    try:
        current = json.loads(destination.read_text(encoding="utf-8"))
    except FileNotFoundError:
        if not create:
            raise BrokerError("no saved Compose model is authorized for this task project")
        temporary = destination.parent / f".{destination.name}.{threading.get_ident()}"
        try:
            temporary.write_text(json.dumps(expected), encoding="utf-8")
            os.chmod(temporary, 0o600)
            try:
                os.link(temporary, destination)
            except FileExistsError:
                pass
        finally:
            temporary.unlink(missing_ok=True)
        try:
            current = json.loads(destination.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise BrokerError("cannot establish guarded Compose project ownership") from exc
    except (OSError, json.JSONDecodeError) as exc:
        raise BrokerError("guarded Compose project ownership is unreadable") from exc
    if current != expected:
        raise BrokerError("Compose project is already owned by a different task clone")


def save_scoped_model(task_root: Path, cwd: Path, project: str, model: dict[str, Any]) -> None:
    """Persist a Compose model with immutable task and clone ownership data."""
    claim_project(task_root, cwd, project)
    destination = model_path(task_root, project)
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = destination.parent / f".{destination.name}.{threading.get_ident()}"
    payload = {
        "version": 1,
        "task_root": str(task_root),
        "cwd": str(cwd),
        "project": project,
        "model": model,
    }
    try:
        temporary.write_text(json.dumps(payload), encoding="utf-8")
        os.chmod(temporary, 0o600)
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def load_scoped_model(task_root: Path, cwd: Path, project: str) -> dict[str, Any]:
    """Load only a model established by this task from this exact clone."""
    # Check the global claim before the task-local model: otherwise a second
    # task could create a same-named project and collide at the Docker daemon.
    claim_project(task_root, cwd, project, create=False)
    source = model_path(task_root, project)
    try:
        saved = json.loads(source.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise BrokerError("no saved Compose model is authorized for this task project") from exc
    if not isinstance(saved, dict) or (
        saved.get("version") != 1
        or saved.get("task_root") != str(task_root)
        or saved.get("cwd") != str(cwd)
        or saved.get("project") != project
        or not isinstance(saved.get("model"), dict)
    ):
        raise BrokerError("saved Compose model ownership does not match this task clone")
    return saved["model"]


def host_ipv4_routes(route_file: Path = Path("/proc/net/route")) -> list[ipaddress.IPv4Network]:
    """Read connected host routes without exposing other tasks' network data."""
    try:
        lines = route_file.read_text(encoding="ascii").splitlines()
        if not lines or lines[0].split()[:2] != ["Iface", "Destination"]:
            raise ValueError("missing route table header")
        routes = []
        for line in lines[1:]:
            fields = line.split()
            if len(fields) < 8:
                raise ValueError("invalid route table row")
            address = ipaddress.IPv4Address(struct.pack("<I", int(fields[1], 16)))
            mask = ipaddress.IPv4Address(struct.pack("<I", int(fields[7], 16)))
            route = ipaddress.IPv4Network((str(address), str(mask)), strict=False)
            if route.prefixlen:
                routes.append(route)
        return routes
    except (OSError, ValueError, IndexError) as exc:
        raise BrokerError("host IPv4 route preflight is unavailable") from exc


def inspect_owned_network(name: str) -> dict[str, Any] | None:
    code, output, error = run_command([DOCKER_BIN, "network", "inspect", name], Path("/"))
    if code != 0:
        if "no such network" in error.lower() or "not found" in error.lower():
            return None
        raise BrokerError("Docker network availability check failed")
    try:
        networks = json.loads(output)
    except json.JSONDecodeError as exc:
        raise BrokerError("Docker network inspection returned invalid data") from exc
    if not isinstance(networks, list) or len(networks) != 1 or networks[0].get("Name") != name:
        raise BrokerError("Docker network inspection did not resolve the exact project network")
    return networks[0]


def owned_network_receipt(network: dict[str, Any], task_root: Path, project: str) -> dict[str, Any]:
    name = f"{project}_default"
    labels = network.get("Labels") or {}
    digest = hashlib.sha256(str(task_root).encode()).hexdigest()
    if network.get("Name") != name or any((
        labels.get("com.docker.compose.project") != project,
        labels.get("com.docker.compose.network") != "default",
        labels.get("kandev.agent.task_digest") != digest,
    )):
        raise BrokerError("project network exists without this task's reservation ownership")
    configs = (network.get("IPAM") or {}).get("Config") or []
    subnets = [entry.get("Subnet") for entry in configs if isinstance(entry, dict) and entry.get("Subnet")]
    if len(subnets) != 1:
        raise BrokerError("reserved project network has an ambiguous subnet")
    try:
        subnet = ipaddress.IPv4Network(subnets[0], strict=True)
    except (ipaddress.AddressValueError, ipaddress.NetmaskValueError) as exc:
        raise BrokerError("reserved project network has an invalid subnet") from exc
    if subnet.prefixlen != 24 or not subnet.subnet_of(NETWORK_SLOT_POOL):
        raise BrokerError("reserved project network is outside the guarded slot pool")
    if any(subnet.overlaps(route) for route in host_ipv4_routes() if route != subnet):
        raise BrokerError("reserved project network now overlaps a host route")
    network_id = network.get("Id")
    if not isinstance(network_id, str) or not re.fullmatch(r"[0-9a-f]{64}", network_id):
        raise BrokerError("reserved project network has no valid Docker identity")
    return {"project": project, "network": name, "network_id": network_id, "subnet": str(subnet)}


def handle_network_reserve(task_root: Path, cwd: Path, args: list[str], environment: dict[str, str]) -> dict[str, Any]:
    if args != ["kandev", "network", "reserve"]:
        raise BrokerError("guarded network command is: docker kandev network reserve")
    project = scoped_project_name(task_root, environment, cwd)
    model = load_scoped_model(task_root, cwd, project)
    networks = model.get("networks") or {}
    default = networks.get("default") if isinstance(networks, dict) else None
    if set(networks) != {"default"} or not isinstance(default, dict) or default.get("name") != f"{project}_default":
        raise BrokerError("network reservation requires one project-owned default Compose network")
    if (set(default) - {"name", "ipam", "driver"}
            or default.get("ipam") not in (None, {})
            or default.get("driver") not in (None, "bridge")):
        raise BrokerError("network reservation requires an unconfigured default bridge network")
    name = f"{project}_default"
    digest = hashlib.sha256(str(task_root).encode()).hexdigest()
    audit_id = str(uuid.uuid4())
    audit_compose(task_root, cwd, project, project, "network reserve", "allow", "preflight",
                  audit_id=audit_id, command_class="network_reserve")
    with NETWORK_RESERVE_LOCK:
        existing = inspect_owned_network(name)
        if existing is not None:
            if existing.get("Containers"):
                raise BrokerError("reserved project network is already in use")
            receipt = owned_network_receipt(existing, task_root, project)
            audit_compose(task_root, cwd, project, project, "network reserve", "allow", "existing",
                          audit_id=audit_id, command_class="network_reserve")
            return {"returncode": 0, "stdout": json.dumps({**receipt, "existing": True}) + "\n", "stderr": ""}
        routes = host_ipv4_routes()
        for subnet in NETWORK_SLOT_POOL.subnets(new_prefix=24):
            if any(subnet.overlaps(route) for route in routes):
                continue
            code, _, error = run_command([
                DOCKER_BIN, "network", "create", "--driver", "bridge", "--subnet", str(subnet),
                "--label", f"com.docker.compose.project={project}",
                "--label", "com.docker.compose.network=default",
                "--label", f"kandev.agent.task_digest={digest}", name,
            ], Path("/"))
            if code == 0:
                created = inspect_owned_network(name)
                if created is None:
                    raise BrokerError("created project network could not be verified")
                receipt = owned_network_receipt(created, task_root, project)
                if receipt["subnet"] != str(subnet):
                    raise BrokerError("created project network subnet did not match reservation")
                audit_compose(task_root, cwd, project, project, "network reserve", "allow", "created",
                              audit_id=audit_id, command_class="network_reserve")
                return {"returncode": 0, "stdout": json.dumps({**receipt, "existing": False}) + "\n", "stderr": ""}
            if "overlap" not in error.lower() and "already allocated" not in error.lower():
                raise BrokerError("Docker could not create the task-owned network slot")
    raise BrokerError("no route-safe guarded Docker network slot is available")


def audit_compose(
    task_root: Path,
    cwd: Path,
    requested_project: str,
    resolved_project: str,
    command: str,
    ownership_decision: str,
    result: str,
    *,
    audit_id: str,
    command_class: str = "destructive",
) -> None:
    """Durably record a destructive decision without command arguments or env."""
    event = {
        "audit_id": audit_id,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "command_class": command_class,
        "requested_project": requested_project,
        "resolved_project": resolved_project,
        "canonical_project_directory": str(cwd),
        "authenticated_task_scope": str(task_root),
        "command": command,
        "ownership_decision": ownership_decision,
        "result": result,
    }
    try:
        COMPOSE_AUDIT_LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with AUDIT_LOCK, COMPOSE_AUDIT_LOG.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
    except OSError as exc:
        raise BrokerError(f"cannot record Compose destructive-command audit event: {exc}") from exc


def destructive_model_preflight(
    task_root: Path, cwd: Path, requested_project: str, resolved_project: str, command: str
) -> tuple[dict[str, Any], str]:
    """Flush an allow/deny ownership decision before invoking Docker."""
    audit_id = str(uuid.uuid4())
    try:
        model = load_scoped_model(task_root, cwd, resolved_project)
    except BrokerError as exc:
        # The denial itself is part of the security boundary.  If it cannot be
        # persisted, audit_compose raises and the caller fails closed without
        # receiving a misleading correlation ID.
        audit_compose(
            task_root, cwd, requested_project, resolved_project, command,
            "deny", "denied", audit_id=audit_id,
        )
        raise ComposeAuditError(str(exc), audit_id, resolved_project) from exc
    audit_compose(
        task_root, cwd, requested_project, resolved_project, command,
        "allow", "preflight", audit_id=audit_id,
    )
    return model, audit_id


def expected_token(key: bytes, task_root: Path) -> str:
    return hmac.new(key, str(task_root).encode(), hashlib.sha256).hexdigest()


def split_compose_args(args: list[str], cwd: Path, task_root: Path) -> tuple[list[str], str, list[str]]:
    if not args or args[0] != "compose":
        raise BrokerError("guarded Docker access supports 'docker compose' only")

    global_args: list[str] = []
    index = 1
    while index < len(args):
        arg = args[index]
        if not arg.startswith("-"):
            break
        if arg.startswith("--dry-run="):
            raise BrokerError("guarded Compose requires the bare --dry-run flag")
        if arg in COMPOSE_FLAG_OPTIONS:
            global_args.append(arg)
            index += 1
            continue
        option = arg.split("=", 1)[0]
        if option not in COMPOSE_VALUE_OPTIONS:
            raise BrokerError(f"unsupported Compose global option: {arg}")
        if "=" in arg:
            value = arg.split("=", 1)[1]
            if option in PATH_OPTIONS:
                if value == "-":
                    raise BrokerError("Compose files from stdin are not supported")
                resolve_inside(value, cwd, task_root)
            global_args.append(arg)
            index += 1
            continue
        if index + 1 >= len(args):
            raise BrokerError(f"missing value for Compose option: {arg}")
        value = args[index + 1]
        if option in PATH_OPTIONS:
            if value == "-":
                raise BrokerError("Compose files from stdin are not supported")
            resolve_inside(value, cwd, task_root)
        global_args.extend((arg, value))
        index += 2

    if index >= len(args):
        raise BrokerError("a Docker Compose subcommand is required")
    command = args[index]
    command_args = args[index + 1 :]
    if command not in MODEL_COMMANDS | SAFE_EXISTING_COMMANDS:
        raise BrokerError(f"Docker Compose subcommand is not permitted for agents: {command}")
    for arg in command_args:
        if arg.startswith("--dry-run") and arg != "--dry-run":
            raise BrokerError("guarded Compose requires the bare --dry-run flag")
    if command == "run":
        for arg in command_args:
            option = arg.split("=", 1)[0]
            if option in FORBIDDEN_RUN_OPTIONS or arg.startswith("-v") or option in {
                "--env-file",
                "--env-from-file",
                "--name",
            }:
                raise BrokerError(f"Compose run option is not permitted: {arg}")
    if command == "exec" and any(arg in {"--privileged"} for arg in command_args):
        raise BrokerError("privileged Compose exec is not permitted")
    if command == "build":
        for arg in command_args:
            if arg.split("=", 1)[0] in {"--ssh", "--secret", "--builder"}:
                raise BrokerError(f"Compose build option is not permitted: {arg}")
    if command == "down":
        for arg in command_args:
            if arg == "--rmi" or arg.startswith("--rmi="):
                raise BrokerError("Compose down may not remove shared host images")
    if command == "config":
        for arg in command_args:
            if arg in {"-o", "--output"} or arg.startswith("--output="):
                raise BrokerError("Compose config output files are not permitted")
    return global_args, command, command_args


def compose_replay_command(
    project: str,
    model_file: Path,
    global_args: list[str],
    command: str,
    command_args: list[str],
) -> list[str]:
    """Build the daemon-facing invocation for an already-sanitized model.

    Most global options only influence model rendering and must not be replayed
    against the temporary JSON file.  Profiles select sanitized services, and
    dry-run is a daemon-execution guarantee, so both must survive replay.
    """
    command_line = [
        DOCKER_BIN,
        "compose",
        "--project-name",
        project,
        "-f",
        str(model_file),
    ]
    index = 0
    while index < len(global_args):
        argument = global_args[index]
        if argument == "--profile":
            command_line.extend(global_args[index : index + 2])
            index += 2
        elif argument.startswith("--profile=") or argument == "--dry-run":
            command_line.append(argument)
            index += 1
        else:
            index += 1
    command_line.extend((command, *command_args))
    return command_line


def compose_project_directory(cwd: Path, task_root: Path, global_args: list[str]) -> Path:
    """Return the canonical directory that owns a Compose project model.

    A task wrapper may keep its runtime files beside the checked-out repository
    and invoke ``compose -f ../repository/docker-compose.yml`` from there.
    That must address the same saved model as a direct invocation from the
    repository, without allowing a sibling clone to inherit it.
    """
    explicit_directory: str | None = None
    first_file: str | None = None
    index = 0
    while index < len(global_args):
        argument = global_args[index]
        option, separator, value = argument.partition("=")
        if option in {"--project-directory"}:
            explicit_directory = value if separator else global_args[index + 1]
            index += 1 if separator else 2
            continue
        if option in {"-f", "--file"} and first_file is None:
            first_file = value if separator else global_args[index + 1]
            index += 1 if separator else 2
            continue
        index += 1
    if explicit_directory is not None:
        return resolve_inside(explicit_directory, cwd, task_root)
    if first_file is not None:
        return resolve_inside(first_file, cwd, task_root).parent
    return cwd


def scoped_path_to_host(value: str, cwd: Path, task_root: Path, host_root: Path) -> Path:
    scoped = resolve_inside(value, cwd, task_root)
    host_path = translate_to_host(scoped)
    if not is_within(host_path, host_root):
        raise BrokerError(f"Compose source is outside this task: {value}")
    return host_path


def validate_named_resources(model: dict[str, Any], project: str) -> None:
    for section in ("volumes", "networks", "configs", "secrets"):
        resources = model.get(section) or {}
        if not isinstance(resources, dict):
            raise BrokerError(f"invalid Compose {section} section")
        for logical_name, config in resources.items():
            if config is None:
                continue
            if not isinstance(config, dict):
                raise BrokerError(f"invalid Compose {section} resource: {logical_name}")
            if config.get("external"):
                raise BrokerError(f"external Compose {section} are not permitted: {logical_name}")
            actual_name = config.get("name")
            if actual_name and not str(actual_name).startswith(f"{project}_"):
                config["name"] = f"{project}_{logical_name}"


def validate_model(
    model: dict[str, Any], cwd: Path, task_root: Path, host_root: Path, project: str
) -> dict[str, Any]:
    sanitized = copy.deepcopy(model)
    sanitized["name"] = project
    validate_named_resources(sanitized, project)
    services = sanitized.get("services")
    if not isinstance(services, dict) or not services:
        raise BrokerError("Compose model has no services")

    for service_name, service in services.items():
        if not isinstance(service, dict):
            raise BrokerError(f"invalid Compose service: {service_name}")
        if service.get("container_name"):
            service["x-kandev-container-alias"] = service["container_name"]
            service["container_name"] = f"{project}-{service_name}-1"
        for key in (
            "privileged",
            "cap_add",
            "devices",
            "device_cgroup_rules",
            "volumes_from",
            "external_links",
            "credential_spec",
        ):
            if service.get(key):
                raise BrokerError(f"Compose service {service_name} uses forbidden setting: {key}")
        for key in ("pid", "ipc", "uts", "cgroup", "userns_mode"):
            if service.get(key):
                raise BrokerError(f"Compose service {service_name} may not select {key}")
        network_mode = str(service.get("network_mode") or "")
        if network_mode == "host" or network_mode.startswith("container:"):
            raise BrokerError(f"Compose service {service_name} uses forbidden network_mode")
        for option in service.get("security_opt") or []:
            if str(option) not in {"no-new-privileges", "no-new-privileges:true"}:
                raise BrokerError(f"Compose service {service_name} uses forbidden security_opt: {option}")
        labels = service.get("labels") or {}
        label_names = labels.keys() if isinstance(labels, dict) else (str(item).split("=", 1)[0] for item in labels)
        if any(
            str(name).startswith("com.docker.compose.")
            or str(name) == "kandev.instance_id"
            for name in label_names
        ):
            raise BrokerError(f"Compose service {service_name} overrides reserved ownership labels")

        build = service.get("build")
        requested_image = service.get("image")
        if service.get("build") and requested_image:
            service["x-kandev-image-alias"] = requested_image
        if isinstance(build, str):
            service["build"] = str(scoped_path_to_host(build, cwd, task_root, host_root))
            service["image"] = scoped_build_image(requested_image, project, service_name)
        elif isinstance(build, dict):
            context = build.get("context")
            remote_context = context and str(context).startswith(
                ("docker-image://", "git://", "http://", "https://", "ssh://")
            )
            context_inside: Path | None = None
            if context and not remote_context:
                context_inside = resolve_inside(str(context), cwd, task_root)
                build["context"] = str(translate_to_host(context_inside))
            dockerfile = build.get("dockerfile")
            if dockerfile:
                if remote_context:
                    raise BrokerError(
                        f"Compose build for {service_name} may not select a Dockerfile "
                        "with a remote context"
                    )
                dockerfile_path = Path(str(dockerfile))
                if not dockerfile_path.is_absolute():
                    dockerfile_path = (context_inside or cwd) / dockerfile_path
                build["dockerfile"] = str(
                    scoped_path_to_host(str(dockerfile_path), cwd, task_root, host_root)
                )
            for key in (
                "additional_contexts",
                "cache_from",
                "cache_to",
                "entitlements",
                "output",
                "privileged",
                "secrets",
                "ssh",
                "tags",
            ):
                if build.get(key):
                    raise BrokerError(f"Compose build for {service_name} uses forbidden setting: {key}")
            # Never overwrite a host image tag that may belong to another task
            # or a production Compose project.
            service["image"] = scoped_build_image(requested_image, project, service_name)

        for mount in service.get("volumes") or []:
            if not isinstance(mount, dict):
                raise BrokerError(f"Compose service {service_name} has an invalid volume")
            source = mount.get("source")
            target = str(mount.get("target") or "")
            if "docker.sock" in target or target in {"/run", "/var/run"}:
                raise BrokerError(f"Compose service {service_name} attempts to expose a daemon path")
            if mount.get("type") == "bind":
                if not source:
                    raise BrokerError(f"Compose service {service_name} has a bind without a source")
                # A bind that resolves inside this task retains its declared
                # mode (Compose defaults to read-write). Test containers may
                # therefore modify the same worktree the agent can already
                # modify, while paths outside the task remain rejected.
                mount["source"] = str(scoped_path_to_host(str(source), cwd, task_root, host_root))

    for section in ("configs", "secrets"):
        for logical_name, config in (sanitized.get(section) or {}).items():
            if isinstance(config, dict) and config.get("file"):
                config["file"] = str(
                    scoped_path_to_host(str(config["file"]), cwd, task_root, host_root)
                )
    return sanitized


def scoped_build_image(requested: Any, project: str, service: str) -> str:
    """Keep an explicit task image tag without allowing a shared image overwrite."""
    prefix = f"{project}_{service}:"
    if isinstance(requested, str) and requested.startswith(prefix):
        tag = requested[len(prefix):]
        if IMAGE_TAG_RE.fullmatch(tag):
            return requested
    return f"{project}_{service}:latest"


def require_isolated_recreate(model: dict[str, Any], command: str, args: list[str]) -> None:
    """A selected dependent service must not recreate its dependencies."""
    if command != "up" or "--force-recreate" not in args or "--no-deps" in args:
        return
    services = model.get("services") or {}
    for name, service in services.items():
        if name in args and service.get("depends_on"):
            raise BrokerError(
                "recreating a selected service with dependencies requires --no-deps"
            )


def compose_environment(raw: Any) -> dict[str, str]:
    """Validate the only agent-provided environment forwarded to Compose."""
    if raw is None:
        return {}
    if not isinstance(raw, dict) or not all(
        isinstance(key, str) and isinstance(value, str) for key, value in raw.items()
    ):
        raise BrokerError("invalid Compose environment")
    if set(raw) - COMPOSE_ENV_KEYS:
        raise BrokerError("Compose environment contains a non-allow-listed key")
    allowed: dict[str, str] = {}
    for key, value in raw.items():
        if not value or len(value) > 64:
            raise BrokerError(f"invalid Compose environment value: {key}")
        if key in {"DB_PORT", "WEB_PORT"}:
            if not value.isdecimal() or not 1 <= int(value) <= 65535:
                raise BrokerError(f"invalid Compose port: {key}")
        elif not COMPOSE_PROJECT_NAME_RE.fullmatch(value):
            raise BrokerError("invalid Compose project name")
        allowed[key] = value
    return allowed


def clean_environment(overrides: dict[str, str] | None = None) -> dict[str, str]:
    environment = dict(os.environ)
    for key in list(environment):
        if key.startswith("KANDEV_AGENT_DOCKER_") or key in {
            "KANDEV_AGENT_GUARD_ACTIVE",
            "DOCKER_CONTEXT",
            "DOCKER_HOST",
        }:
            environment.pop(key, None)
    if overrides:
        environment.update(overrides)
    return environment


class FramedInput:
    """Read the client stdin framing without retaining task input in memory."""

    def __init__(self, stream: Any):
        self.stream = stream
        self.remaining = 0
        self.finished = False

    def _exact(self, size: int) -> bytes:
        chunks: list[bytes] = []
        remaining = size
        while remaining:
            chunk = self.stream.read(remaining)
            if not chunk:
                raise BrokerError("guarded Compose stdin stream ended before its EOF marker")
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)

    def read(self, size: int) -> bytes:
        if self.finished:
            return b""
        while self.remaining == 0:
            frame_length = struct.unpack("!I", self._exact(4))[0]
            if frame_length == 0:
                self.finished = True
                return b""
            if frame_length > MAX_REQUEST:
                raise BrokerError("guarded Compose stdin frame is too large")
            self.remaining = frame_length
        amount = min(size, self.remaining)
        chunk = self._exact(amount)
        self.remaining -= len(chunk)
        return chunk


def run_command(
    args: list[str], cwd: Path, timeout: int = COMMAND_TIMEOUT,
    environment_overrides: dict[str, str] | None = None,
    stdin_stream: FramedInput | None = None,
    max_output: int = MAX_OUTPUT,
) -> tuple[int, str, str]:
    deadline = time.monotonic() + timeout
    with tempfile.TemporaryFile() as stdout_file, tempfile.TemporaryFile() as stderr_file:
        process = subprocess.Popen(
            args,
            cwd=str(cwd),
            env=clean_environment(environment_overrides),
            stdin=subprocess.PIPE if stdin_stream is not None else subprocess.DEVNULL,
            stdout=stdout_file,
            stderr=stderr_file,
        )
        input_error: list[BrokerError | OSError] = []

        def feed_stdin() -> None:
            if stdin_stream is None or process.stdin is None:
                return
            try:
                while True:
                    chunk = stdin_stream.read(64 * 1024)
                    if not chunk:
                        break
                    try:
                        process.stdin.write(chunk)
                        process.stdin.flush()
                    except BrokenPipeError:
                        # The command chose to stop reading.  Continue
                        # draining the framed client stream so its producer
                        # does not see a misleading socket failure; the real
                        # child exit status is returned below.
                        while stdin_stream.read(64 * 1024):
                            pass
                        break
            except (BrokerError, OSError) as exc:
                input_error.append(exc)
            finally:
                try:
                    process.stdin.close()
                except (BrokenPipeError, OSError, AttributeError):
                    pass

        feeder: threading.Thread | None = None
        if stdin_stream is not None:
            feeder = threading.Thread(target=feed_stdin, daemon=True)
            feeder.start()
        try:
            return_code = process.wait(timeout=max(0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
            return_code = 124
            stderr_file.write(f"command timed out after {timeout} seconds\n".encode())
        if feeder is not None:
            # A command can exit after reading only a prefix. Keep draining
            # its producer until the command deadline so the client receives
            # the child's actual exit and stderr instead of a socket EPIPE.
            feeder.join(timeout=max(0, deadline - time.monotonic()))
            if feeder.is_alive():
                input_error.append(BrokerError("guarded Compose stdin stream did not finish"))
        if input_error:
            return_code = 78
            stderr_file.write(f"guarded Compose stdin transport failed: {input_error[0]}\n".encode())
        stdout_file.seek(0)
        stderr_file.seek(0)
        stdout = stdout_file.read(max_output + 1)
        stderr = stderr_file.read(max_output + 1)
    if len(stdout) > max_output:
        stdout = stdout[:max_output] + b"\n[broker output truncated]\n"
    if len(stderr) > max_output:
        stderr = stderr[:max_output] + b"\n[broker error output truncated]\n"
    return return_code, stdout.decode(errors="replace"), stderr.decode(errors="replace")


def owned_models(task_root: Path) -> list[tuple[Path, str, dict[str, Any]]]:
    """Return only models whose immutable task/clone claim still agrees."""
    directory = MODEL_DIR / hashlib.sha256(str(task_root).encode()).hexdigest()
    models = []
    for path in sorted(directory.glob("*.json")):
        try:
            record = json.loads(path.read_text())
            cwd = Path(record["cwd"]).resolve(strict=True)
            project = record["project"]
            if not is_within(cwd, task_root) or not isinstance(project, str):
                continue
            model = load_scoped_model(task_root, cwd, project)
        except (BrokerError, OSError, ValueError, KeyError, TypeError):
            continue
        models.append((cwd, project, model))
    return models


def owned_build_image(task_root: Path, cwd: Path, requested: str) -> tuple[Path, str, str]:
    matches = []
    requested = requested.removeprefix("local://")
    for directory, project, model in owned_models(task_root):
        if not (is_within(directory, cwd) or is_within(cwd, directory)):
            continue
        for name, service in (model.get("services") or {}).items():
            image = service.get("image")
            if not service.get("build") or not isinstance(image, str):
                continue
            if image != scoped_build_image(image, project, name):
                continue
            aliases = {image, f"{name}:latest", service.get("x-kandev-image-alias")}
            aliases.update(service.get("x-kandev-image-aliases") or [])
            if requested in aliases:
                matches.append((directory, project, image))
    unique = list(dict.fromkeys(matches))
    if len(unique) != 1:
        raise BrokerError("image must identify one image built by this task checkout; use its scoped tag")
    return unique[0]


def handle_scout_cves(
    task_root: Path, cwd: Path, args: list[str], environment: dict[str, str]
) -> dict[str, Any]:
    """Every task may scan its own built images, without a per-task grant."""
    if args in (["scout", "--help"], ["scout", "cves", "--help"]):
        code, stdout, stderr = run_command([DOCKER_BIN, *args], cwd)
        return {"returncode": code, "stdout": stdout, "stderr": stderr}
    if args[:2] != ["scout", "cves"] or len(args) < 3:
        raise BrokerError("supported Scout usage: docker scout cves [--only-severity critical,high,...] <task image>")
    scan_options = []
    index = 2
    value_options = {"--only-severity", "--only-package", "--only-package-type", "--only-cve-id", "--format", "--platform"}
    flag_options = {"--only-fixed", "--only-unfixed", "--ignore-base", "--ignore-suppressed", "--locations", "--epss"}
    while index < len(args) - 1:
        option, separator, value = args[index].partition("=")
        if option in flag_options and not separator:
            scan_options.append(option)
        elif option in value_options:
            if not separator:
                index += 1
                if index >= len(args) - 1:
                    raise BrokerError("missing Scout filter value or task image")
                value = args[index]
            if not value or value.startswith("-"):
                raise BrokerError("invalid Scout filter value")
            if option == "--only-severity" and not set(value.split(",")) <= {"critical", "high", "medium", "low", "unspecified"}:
                raise BrokerError("invalid Scout severity")
            scan_options.extend((option, value))
        else:
            raise BrokerError("unsupported read-only Scout option; redirect output into the task workspace")
        index += 1
    requested_image = args[-1]
    project_directory, project, image = owned_build_image(task_root, cwd, requested_image)

    code, stdout, stderr = run_command([DOCKER_BIN, "image", "inspect", image], cwd)
    if code != 0:
        raise BrokerError(f"task image has not been built locally: {image}")
    try:
        inspected = json.loads(stdout)
        info = inspected[0]
        image_id = info["Id"]
        digest = (info.get("Descriptor") or {}).get("digest") or "unavailable"
        if not isinstance(image_id, str) or not re.fullmatch(r"sha256:[0-9a-f]{64}", image_id):
            raise ValueError("invalid image ID")
        if digest != "unavailable" and not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
            raise ValueError("invalid image digest")
    except (IndexError, KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
        raise BrokerError("Docker returned invalid task image metadata") from exc

    audit_id = str(uuid.uuid4())
    audit_compose(task_root, project_directory, project, project, "scout cves", "allow",
                  "preflight", audit_id=audit_id, command_class="read-only")
    code, report, errors = run_command(
        [DOCKER_BIN, "scout", "cves", *scan_options, f"local://{image}"],
        cwd, timeout=COMMAND_TIMEOUT, max_output=MAX_SCOUT_OUTPUT,
        environment_overrides={"DOCKER_CONFIG": SCOUT_DOCKER_CONFIG},
    )
    # An image tag may be rebuilt while Scout runs. Do not label a report with
    # the prior digest if the tag no longer resolves to the same local image.
    check_code, check_stdout, _ = run_command([DOCKER_BIN, "image", "inspect", image], cwd)
    try:
        stable = check_code == 0 and json.loads(check_stdout)[0]["Id"] == image_id
    except (IndexError, KeyError, TypeError, json.JSONDecodeError):
        stable = False
    if not stable:
        code = 70
        errors += "\ntask image changed during Scout scan; rebuild and rescan\n"
    if "[broker output truncated]" in report or "[broker error output truncated]" in errors:
        code = 70
        errors += "\nScout output exceeded the broker limit; full report was not returned\n"
    audit_compose(task_root, project_directory, project, project, "scout cves", "allow",
                  "ok" if code == 0 else "error", audit_id=audit_id, command_class="read-only")
    header = f"task_image={image}\nimage_id={image_id}\nmanifest_digest={digest}\n"
    return {"returncode": code, "stdout": header + report, "stderr": errors,
            "project": project, "audit_id": audit_id, "resolved_project": project}


def handle_oneoff(
    task_root: Path, cwd: Path, args: list[str], environment: dict[str, str]
) -> dict[str, Any]:
    """Inspect or remove one exact Compose one-off owned by this task and clone."""
    if len(args) != 4 or args[2] not in {"inspect", "remove"}:
        raise BrokerError("oneoff usage: docker kandev oneoff inspect|remove <exact-name>")
    project = scoped_project_name(task_root, environment, cwd)
    model = load_scoped_model(task_root, cwd, project)
    name = args[3]
    services = model.get("services") or {}
    service = next(
        (s for s in services if re.fullmatch(
            re.escape(project) + "-" + re.escape(s) + r"-run-[a-z0-9]{8,32}", name
        )), None
    )
    if service is None:
        raise BrokerError("oneoff name is outside the saved task project services")
    code, stdout, stderr = run_command([DOCKER_BIN, "inspect", "--type", "container", name], cwd)
    if code != 0:
        if not any(marker in stderr for marker in ("No such object", "No such container")):
            raise BrokerError("oneoff Docker identity could not be inspected")
        return {"returncode": 0, "stdout": json.dumps({
            "project": project, "name": name, "status": "absent"
        }) + "\n", "stderr": ""}
    try:
        containers = json.loads(stdout)
        info = containers[0]
        labels = info["Config"]["Labels"]
    except (ValueError, IndexError, KeyError, TypeError) as exc:
        raise BrokerError("oneoff Docker identity is unreadable") from exc
    if (
        len(containers) != 1
        or info.get("Name") != "/" + name
        or not re.fullmatch(r"[0-9a-f]{64}", str(info.get("Id", "")))
        or labels.get("com.docker.compose.project") != project
        or labels.get("com.docker.compose.service") != service
        or str(labels.get("com.docker.compose.oneoff", "")).lower() != "true"
    ):
        raise BrokerError("oneoff Docker labels do not match the saved task project")
    container_id = info["Id"]
    status = str((info.get("State") or {}).get("Status") or "unknown")
    if args[2] == "remove":
        audit_id = str(uuid.uuid4())
        audit_compose(task_root, cwd, project, project, "oneoff remove",
                      "allow", "preflight", audit_id=audit_id)
        code, _, stderr = run_command(
            [DOCKER_BIN, "container", "rm", "--force", container_id], cwd
        )
        if code != 0:
            audit_compose(task_root, cwd, project, project, "oneoff remove",
                          "allow", "error", audit_id=audit_id)
            raise BrokerError(f"exact oneoff removal failed: {stderr.strip()}")
        audit_compose(task_root, cwd, project, project, "oneoff remove",
                      "allow", "ok", audit_id=audit_id)
        status = "removed"
    response = {"returncode": 0, "stdout": json.dumps({
        "project": project, "name": name, "container_id": container_id,
        "service": service, "status": status,
    }) + "\n", "stderr": ""}
    if args[2] == "remove":
        response.update({"audit_id": audit_id, "resolved_project": project})
    return response


def kandev_db() -> sqlite3.Connection:
    if not KANDEV_DB.is_file():
        raise BrokerError("Kandev task metadata is unavailable")
    connection = sqlite3.connect(f"file:{KANDEV_DB}?mode=ro", uri=True, timeout=5)
    connection.row_factory = sqlite3.Row
    return connection


def coordinator_context(task_root: Path) -> dict[str, str]:
    """Resolve a coordinator's task/workspace from trusted Kandev metadata.

    A repository name or agent-controlled .git file is not sufficient. The
    task's primary materialized workspace must itself be the coordinator repo,
    and that repo must be registered in the same Kandev workspace.
    """
    candidates: list[sqlite3.Row]
    with kandev_db() as database:
        if is_within(task_root, Path("/data/tasks")):
            relative = task_root.relative_to("/data/tasks")
            if len(relative.parts) != 1:
                raise BrokerError("invalid coordinator task root")
            candidates = database.execute(
                """
                SELECT t.id AS task_id, t.workspace_id, w.name AS workspace_name,
                       te.workspace_path, te.task_dir_name
                FROM task_environments te
                JOIN tasks t ON t.id = te.task_id
                JOIN workspaces w ON w.id = t.workspace_id
                WHERE te.task_dir_name = ? AND t.archived_at IS NULL
                """,
                (relative.name,),
            ).fetchall()
        else:
            candidates = database.execute(
                """
                SELECT t.id AS task_id, t.workspace_id, w.name AS workspace_name,
                       te.workspace_path, te.task_dir_name
                FROM task_environments te
                JOIN tasks t ON t.id = te.task_id
                JOIN workspaces w ON w.id = t.workspace_id
                WHERE te.workspace_path = ? AND t.archived_at IS NULL
                """,
                (str(task_root),),
            ).fetchall()

        eligible: list[sqlite3.Row] = []
        for candidate in candidates:
            primary_path = Path(str(candidate["workspace_path"]))
            if task_root == Path(COORDINATOR_REPOSITORY):
                primary_matches = primary_path == task_root
            else:
                # Older/restored task rows can retain the source repository as
                # workspace_path even though task_dir_name now owns a proper
                # linked worktree. The unique task directory plus the trusted
                # single-repository registration below is the authority.
                primary_matches = True
            if not primary_matches:
                continue
            registration = database.execute(
                """
                SELECT COUNT(*) AS repository_count,
                       SUM(CASE WHEN r.workspace_id = ? AND r.local_path = ?
                                     AND r.deleted_at IS NULL
                                THEN 1 ELSE 0 END) AS coordinator_count
                FROM task_repositories tr
                JOIN repositories r ON r.id = tr.repository_id
                WHERE tr.task_id = ?
                """,
                (
                    candidate["workspace_id"],
                    COORDINATOR_REPOSITORY,
                    candidate["task_id"],
                ),
            ).fetchone()
            if (
                registration
                and int(registration["repository_count"] or 0) == 1
                and int(registration["coordinator_count"] or 0) == 1
            ):
                eligible.append(candidate)

    if not eligible:
        raise BrokerError(
            "source access requires a live coordinator task whose primary repository "
            f"is {COORDINATOR_REPOSITORY}"
        )
    if len(eligible) != 1:
        raise BrokerError("coordinator task identity is ambiguous")
    row = eligible[0]
    return {
        "task_id": str(row["task_id"]),
        "workspace_id": str(row["workspace_id"]),
        "workspace_name": str(row["workspace_name"]),
    }


def container_path_for_host(path: str) -> Path | None:
    candidate = Path(os.path.normpath(path))
    if not candidate.is_absolute():
        return None
    mappings = [
        (os.environ.get("KANDEV_HOST_CODE_DIR", ""), Path("/data/home/Code")),
        (os.environ.get("KANDEV_HOST_DATA_DIR", ""), Path("/data")),
    ]
    matches: list[tuple[int, Path]] = []
    for host_prefix, container_prefix in mappings:
        if not host_prefix:
            continue
        try:
            relative = candidate.relative_to(Path(host_prefix))
        except ValueError:
            continue
        matches.append((len(Path(host_prefix).parts), container_prefix / relative))
    if matches:
        return max(matches, key=lambda item: item[0])[1]
    if candidate == Path("/data") or is_within(candidate, Path("/data")):
        return candidate
    return None


def inspected_container_working_dir(info: dict[str, Any]) -> Path | None:
    """Translate a container working directory through its inspected bind mount.

    The in-container working-directory string is not ownership evidence on its
    own: a guarded Compose service may select an arbitrary directory. Only a
    Docker-inspected bind source can establish the corresponding host path.
    """
    config = info.get("Config") or {}
    working_dir_raw = str(config.get("WorkingDir") or "")
    if not working_dir_raw:
        return None
    working_dir = Path(os.path.normpath(working_dir_raw))
    if not working_dir.is_absolute():
        return None

    best_match: tuple[int, Path] | None = None
    for mount in info.get("Mounts") or []:
        if not isinstance(mount, dict) or mount.get("Type") != "bind":
            continue
        source_raw = str(mount.get("Source") or "")
        destination_raw = str(mount.get("Destination") or "")
        if not source_raw or not destination_raw:
            continue
        source = Path(os.path.normpath(source_raw))
        destination = Path(os.path.normpath(destination_raw))
        if not source.is_absolute() or not destination.is_absolute():
            continue
        try:
            relative = working_dir.relative_to(destination)
        except ValueError:
            continue
        translated = container_path_for_host(str(source / relative))
        if translated is None:
            continue
        depth = len(destination.parts)
        if best_match is None or depth > best_match[0]:
            best_match = (depth, translated)
    if best_match is not None:
        return best_match[1]
    return None


def registered_runtime_workspace_ids(
    info: dict[str, Any], labels: dict[str, Any], database: sqlite3.Connection
) -> set[str] | None:
    """Resolve one backend-managed runtime through its live DB registration.

    ``None`` means the container has no complete Kandev runtime identity, so an
    independently trusted Compose ownership path may still be considered. A
    complete but stale, conflicting, or spoofed identity returns an empty set
    and cannot fall back to those less specific heuristics.
    """
    if not any(label in labels for label in RUNTIME_IDENTITY_LABELS):
        return None
    task_id = str(labels.get("kandev.task_id") or "")
    session_id = str(labels.get("kandev.session_id") or "")
    environment_id = str(labels.get("kandev.task_environment_id") or "")
    instance_id = str(labels.get("kandev.instance_id") or "")
    # A partial label set is not authoritative enough to revoke an otherwise
    # valid trusted Compose/workdir association. Once all identity labels are
    # present, however, a stale or conflicting claim must fail closed.
    if not task_id or not session_id or not environment_id:
        return None
    container_id = str(info.get("Id") or "")
    working_dir = inspected_container_working_dir(info)
    if labels.get("kandev.managed") != "true" or not container_id:
        return set()

    placeholders = ", ".join("?" for _ in ACTIVE_TASK_SESSION_STATES)
    environment_placeholders = ", ".join("?" for _ in ACTIVE_TASK_ENVIRONMENT_STATES)
    executor_placeholders = ", ".join("?" for _ in ACTIVE_EXECUTOR_STATES)
    row = database.execute(
        f"""
        SELECT t.workspace_id, te.workspace_path, te.task_dir_name,
               te.container_id AS environment_container_id,
               er.container_id AS executor_container_id,
               er.agent_execution_id
        FROM tasks t
        JOIN task_sessions ts
          ON ts.id = ? AND ts.task_id = t.id
        JOIN task_environments te
          ON te.id = ? AND te.task_id = t.id
        JOIN executors_running er
          ON er.session_id = ts.id AND er.task_id = t.id
        WHERE t.id = ? AND t.archived_at IS NULL
          AND ts.task_environment_id = te.id
          AND ts.state IN ({placeholders})
          AND te.status IN ({environment_placeholders})
          AND er.status IN ({executor_placeholders})
        """,
        (
            session_id,
            environment_id,
            task_id,
            *sorted(ACTIVE_TASK_SESSION_STATES),
            *sorted(ACTIVE_TASK_ENVIRONMENT_STATES),
            *sorted(ACTIVE_EXECUTOR_STATES),
        ),
    ).fetchone()
    if row is None:
        return set()
    persisted_instance_id = str(row["agent_execution_id"] or "")
    if instance_id and instance_id != persisted_instance_id:
        return set()

    exact_container_binding = False
    for column in ("environment_container_id", "executor_container_id"):
        persisted_container_id = str(row[column] or "")
        if persisted_container_id and persisted_container_id != container_id:
            return set()
        if persisted_container_id == container_id:
            exact_container_binding = True
    exact_instance_binding = bool(instance_id and instance_id == persisted_instance_id)

    roots: list[Path] = []
    workspace_path_raw = str(row["workspace_path"] or "")
    if workspace_path_raw:
        workspace_path = container_path_for_host(workspace_path_raw)
        if workspace_path is not None:
            roots.append(workspace_path)
    task_dir_name = str(row["task_dir_name"] or "")
    if TASK_DIR_RE.fullmatch(task_dir_name):
        roots.append(Path("/data/tasks") / task_dir_name)
    path_binding = working_dir is not None and any(
        working_dir == root or is_within(working_dir, root) for root in roots
    )
    if not (exact_container_binding or exact_instance_binding or path_binding):
        return set()
    return {str(row["workspace_id"])}


def container_workspace_ids(info: dict[str, Any]) -> set[str]:
    labels = (info.get("Config") or {}).get("Labels") or {}
    workspace_ids: set[str] = set()
    working_dir_raw = labels.get("com.docker.compose.project.working_dir")
    working_dir = container_path_for_host(str(working_dir_raw)) if working_dir_raw else None

    with kandev_db() as database:
        runtime_workspace_ids = registered_runtime_workspace_ids(info, labels, database)
        if runtime_workspace_ids is not None:
            return runtime_workspace_ids
        if working_dir and is_within(working_dir, Path("/data/tasks")):
            relative = working_dir.relative_to("/data/tasks")
            if relative.parts:
                rows = database.execute(
                    """
                    SELECT t.workspace_id
                    FROM task_environments te
                    JOIN tasks t ON t.id = te.task_id
                    WHERE te.task_dir_name = ? AND t.archived_at IS NULL
                    """,
                    (relative.parts[0],),
                ).fetchall()
                workspace_ids.update(str(row["workspace_id"]) for row in rows)
        elif working_dir:
            rows = database.execute(
                """
                SELECT workspace_id, local_path
                FROM repositories
                WHERE deleted_at IS NULL
                """
            ).fetchall()
            for row in rows:
                repository_path = Path(str(row["local_path"]))
                if working_dir == repository_path or is_within(working_dir, repository_path):
                    workspace_ids.add(str(row["workspace_id"]))

        project = str(labels.get("com.docker.compose.project") or "")
        if project.startswith("kd_"):
            rows = database.execute(
                """
                SELECT t.workspace_id, te.task_dir_name, te.workspace_path
                FROM task_environments te
                JOIN tasks t ON t.id = te.task_id
                WHERE t.archived_at IS NULL
                """
            ).fetchall()
            for row in rows:
                task_dir_name = str(row["task_dir_name"] or "")
                roots = []
                if task_dir_name:
                    roots.append(Path("/data/tasks") / task_dir_name)
                workspace_path_raw = str(row["workspace_path"] or "")
                workspace_path = Path(workspace_path_raw)
                if workspace_path_raw and not is_within(workspace_path, Path("/data/tasks")):
                    roots.append(workspace_path)
                if any(project_name(root) == project for root in roots):
                    workspace_ids.add(str(row["workspace_id"]))
    return workspace_ids


def docker_inspect_container(name: str) -> dict[str, Any]:
    if not CONTAINER_NAME_RE.fullmatch(name):
        raise BrokerError("invalid source container name")
    code, stdout, stderr = run_command(
        [DOCKER_BIN, "inspect", "--type", "container", name], Path("/tmp"), timeout=30
    )
    if code != 0:
        raise BrokerError(f"source container is unavailable: {name}: {stderr or stdout}")
    try:
        documents = json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise BrokerError("Docker returned invalid container metadata") from exc
    if not isinstance(documents, list) or len(documents) != 1:
        raise BrokerError("Docker returned unexpected container metadata")
    return documents[0]


def require_workspace_container(name: str, workspace_id: str) -> dict[str, Any]:
    info = docker_inspect_container(name)
    if workspace_id not in container_workspace_ids(info):
        raise BrokerError(
            f"source container is not associated with the coordinator workspace: {name}"
        )
    return info


def container_summary(info: dict[str, Any]) -> dict[str, Any]:
    labels = (info.get("Config") or {}).get("Labels") or {}
    state = info.get("State") or {}
    health = (state.get("Health") or {}).get("Status")
    ports: list[dict[str, Any]] = []
    for container_port, bindings in sorted(
        ((info.get("NetworkSettings") or {}).get("Ports") or {}).items()
    ):
        host_bindings = []
        for binding in bindings or []:
            host_bindings.append(
                {"address": binding.get("HostIp", ""), "port": binding.get("HostPort", "")}
            )
        ports.append({"container": container_port, "host": host_bindings})
    return {
        "name": str(info.get("Name") or "").lstrip("/"),
        "id": str(info.get("Id") or "")[:12],
        "image": str((info.get("Config") or {}).get("Image") or ""),
        "state": str(state.get("Status") or "unknown"),
        "health": health,
        "compose_project": labels.get("com.docker.compose.project"),
        "compose_service": labels.get("com.docker.compose.service"),
        "ports": ports,
    }


def list_workspace_containers(workspace_id: str) -> list[dict[str, Any]]:
    code, stdout, stderr = run_command(
        [DOCKER_BIN, "container", "ls", "--all", "--quiet"], Path("/tmp"), timeout=30
    )
    if code != 0:
        raise BrokerError(f"cannot list source containers: {stderr or stdout}")
    identifiers = [line.strip() for line in stdout.splitlines() if line.strip()]
    if not identifiers:
        return []
    code, stdout, stderr = run_command(
        [DOCKER_BIN, "inspect", "--type", "container", *identifiers],
        Path("/tmp"),
        timeout=30,
    )
    if code != 0:
        raise BrokerError(f"cannot inspect source containers: {stderr or stdout}")
    try:
        infos = json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise BrokerError("Docker returned invalid container metadata") from exc
    visible = [
        container_summary(info)
        for info in infos
        if workspace_id in container_workspace_ids(info)
    ]
    return sorted(visible, key=lambda item: str(item["name"]))


def redact_logs(value: str) -> str:
    pattern = re.compile(
        r"(?i)(password|passwd|token|secret|authorization|api[_-]?key)"
        r"(\s*[:=]\s*)([^\s,;]+)"
    )
    return pattern.sub(lambda match: f"{match.group(1)}{match.group(2)}<redacted>", value)


def audit_source(context: dict[str, str], operation: str, **fields: Any) -> None:
    event = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "coordinator_task_id": context["task_id"],
        "workspace_id": context["workspace_id"],
        "operation": operation,
        **fields,
    }
    try:
        COORDINATOR_AUDIT_LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        line = json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n"
        with AUDIT_LOCK, COORDINATOR_AUDIT_LOG.open("a", encoding="utf-8") as handle:
            handle.write(line)
        COORDINATOR_AUDIT_LOG.chmod(0o600)
    except OSError as exc:
        raise BrokerError(f"cannot record coordinator source audit event: {exc}") from exc


def target_task_inbox(target_task_id: str, workspace_id: str, output_name: str) -> tuple[Path, str]:
    if not TASK_ID_RE.fullmatch(target_task_id):
        raise BrokerError("target task ID must be a full UUID")
    if not SAFE_OUTPUT_NAME_RE.fullmatch(output_name) or output_name in {".", ".."}:
        raise BrokerError("invalid export output name")
    with kandev_db() as database:
        row = database.execute(
            """
            SELECT te.task_dir_name
            FROM tasks t
            JOIN task_environments te ON te.task_id = t.id
            WHERE t.id = ? AND t.workspace_id = ? AND t.archived_at IS NULL
            """,
            (target_task_id, workspace_id),
        ).fetchone()
    if row is None or not str(row["task_dir_name"] or ""):
        raise BrokerError("target task has no active task-scoped workspace")
    container_root = Path("/data/tasks") / str(row["task_dir_name"])
    host_root = translate_to_host(container_root)
    inbox = host_root / ".kandev-coordinator-inbox"
    inbox.mkdir(mode=0o700, parents=False, exist_ok=True)
    inbox.chmod(0o700)
    resolved_inbox = inbox.resolve(strict=True)
    if not is_within(resolved_inbox, host_root):
        raise BrokerError("target task inbox escapes its workspace")
    destination = resolved_inbox / output_name
    if destination.exists() or destination.is_symlink():
        raise BrokerError("target task export already exists")
    container_destination = f"{container_root}/.kandev-coordinator-inbox/{output_name}"
    return destination, container_destination


# Project artifact v1: operator registration, content-free discovery, exact inbox delivery.
ARTIFACT_REGISTRY = Path('/etc/kandev/project-artifacts.json')
ARTIFACT_REGISTRY_UID = 0
ARTIFACT_ROOT_UID = 0
ARTIFACT_RECEIPTS = Path('/data/project-artifact-receipts')
MAX_PROJECT_ARTIFACT = 64 * 1024 * 1024


@contextmanager
def artifact_directory(path: Path, owner_uid: int):
    """Pin each component without resolving links, including trusted DB paths."""
    if not path.is_absolute() or any(p in {'.', '..'} for p in path.parts):
        raise BrokerError('invalid registered directory')
    descriptor = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    try:
        for component in path.parts[1:]:
            child = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                            dir_fd=descriptor)
            os.close(descriptor)
            descriptor = child
            info = os.fstat(descriptor)
            if info.st_uid not in {ARTIFACT_ROOT_UID, owner_uid} or (
                info.st_mode & 0o022 and not (info.st_uid == ARTIFACT_ROOT_UID and info.st_mode & stat.S_ISVTX)
            ):
                raise BrokerError('unsafe registered directory ownership or permissions')
        yield descriptor
    finally:
        os.close(descriptor)


def artifact_signature(info):
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns,
            info.st_ctime_ns, info.st_uid, info.st_mode, info.st_nlink)


def artifact_regular(info, owner_uid, limit, readonly=True):
    if (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1
            or info.st_uid != owner_uid or info.st_size > limit
            or info.st_mode & (0o222 if readonly else 0o022)):
        raise BrokerError('unsafe artifact type, ownership, links, permissions or size')


def artifact_read(directory, name, owner_uid, limit, readonly=True):
    fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    try:
        before = os.fstat(fd)
        artifact_regular(before, owner_uid, limit, readonly)
        chunks = []
        size = 0
        while True:
            chunk = os.read(fd, min(1024 * 1024, limit + 1 - size))
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
            if size > limit:
                raise BrokerError('artifact exceeds size limit')
        after = os.fstat(fd)
        named = os.stat(name, dir_fd=directory, follow_symlinks=False)
        if artifact_signature(before) != artifact_signature(after) or (
                artifact_signature(before) != artifact_signature(named)):
            raise BrokerError('artifact source changed')
        return b''.join(chunks), artifact_signature(after)
    finally:
        os.close(fd)


def artifact_registry():
    try:
        with artifact_directory(ARTIFACT_REGISTRY.parent, ARTIFACT_REGISTRY_UID) as directory:
            if os.fstat(directory).st_uid != ARTIFACT_REGISTRY_UID:
                raise BrokerError('artifact registration directory is not operator-owned')
            raw, _ = artifact_read(directory, ARTIFACT_REGISTRY.name,
                                   ARTIFACT_REGISTRY_UID, 128 * 1024)
        registry = json.loads(raw)
        if registry.get('version') != 1 or not isinstance(registry.get('projects'), dict):
            raise ValueError()
        return registry, hashlib.sha256(raw).hexdigest()
    except (OSError, ValueError, TypeError, AttributeError) as exc:
        raise BrokerError('operator artifact registration unavailable or invalid') from exc


def artifact_project(workspace_id, project_id, artifact_name):
    if not TASK_ID_RE.fullmatch(project_id) or not SAFE_OUTPUT_NAME_RE.fullmatch(artifact_name):
        raise BrokerError('artifact requests require an exact repository UUID and artifact key')
    with kandev_db() as database:
        row = database.execute('''SELECT id, local_path FROM repositories
            WHERE id=? AND workspace_id=? AND deleted_at IS NULL''',
            (project_id, workspace_id)).fetchone()
    if row is None:
        raise BrokerError('unknown project in coordinator workspace')
    registry, registry_hash = artifact_registry()
    entry = registry['projects'].get(project_id)
    if not isinstance(entry, dict) or entry.get('workspace_id') != workspace_id:
        raise BrokerError('project artifact owner is not registered')
    if entry.get('owner') != 'Human' or type(entry.get('owner_uid')) is not int or entry['owner_uid'] < 0:
        raise BrokerError('unknown project artifact owner')
    root = container_path_for_host(str(row['local_path']))
    # A UUID must never be repointed underneath an existing operator grant.
    if root is None or str(root) != entry.get('repository_path') or root.parent != Path('/data/home/Code'):
        raise BrokerError('registered project identity changed or is outside the project root')
    directory_name = entry.get('directory')
    if (not isinstance(directory_name, str) or not SAFE_OUTPUT_NAME_RE.fullmatch(directory_name)
            or directory_name in {'.', '..', '.git'}):
        raise BrokerError('invalid owner-selected artifact directory')
    artifacts = entry.get('artifacts')
    if not isinstance(artifacts, dict):
        raise BrokerError('invalid registered artifact catalog')
    spec = artifacts.get(artifact_name)
    if not isinstance(spec, dict):
        raise BrokerError('unknown registered artifact')
    filename = spec.get('file')
    if (not isinstance(filename, str) or not SAFE_OUTPUT_NAME_RE.fullmatch(filename)
            or filename in {'.', '..', 'recipe.json', 'receipt.json'}):
        raise BrokerError('invalid registered artifact filename')
    if (type(spec.get('bytes')) is not int or not 0 <= spec['bytes'] <= MAX_PROJECT_ARTIFACT
            or not re.fullmatch('[0-9a-f]{64}', str(spec.get('sha256', '')))
            or type(spec.get('compatible')) is not bool):
        raise BrokerError('invalid registered artifact integrity or compatibility')
    recipe = spec.get('recipe')
    if (not isinstance(recipe, dict) or set(recipe) != {'id', 'instructions', 'assertions'}
            or not isinstance(recipe['id'], str) or not recipe['id']
            or not isinstance(recipe['instructions'], str) or not recipe['instructions']
            or not isinstance(recipe['assertions'], list)
            or not all(isinstance(s, str) for s in recipe['assertions'])
            or len(json.dumps(recipe).encode()) > 32 * 1024):
        raise BrokerError('artifact requires an inert operator-reviewed recipe')
    for key in ('purpose', 'format', 'version', 'provenance', 'refresh_rule'):
        if not isinstance(spec.get(key), str) or not spec[key] or len(spec[key]) > 1024:
            raise BrokerError('invalid registered artifact metadata')
    return entry, spec, translate_to_host_lexical(root / directory_name), registry_hash


def artifact_discovery(context, project_id, artifact_name, include_bytes=False):
    metadata = {'project_id': project_id, 'artifact': artifact_name}
    try:
        entry, spec, directory_path, registration_hash = artifact_project(
            context['workspace_id'], project_id, artifact_name)
        metadata.update({key: spec[key] for key in
                         ('purpose', 'format', 'version', 'provenance', 'refresh_rule', 'bytes', 'sha256')})
        metadata.update(owner='Human', registration_sha256=registration_hash,
                        recipe_id=spec['recipe']['id'])
        with artifact_directory(directory_path, entry['owner_uid']) as directory:
            info = os.fstat(directory)
            if info.st_uid != entry['owner_uid'] or info.st_mode & 0o222:
                raise BrokerError('artifact directory must be Human-owned and read-only')
            raw, signature = artifact_read(directory, spec['file'], entry['owner_uid'], MAX_PROJECT_ARTIFACT)
            directory_identity = (info.st_dev, info.st_ino)
        if not spec['compatible'] or len(raw) != spec['bytes'] or hashlib.sha256(raw).hexdigest() != spec['sha256']:
            metadata.update(status='STALE_OR_INCOMPATIBLE', reason='integrity_or_compatibility')
        else:
            metadata.update(status='AVAILABLE', reason='verified')
        if include_bytes and metadata['status'] == 'AVAILABLE':
            return metadata, (entry, spec, directory_path, directory_identity, signature, raw)
    except FileNotFoundError:
        metadata.update(status='ABSENT', reason='owner_selected_source_missing')
    except (BrokerError, OSError):
        metadata.update(status='INACCESSIBLE', reason='registration_or_source_denied')
    return metadata, None


def artifact_task(workspace_id, task_id, project_id=None):
    if not TASK_ID_RE.fullmatch(task_id):
        raise BrokerError('artifact target requires an exact task UUID')
    with kandev_db() as database:
        rows = database.execute('''SELECT te.id AS environment_id, te.task_dir_name,
                te.ownership_generation, t.workflow_step_id, t.state, t.title, t.metadata,
                ws.name AS lane
            FROM tasks t JOIN task_environments te ON te.task_id=t.id
            JOIN workflow_steps ws ON ws.id=t.workflow_step_id
            WHERE t.id=? AND t.workspace_id=? AND t.archived_at IS NULL
              AND te.status='ready' AND te.task_dir_name<>''
              AND EXISTS (SELECT 1 FROM task_sessions s WHERE s.task_id=t.id
                AND s.task_environment_id=te.id AND s.completed_at IS NULL
                AND s.state IN ('CREATED','STARTING','RUNNING','WAITING_FOR_INPUT'))''',
            (task_id, workspace_id)).fetchall()
        if len(rows) != 1:
            raise BrokerError('artifact target has no unique active platform environment')
        row = rows[0]
        ancestry = database.execute('''WITH RECURSIVE ancestors(id, parent_id, title, metadata) AS (
                SELECT id, parent_id, title, metadata FROM tasks WHERE id=? AND workspace_id=?
                UNION SELECT t.id, t.parent_id, t.title, t.metadata FROM tasks t
                JOIN ancestors a ON t.id=a.parent_id WHERE t.workspace_id=?
            ) SELECT title, metadata FROM ancestors''', (task_id, workspace_id, workspace_id)).fetchall()
        if any(re.search(r'(?<!\d)8241(?!\d)', str(a['title']) + str(a['metadata'])) for a in ancestry):
            raise BrokerError('artifact target belongs to protected Feature 8241')
        # Enforce protected lanes before accessing a task's files.
        if (str(row['lane']).lower().replace(' ', '').replace('-', '') == 'todeploy'
                or row['state'] in {'DONE', 'COMPLETED', 'CANCELLED', 'FAILED'}
                or re.search(r'(?<!\d)8241(?!\d)', str(row['title']) + str(row['metadata']))):
            raise BrokerError('artifact target is protected or terminal')
        if project_id and database.execute('''SELECT 1 FROM task_repositories
                WHERE task_id=? AND repository_id=?''', (task_id, project_id)).fetchone() is None:
            raise BrokerError('artifact project is not attached to target task')
    name = str(row['task_dir_name'])
    if not TASK_DIR_RE.fullmatch(name):
        raise BrokerError('invalid artifact target directory')
    return dict(row), Path('/data/tasks') / name


def artifact_remove_owned(directory, name, identity):
    try:
        info = os.stat(name, dir_fd=directory, follow_symlinks=False)
        if (info.st_dev, info.st_ino) == identity:
            os.unlink(name, dir_fd=directory)
    except FileNotFoundError:
        pass


def artifact_write(directory, name, raw):
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                 0o600, dir_fd=directory)
    info = os.fstat(fd)
    identity = (info.st_dev, info.st_ino)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
    except Exception:
        artifact_remove_owned(directory, name, identity)
        raise
    return identity


def artifact_json(value):
    return (json.dumps(value, sort_keys=True) + '\n').encode()


def artifact_delivery(context, project_id, artifact_name, target_id):
    with EXPORT_LOCK:
        binding, container_root = artifact_task(context['workspace_id'], target_id, project_id)
        metadata, source = artifact_discovery(context, project_id, artifact_name, True)
        if source is None:
            raise BrokerError('artifact delivery requires AVAILABLE discovery')
        entry, spec, source_path, source_identity, signature, raw = source
        host_root = translate_to_host_lexical(container_root)
        delivery_id = str(uuid.uuid4())
        receipt = dict(metadata, delivery_id=delivery_id, workspace_id=context['workspace_id'],
                       coordinator_task_id=context['task_id'], target_task_id=target_id,
                       environment_id=binding['environment_id'],
                       ownership_generation=binding['ownership_generation'],
                       state='DELIVERED', file=spec['file'],
                       recipe_sha256=hashlib.sha256(artifact_json(spec['recipe'])).hexdigest())
        with artifact_directory(host_root, os.getuid()) as root:
            root_signature = (os.fstat(root).st_dev, os.fstat(root).st_ino)
            try:
                os.mkdir('.kandev-coordinator-inbox', 0o700, dir_fd=root)
            except FileExistsError:
                pass
            inbox = os.open('.kandev-coordinator-inbox', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=root)
            try:
                info = os.fstat(inbox)
                if info.st_uid != os.getuid() or info.st_mode & 0o077:
                    raise BrokerError('unsafe target artifact inbox')
                os.mkdir(delivery_id, 0o700, dir_fd=inbox)  # Never replace a collision.
                bundle = os.open(delivery_id, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=inbox)
                created = {}
                server_record_identity = None
                try:
                    created[spec['file']] = artifact_write(bundle, spec['file'], raw)
                    created['recipe.json'] = artifact_write(bundle, 'recipe.json', artifact_json(spec['recipe']))
                    # Recheck source identity, registration, and platform binding before publishing.
                    with artifact_directory(source_path, entry['owner_uid']) as directory:
                        if (os.fstat(directory).st_dev, os.fstat(directory).st_ino) != source_identity:
                            raise BrokerError('artifact source directory changed')
                        current = os.stat(spec['file'], dir_fd=directory, follow_symlinks=False)
                        if artifact_signature(current) != signature:
                            raise BrokerError('artifact source changed before delivery')
                    if artifact_registry()[1] != metadata['registration_sha256']:
                        raise BrokerError('artifact registration changed before delivery')
                    if (coordinator_context(Path('/data/tasks') / artifact_task(
                            context['workspace_id'], context['task_id'])[0]['task_dir_name']) != context):
                        raise BrokerError('artifact Coordinator changed before delivery')
                    if artifact_task(context['workspace_id'], target_id, project_id)[0] != binding:
                        raise BrokerError('artifact target changed before delivery')
                    with artifact_directory(host_root, os.getuid()) as current_root:
                        if (os.fstat(current_root).st_dev, os.fstat(current_root).st_ino) != root_signature:
                            raise BrokerError('artifact target root changed')
                    with artifact_directory(host_root / '.kandev-coordinator-inbox', os.getuid()) as current_inbox:
                        if (os.fstat(current_inbox).st_dev, os.fstat(current_inbox).st_ino) != (info.st_dev, info.st_ino):
                            raise BrokerError('artifact inbox changed')
                        named = os.stat(delivery_id, dir_fd=current_inbox, follow_symlinks=False)
                        if (named.st_dev, named.st_ino) != (os.fstat(bundle).st_dev, os.fstat(bundle).st_ino):
                            raise BrokerError('artifact bundle changed')
                    # Server receipt is outside agent writable scope; it contains no source bytes.
                    ARTIFACT_RECEIPTS.mkdir(mode=0o700, exist_ok=True)
                    with artifact_directory(ARTIFACT_RECEIPTS, os.getuid()) as records:
                        server_record_identity = artifact_write(records, delivery_id + '.json', artifact_json(receipt))
                    created['receipt.json'] = artifact_write(bundle, 'receipt.json', artifact_json(receipt))
                    os.fsync(bundle)
                except Exception:
                    for name, identity in created.items():
                        artifact_remove_owned(bundle, name, identity)
                    if server_record_identity is not None:
                        with artifact_directory(ARTIFACT_RECEIPTS, os.getuid()) as records:
                            artifact_remove_owned(records, delivery_id + '.json', server_record_identity)
                    named = os.stat(delivery_id, dir_fd=inbox, follow_symlinks=False)
                    if (named.st_dev, named.st_ino) == (os.fstat(bundle).st_dev, os.fstat(bundle).st_ino):
                        try:
                            os.rmdir(delivery_id, dir_fd=inbox)
                        except OSError:
                            pass  # Preserve any file inserted by the target.
                    raise
                finally:
                    os.close(bundle)
            finally:
                os.close(inbox)
        audit_source(context, 'artifact-deliver', result='ok', **receipt)
        return dict(receipt, path=str(container_root / '.kandev-coordinator-inbox' / delivery_id))


def artifact_receipt(task_root, delivery_id, status=None, checksum=None, context=None):
    with EXPORT_LOCK:
        return artifact_receipt_locked(task_root, delivery_id, status, checksum, context)


def artifact_receipt_locked(task_root, delivery_id, status=None, checksum=None, context=None):
    if not TASK_ID_RE.fullmatch(delivery_id):
        raise BrokerError('invalid artifact delivery UUID')
    with artifact_directory(ARTIFACT_RECEIPTS, os.getuid()) as records:
        raw, _ = artifact_read(records, delivery_id + '.json', os.getuid(), 128 * 1024, False)
        receipt = json.loads(raw)
        if context is not None:
            if (receipt['workspace_id'] != context['workspace_id']
                    or receipt['coordinator_task_id'] != context['task_id']):
                raise BrokerError('artifact receipt is outside this Coordinator grant')
        else:
            binding, container_root = artifact_task(receipt['workspace_id'], receipt['target_task_id'], receipt['project_id'])
            if (task_root != container_root or status not in {'RECEIVED', 'CONSUMED', 'FAILED'}
                    or checksum != receipt['sha256']
                    or binding['environment_id'] != receipt['environment_id']
                    or binding['ownership_generation'] != receipt['ownership_generation']):
                raise BrokerError('artifact acknowledgement identity or hash mismatch')
            with artifact_directory(translate_to_host_lexical(container_root) / '.kandev-coordinator-inbox' / delivery_id,
                                    os.getuid()) as bundle:
                data, _ = artifact_read(bundle, receipt['file'], os.getuid(), MAX_PROJECT_ARTIFACT, False)
                recipe, _ = artifact_read(bundle, 'recipe.json', os.getuid(), 32 * 1024, False)
                if (hashlib.sha256(data).hexdigest() != checksum
                        or len(data) != receipt['bytes']
                        or hashlib.sha256(recipe).hexdigest() != receipt['recipe_sha256']):
                    raise BrokerError('delivered artifact or recipe changed')
            acknowledgement = {'delivery_id': delivery_id, 'target_task_id': receipt['target_task_id'],
                               'sha256': checksum, 'state': status}
            for terminal in ('CONSUMED', 'FAILED'):
                try:
                    prior, _ = artifact_read(records, delivery_id + '.' + terminal + '.json', os.getuid(), 4096, False)
                except FileNotFoundError:
                    continue
                if json.loads(prior) != acknowledgement:
                    raise BrokerError('artifact acknowledgement is already terminal')
            try:
                artifact_write(records, delivery_id + '.' + status + '.json', artifact_json(acknowledgement))
            except FileExistsError:
                prior, _ = artifact_read(records, delivery_id + '.' + status + '.json', os.getuid(), 4096, False)
                if json.loads(prior) != acknowledgement:
                    raise BrokerError('artifact acknowledgement collision')
            audit_source({'task_id': receipt['target_task_id'], 'workspace_id': receipt['workspace_id'],
                          'workspace_name': ''}, 'artifact-ack', result='ok', **acknowledgement)
        receipt['target_receipt'] = None
        for state in ('CONSUMED', 'FAILED', 'RECEIVED'):
            try:
                ack, _ = artifact_read(records, delivery_id + '.' + state + '.json', os.getuid(), 4096, False)
                receipt['target_receipt'] = json.loads(ack)
                break
            except FileNotFoundError:
                pass
    return receipt


def registered_static_backup(source_path: str, workspace_id: str) -> tuple[Path, str]:
    """Return one approved logical backup from a registered source root.

    This is deliberately not a generic file-read API.  The caller must name
    exactly ``last_db.sql`` directly below a live repository registered in the
    coordinator's own workspace.  Both the root and the file are rejected if
    they are symlinks.
    """
    requested = Path(source_path)
    if not requested.is_absolute() or requested.name != STATIC_BACKUP_NAME:
        raise BrokerError(f"static backup must be an absolute {STATIC_BACKUP_NAME} path")
    with kandev_db() as database:
        rows = database.execute(
            """
            SELECT local_path
            FROM repositories
            WHERE workspace_id = ? AND deleted_at IS NULL
            """,
            (workspace_id,),
        ).fetchall()
    for row in rows:
        registered = container_path_for_host(str(row["local_path"] or ""))
        if registered is None or requested != registered / STATIC_BACKUP_NAME:
            continue
        host_root = translate_to_host_lexical(registered)
        host_source = translate_to_host_lexical(requested)
        try:
            root_stat = os.lstat(host_root)
            source_stat = os.lstat(host_source)
        except OSError as exc:
            raise BrokerError(f"static backup is unavailable: {exc}") from exc
        if stat.S_ISLNK(root_stat.st_mode) or not stat.S_ISDIR(root_stat.st_mode):
            raise BrokerError("registered static backup root is not a real directory")
        if stat.S_ISLNK(source_stat.st_mode) or not stat.S_ISREG(source_stat.st_mode):
            raise BrokerError("static backup must be a regular non-symlink file")
        if source_stat.st_size > MAX_STATIC_BACKUP:
            raise BrokerError("static backup exceeds the configured size limit")
        return host_source, str(requested)
    raise BrokerError("static backup is not allow-listed for this coordinator workspace")


def copy_static_backup(source: Path, destination: Path) -> tuple[int, str]:
    """Copy a validated backup without following links or exposing its content."""
    descriptor = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    temporary_path: Path | None = None
    try:
        initial = os.fstat(descriptor)
        if not stat.S_ISREG(initial.st_mode) or initial.st_size > MAX_STATIC_BACKUP:
            raise BrokerError("static backup is not a permitted regular file")
        temporary = tempfile.NamedTemporaryFile(
            mode="wb", prefix=f".{destination.name}.", dir=destination.parent, delete=False
        )
        temporary_path = Path(temporary.name)
        digest = hashlib.sha256()
        total = 0
        with temporary, os.fdopen(descriptor, "rb", closefd=False) as stream:
            while True:
                chunk = stream.read(1024 * 1024)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_STATIC_BACKUP:
                    raise BrokerError("static backup exceeds the configured size limit")
                digest.update(chunk)
                temporary.write(chunk)
        final = os.fstat(descriptor)
        if (final.st_dev, final.st_ino, final.st_size, final.st_mtime_ns) != (
            initial.st_dev,
            initial.st_ino,
            initial.st_size,
            initial.st_mtime_ns,
        ):
            raise BrokerError("static backup changed while being copied")
        os.link(temporary_path, destination)
        destination.chmod(0o600)
        return total, digest.hexdigest()
    finally:
        os.close(descriptor)
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def container_environment(info: dict[str, Any]) -> dict[str, str]:
    environment: dict[str, str] = {}
    for item in (info.get("Config") or {}).get("Env") or []:
        key, separator, value = str(item).partition("=")
        if separator:
            environment[key] = value
    return environment


def database_export_command(info: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
    environment = container_environment(info)
    image = str((info.get("Config") or {}).get("Image") or "").lower()
    networks = (info.get("NetworkSettings") or {}).get("Networks") or {}
    addresses = sorted(
        str(network.get("IPAddress") or "")
        for network in networks.values()
        if network.get("IPAddress")
    )
    if not addresses:
        raise BrokerError("source database has no broker-reachable container address")
    host = addresses[0]

    if "mariadb" in image or "mysql" in image or any(
        key in environment for key in ("MARIADB_DATABASE", "MYSQL_DATABASE")
    ):
        database = environment.get("MARIADB_DATABASE") or environment.get("MYSQL_DATABASE")
        user = environment.get("MARIADB_USER") or environment.get("MYSQL_USER")
        password = environment.get("MARIADB_PASSWORD") or environment.get("MYSQL_PASSWORD")
        if not user or not password:
            user = "root"
            password = environment.get("MARIADB_ROOT_PASSWORD") or environment.get(
                "MYSQL_ROOT_PASSWORD"
            )
        if not database or not user or not password:
            raise BrokerError("source MariaDB lacks an exportable database credential set")
        return (
            [
                "/usr/bin/mariadb-dump",
                "--host",
                host,
                "--port",
                "3306",
                "--user",
                user,
                "--single-transaction",
                "--quick",
                "--skip-lock-tables",
                "--hex-blob",
                database,
            ],
            {"MYSQL_PWD": password},
        )

    if "postgres" in image or "POSTGRES_DB" in environment:
        database = environment.get("POSTGRES_DB") or environment.get("POSTGRES_USER")
        user = environment.get("POSTGRES_USER")
        password = environment.get("POSTGRES_PASSWORD")
        if not database or not user or not password:
            raise BrokerError("source PostgreSQL lacks an exportable database credential set")
        return (
            [
                "/usr/bin/pg_dump",
                "--host",
                host,
                "--port",
                "5432",
                "--username",
                user,
                "--dbname",
                database,
                "--no-owner",
                "--no-privileges",
            ],
            {"PGPASSWORD": password},
        )
    raise BrokerError("source container is not a supported MariaDB/MySQL/PostgreSQL database")


def run_bounded_export(
    args: list[str], environment_overrides: dict[str, str], destination: Path
) -> tuple[int, str, int, str]:
    process_environment = clean_environment()
    process_environment.update(environment_overrides)
    temporary = tempfile.NamedTemporaryFile(
        mode="wb", prefix=f".{destination.name}.", dir=destination.parent, delete=False
    )
    temporary_path = Path(temporary.name)
    total = 0
    digest = hashlib.sha256()
    stderr_chunks: list[bytes] = []
    deadline = time.monotonic() + COMMAND_TIMEOUT
    process: subprocess.Popen[bytes] | None = None
    selector: selectors.BaseSelector | None = None
    try:
        process = subprocess.Popen(
            args,
            cwd="/tmp",
            env=process_environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        assert process.stdout is not None and process.stderr is not None
        selector = selectors.DefaultSelector()
        selector.register(process.stdout, selectors.EVENT_READ, "stdout")
        selector.register(process.stderr, selectors.EVENT_READ, "stderr")
        with temporary:
            while selector.get_map():
                if time.monotonic() >= deadline:
                    process.kill()
                    raise BrokerError("database export timed out")
                events = selector.select(timeout=0.25)
                if not events and process.poll() is not None:
                    events = [(key, selectors.EVENT_READ) for key in selector.get_map().values()]
                for key, _ in events:
                    chunk = os.read(key.fileobj.fileno(), 1024 * 1024)
                    if not chunk:
                        selector.unregister(key.fileobj)
                        continue
                    if key.data == "stdout":
                        total += len(chunk)
                        if total > MAX_EXPORT:
                            process.kill()
                            raise BrokerError("database export exceeded the configured size limit")
                        digest.update(chunk)
                        temporary.write(chunk)
                    elif sum(len(item) for item in stderr_chunks) < MAX_OUTPUT:
                        stderr_chunks.append(chunk[: MAX_OUTPUT - sum(len(item) for item in stderr_chunks)])
        return_code = process.wait(timeout=5)
        stderr = b"".join(stderr_chunks).decode(errors="replace")
        if return_code != 0:
            return return_code, stderr, total, digest.hexdigest()
        os.link(temporary_path, destination)
        destination.chmod(0o600)
        return return_code, stderr, total, digest.hexdigest()
    finally:
        if selector is not None:
            selector.close()
        if process is not None and process.poll() is None:
            process.kill()
            process.wait()
        temporary_path.unlink(missing_ok=True)


def source_help() -> str:
    return (
        "Coordinator source commands:\n"
        "  docker kandev source artifact-discover <repository-UUID> <artifact-key>\n"
        "  docker kandev source artifact-deliver <repository-UUID> <artifact-key> --target-task <UUID>\n"
        "  docker kandev source artifact-receipt <delivery-UUID>\n"
        "  docker kandev artifact-ack <delivery-UUID> RECEIVED|CONSUMED|FAILED <sha256>\n"
        "  docker kandev source list\n"
        "  docker kandev source inspect <container>\n"
        "  docker kandev source logs <container> [--tail N] [--since 30m]\n"
        "  docker kandev source db-dump <container> --target-task <UUID> [--name dump.sql]\n"
        "  docker kandev source static-backup /data/home/Code/<repo>/last_db.sql --target-task <UUID> --name backup.sql\n"
    )


def workspace_help() -> str:
    return (
        "Coordinator workspace commands:\n"
        "  docker kandev workspace probe <task-uuid>\n"
        "  docker kandev workspace description-update <file>\n"
    )


def support_help() -> str:
    return (
        "Kandev Support commands (validated coordinators only):\n"
        "  docker kandev support send <request.json>\n"
        "  docker kandev support status <request-id>\n"
        "  docker kandev support receive <request-id>\n"
    )


def support_request_file(context: dict[str, str], task_root: Path, file_name: str) -> dict[str, Any]:
    source = resolve_inside(file_name, task_root, task_root)
    if not source.is_file() or source.is_symlink() or source.stat().st_size > 128 * 1024:
        raise BrokerError("support request must be a regular JSON file inside the coordinator task")
    try:
        supplied = json.loads(source.read_text(encoding="utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise BrokerError(f"support request is not valid UTF-8 JSON: {exc}") from exc
    required = ("problem", "evidence", "expected_outcome", "security_constraints")
    if not isinstance(supplied, dict) or any(
        not isinstance(supplied.get(field), str) or not supplied[field].strip()
        for field in required
    ):
        raise BrokerError("support request requires non-empty problem, evidence, expected_outcome, and security_constraints strings")
    request_id = str(uuid.uuid4())
    record = {
        "id": request_id,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "coordinator_task_id": context["task_id"],
        "workspace_id": context["workspace_id"],
        "workspace_name": context["workspace_name"],
        "worktree": str(task_root),
        **{field: supplied[field].strip() for field in required},
    }
    records = SUPPORT_QUEUE / "records"
    pending = SUPPORT_QUEUE / "pending"
    records.mkdir(parents=True, mode=0o700, exist_ok=True)
    pending.mkdir(parents=True, mode=0o700, exist_ok=True)
    record_path = records / f"{request_id}.json"
    temporary = records / f".{request_id}.tmp"
    temporary.write_text(json.dumps(record, indent=2), encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(record_path)
    pending_path = pending / f"{request_id}.json"
    pending_path.write_text(json.dumps(record), encoding="utf-8")
    pending_path.chmod(0o600)
    audit_source(context, "support-send", result="ok", request_id=request_id)
    return {"returncode": 0, "stdout": json.dumps({"request_id": request_id, "status": "queued"}, indent=2) + "\n", "stderr": ""}


def support_result(context: dict[str, str], request_id: str, receive: bool) -> dict[str, Any]:
    if not TASK_ID_RE.fullmatch(request_id):
        raise BrokerError("support request ID must be a full UUID")
    record_path = SUPPORT_QUEUE / "records" / f"{request_id}.json"
    if not record_path.is_file():
        raise BrokerError("support request is unavailable")
    record = json.loads(record_path.read_text(encoding="utf-8"))
    if record.get("coordinator_task_id") != context["task_id"] or record.get("workspace_id") != context["workspace_id"]:
        raise BrokerError("support request belongs to another coordinator/workspace")
    response_path = SUPPORT_QUEUE / "responses" / f"{request_id}.json"
    if not response_path.is_file():
        status = "processing" if (SUPPORT_QUEUE / "processing" / f"{request_id}.json").exists() else "queued"
        return {"returncode": 0, "stdout": json.dumps({"request_id": request_id, "status": status}, indent=2) + "\n", "stderr": ""}
    response = json.loads(response_path.read_text(encoding="utf-8"))
    audit_source(context, "support-receive" if receive else "support-status", result="ok", request_id=request_id)
    if receive:
        return {"returncode": int(response.get("returncode", 70)), "stdout": str(response.get("stdout", "")), "stderr": str(response.get("stderr", ""))}
    result = {
        "request_id": request_id,
        "status": "complete",
        "returncode": response.get("returncode", 70),
    }
    if response.get("resolution_status"):
        result["resolution_status"] = response["resolution_status"]
    return {"returncode": 0, "stdout": json.dumps(result, indent=2) + "\n", "stderr": ""}


def handle_coordinator_support(task_root: Path, args: list[str]) -> dict[str, Any]:
    context = coordinator_context(task_root)
    operation_args = args[2:]
    if not operation_args or operation_args == ["help"]:
        return {"returncode": 0, "stdout": support_help(), "stderr": ""}
    if operation_args[0] == "send" and len(operation_args) == 2:
        return support_request_file(context, task_root, operation_args[1])
    if operation_args[0] in {"status", "receive"} and len(operation_args) == 2:
        return support_result(context, operation_args[1], operation_args[0] == "receive")
    raise BrokerError(f"unsupported support operation\n{support_help()}")


@contextmanager
def temporary_operator_token():
    """Mint a five-minute PAT inside the broker and revoke it after one request.

    The credential never crosses the broker socket. Authorization remains
    coordinator/task-scoped in this process; the backend API performs the task
    mutation so normal events and UI refreshes are preserved.
    """
    if not KANDEV_DB.is_file():
        raise BrokerError("Kandev task metadata is unavailable")
    prefix = secrets.token_hex(4)
    token = f"kandev_pat_{prefix}_{secrets.token_urlsafe(32)}"
    token_hash = hashlib.sha256(token.encode()).hexdigest()
    token_id = str(uuid.uuid4())
    now = datetime.now(timezone.utc)
    expires = now.timestamp() + 300
    database = sqlite3.connect(KANDEV_DB, timeout=30)
    try:
        database.execute("PRAGMA busy_timeout = 30000")
        user = database.execute(
            "SELECT id FROM users WHERE role='admin' AND status='active' "
            "ORDER BY created_at, id LIMIT 1"
        ).fetchone()
        if user is None:
            raise BrokerError("no active Kandev administrator is available for API mutation")
        database.execute(
            "INSERT INTO auth_api_tokens "
            "(id,user_id,name,prefix,token_sha256,created_at,expires_at) "
            "VALUES (?,?,?,?,?,?,datetime(?,'unixepoch'))",
            (token_id, user[0], "coordinator-description-broker", prefix, token_hash,
             now.isoformat(), expires),
        )
        database.commit()
        yield token
    finally:
        try:
            database.execute("DELETE FROM auth_api_tokens WHERE id=?", (token_id,))
            database.commit()
        finally:
            database.close()


def backend_json(method: str, path: str, token: str, payload: dict[str, Any] | None = None) -> Any:
    data = None if payload is None else json.dumps(payload).encode()
    request = urllib.request.Request(
        f"http://127.0.0.1:38429{path}",
        data=data,
        method=method,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read())
    except (urllib.error.URLError, json.JSONDecodeError) as exc:
        raise BrokerError(f"Kandev API request failed: {exc}") from exc


def coordinator_description_update(
    context: dict[str, str], task_root: Path, file_name: str
) -> dict[str, Any]:
    source = resolve_inside(file_name, task_root, task_root)
    if not source.is_file() or source.is_symlink():
        raise BrokerError("description source must be a regular non-symlink file")
    size = source.stat().st_size
    if size > MAX_DESCRIPTION_BYTES:
        raise BrokerError(f"description source exceeds {MAX_DESCRIPTION_BYTES} bytes")
    try:
        description = source.read_text(encoding="utf-8").strip()
    except UnicodeDecodeError as exc:
        raise BrokerError("description source must be UTF-8 text") from exc
    new_sha = hashlib.sha256(description.encode()).hexdigest()
    audit_source(
        context, "description-update", result="attempt", source=str(source),
        bytes=len(description.encode()), sha256=new_sha,
    )
    with temporary_operator_token() as token:
        current = backend_json("GET", f"/api/v1/tasks/{context['task_id']}", token)
        old_description = str(current.get("description") or "")
        old_sha = hashlib.sha256(old_description.encode()).hexdigest()
        if old_description != description:
            updated = backend_json(
                "PATCH", f"/api/v1/tasks/{context['task_id']}", token,
                {"description": description},
            )
            if str(updated.get("description") or "") != description:
                raise BrokerError("Kandev API did not persist the exact description")
    audit_source(
        context, "description-update", result="ok", source=str(source),
        bytes=len(description.encode()), old_sha256=old_sha, sha256=new_sha,
    )
    return {
        "returncode": 0,
        "stdout": json.dumps({
            "task_id": context["task_id"], "source": str(source),
            "bytes": len(description.encode()), "sha256": new_sha,
            "changed": old_sha != new_sha,
        }, indent=2) + "\n",
        "stderr": "",
    }


def workspace_task_probe(context: dict[str, str], target_task_id: str) -> dict[str, Any]:
    """Run a fresh guard-rooted writability probe for one same-workspace task."""
    if not TASK_ID_RE.fullmatch(target_task_id):
        raise BrokerError("target task ID must be a full UUID")
    with kandev_db() as database:
        row = database.execute(
            """
            SELECT te.task_dir_name, te.workspace_path
            FROM tasks t
            JOIN task_environments te ON te.task_id = t.id
            WHERE t.id = ? AND t.workspace_id = ? AND t.archived_at IS NULL
              AND te.task_dir_name <> ''
            ORDER BY te.updated_at DESC
            LIMIT 1
            """,
            (target_task_id, context["workspace_id"]),
        ).fetchone()
    if row is None:
        raise BrokerError("target task has no active task-scoped workspace")
    task_dir_name = str(row["task_dir_name"])
    if not TASK_DIR_RE.fullmatch(task_dir_name):
        raise BrokerError("target task has an invalid task directory")
    task_root = (Path("/data/tasks") / task_dir_name).resolve(strict=True)
    if task_root.parent != Path("/data/tasks"):
        raise BrokerError("target task root escapes the managed task directory")

    workspace_path = Path(str(row["workspace_path"] or ""))
    try:
        probe_cwd = workspace_path.resolve(strict=True)
    except OSError:
        probe_cwd = task_root
    if not is_within(probe_cwd, task_root):
        probe_cwd = task_root
    if not (probe_cwd / ".git").exists():
        candidates = sorted(
            path for path in task_root.iterdir() if path.is_dir() and (path / ".git").exists()
        )
        if candidates:
            probe_cwd = candidates[0]

    script = r"""
set -eu
task_root=$1
printf 'task_root=%s\n' "$task_root"
printf 'task_mount=%s\n' "$(findmnt -T "$task_root" -n -o OPTIONS)"
probe=$(mktemp "$task_root/.kandev-workspace-probe.XXXXXX")
rm -f "$probe"
echo 'task_write=ok'
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    repo=$(git rev-parse --show-toplevel)
    common=$(git rev-parse --git-common-dir)
    gitdir=$(git rev-parse --git-dir)
    printf 'repository=%s\n' "$repo"
    printf 'repository_mount=%s\n' "$(findmnt -T "$repo" -n -o OPTIONS)"
    printf 'git_common=%s\n' "$common"
    printf 'git_common_mount=%s\n' "$(findmnt -T "$common" -n -o OPTIONS)"
    printf 'git_dir=%s\n' "$gitdir"
    printf 'git_dir_mount=%s\n' "$(findmnt -T "$gitdir" -n -o OPTIONS)"
    git add -A --dry-run >/dev/null
    echo 'git_add_dry_run=ok'
fi
"""
    audit_source(context, "workspace-probe", target_task_id=target_task_id, result="attempt")
    code, stdout, stderr = run_command(
        [GUARD_BIN, "--", "sh", "-ceu", script, "sh", str(task_root)],
        probe_cwd,
        timeout=30,
    )
    audit_source(
        context,
        "workspace-probe",
        target_task_id=target_task_id,
        result="ok" if code == 0 else "error",
    )
    return {"returncode": code, "stdout": stdout, "stderr": stderr}


def handle_coordinator_workspace(task_root: Path, args: list[str]) -> dict[str, Any]:
    context = coordinator_context(task_root)
    operation_args = args[2:]
    if not operation_args or operation_args == ["help"]:
        audit_source(context, "workspace-help", result="ok")
        return {"returncode": 0, "stdout": workspace_help(), "stderr": ""}
    if operation_args[0] == "probe" and len(operation_args) == 2:
        return workspace_task_probe(context, operation_args[1])
    if operation_args[0] == "description-update" and len(operation_args) == 2:
        return coordinator_description_update(context, task_root, operation_args[1])
    raise BrokerError(f"unsupported coordinator workspace operation\n{workspace_help()}")


def handle_coordinator_source(
    task_root: Path, args: list[str]
) -> dict[str, Any]:
    context = coordinator_context(task_root)
    operation_args = args[2:]
    if not operation_args or operation_args in (["help"], ["--help"]):
        audit_source(context, "help", result="ok")
        return {"returncode": 0, "stdout": source_help(), "stderr": ""}
    operation = operation_args[0]
    # The attempt record survives validation/runtime failures; successful
    # operations append a result record with only non-secret metadata.
    audit_source(context, operation, result="attempt")

    if operation in {'artifact-discover', 'artifact-deliver', 'artifact-receipt'}:
        # Reuse the live platform eligibility checks without creating any task files.
        _, caller_root = artifact_task(context['workspace_id'], context['task_id'])
        if caller_root != task_root:
            raise BrokerError('artifact Coordinator binding is stale')
        if operation == 'artifact-discover' and len(operation_args) == 3:
            result, _ = artifact_discovery(context, operation_args[1], operation_args[2])
            audit_source(context, operation, result=result['status'], project_id=result['project_id'],
                         artifact=result['artifact'])
        elif (operation == 'artifact-deliver' and len(operation_args) == 5
              and operation_args[3] == '--target-task'):
            result = artifact_delivery(context, operation_args[1], operation_args[2], operation_args[4])
        elif operation == 'artifact-receipt' and len(operation_args) == 2:
            result = artifact_receipt(task_root, operation_args[1], context=context)
        else:
            raise BrokerError('invalid project artifact command contract')
        return {'returncode': 0, 'stdout': json.dumps(result, indent=2) + '\n', 'stderr': ''}

    if operation == "list" and len(operation_args) == 1:
        containers = list_workspace_containers(context["workspace_id"])
        audit_source(context, operation, result="ok", count=len(containers))
        return {
            "returncode": 0,
            "stdout": json.dumps(
                {"workspace": context["workspace_name"], "containers": containers}, indent=2
            )
            + "\n",
            "stderr": "",
        }

    if operation == "inspect" and len(operation_args) == 2:
        name = operation_args[1]
        info = require_workspace_container(name, context["workspace_id"])
        audit_source(context, operation, source=name, result="ok")
        return {
            "returncode": 0,
            "stdout": json.dumps(container_summary(info), indent=2) + "\n",
            "stderr": "",
        }

    if operation == "logs" and len(operation_args) >= 2:
        name = operation_args[1]
        tail = 200
        since = "30m"
        index = 2
        while index < len(operation_args):
            option = operation_args[index]
            if option not in {"--tail", "--since"} or index + 1 >= len(operation_args):
                raise BrokerError(f"unsupported source logs option: {option}")
            value = operation_args[index + 1]
            if option == "--tail":
                if not value.isdigit() or not 1 <= int(value) <= MAX_LOG_LINES:
                    raise BrokerError(f"source log tail must be between 1 and {MAX_LOG_LINES}")
                tail = int(value)
            elif not re.fullmatch(r"[1-9][0-9]*[smhd]", value):
                raise BrokerError("source log --since must be a duration such as 30m or 2h")
            else:
                since = value
            index += 2
        require_workspace_container(name, context["workspace_id"])
        code, stdout, stderr = run_command(
            [DOCKER_BIN, "logs", "--tail", str(tail), "--since", since, name],
            Path("/tmp"),
            timeout=60,
        )
        audit_source(context, operation, source=name, result="ok" if code == 0 else "error")
        return {
            "returncode": code,
            "stdout": redact_logs(stdout),
            "stderr": redact_logs(stderr),
        }

    if operation == "db-dump" and len(operation_args) >= 2:
        name = operation_args[1]
        target_task_id = ""
        output_name = ""
        index = 2
        while index < len(operation_args):
            option = operation_args[index]
            if option not in {"--target-task", "--name"} or index + 1 >= len(operation_args):
                raise BrokerError(f"unsupported source db-dump option: {option}")
            value = operation_args[index + 1]
            if option == "--target-task":
                target_task_id = value
            else:
                output_name = value
            index += 2
        if not target_task_id:
            raise BrokerError("source db-dump requires --target-task <UUID>")
        if not output_name:
            timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            output_name = f"{name}-{timestamp}.sql"
        info = require_workspace_container(name, context["workspace_id"])
        if str((info.get("State") or {}).get("Status")) != "running":
            raise BrokerError("source database container is not running")
        destination, container_destination = target_task_inbox(
            target_task_id, context["workspace_id"], output_name
        )
        command, environment = database_export_command(info)
        with EXPORT_LOCK:
            code, stderr, size, checksum = run_bounded_export(
                command, environment, destination
            )
        if code != 0:
            destination.unlink(missing_ok=True)
            audit_source(
                context,
                operation,
                source=name,
                target_task_id=target_task_id,
                result="error",
            )
            raise BrokerError(f"logical database export failed: {redact_logs(stderr)}")
        audit_source(
            context,
            operation,
            source=name,
            target_task_id=target_task_id,
            output=container_destination,
            bytes=size,
            sha256=checksum,
            result="ok",
        )
        return {
            "returncode": 0,
            "stdout": json.dumps(
                {
                    "source": name,
                    "target_task_id": target_task_id,
                    "path": container_destination,
                    "bytes": size,
                    "sha256": checksum,
                },
                indent=2,
            )
            + "\n",
            "stderr": "",
        }

    if operation == "static-backup" and len(operation_args) >= 2:
        source_path = operation_args[1]
        target_task_id = ""
        output_name = ""
        index = 2
        while index < len(operation_args):
            option = operation_args[index]
            if option not in {"--target-task", "--name"} or index + 1 >= len(operation_args):
                raise BrokerError(f"unsupported source static-backup option: {option}")
            value = operation_args[index + 1]
            if option == "--target-task":
                target_task_id = value
            else:
                output_name = value
            index += 2
        if not target_task_id or not output_name:
            raise BrokerError("source static-backup requires --target-task <UUID> and --name <backup.sql>")
        if not output_name.endswith(".sql"):
            raise BrokerError("static backup output name must end in .sql")
        source, container_source = registered_static_backup(source_path, context["workspace_id"])
        destination, container_destination = target_task_inbox(
            target_task_id, context["workspace_id"], output_name
        )
        try:
            size, checksum = copy_static_backup(source, destination)
        except Exception:
            destination.unlink(missing_ok=True)
            raise
        audit_source(
            context,
            operation,
            source=container_source,
            target_task_id=target_task_id,
            output=container_destination,
            bytes=size,
            sha256=checksum,
            result="ok",
        )
        return {
            "returncode": 0,
            "stdout": json.dumps(
                {
                    "source": container_source,
                    "target_task_id": target_task_id,
                    "path": container_destination,
                    "bytes": size,
                    "sha256": checksum,
                },
                indent=2,
            )
            + "\n",
            "stderr": "",
        }

    raise BrokerError(f"unsupported coordinator source operation\n{source_help()}")


def compose_config(
    cwd: Path, project: str, global_args: list[str], environment_overrides: dict[str, str]
) -> dict[str, Any]:
    # Parse all agent-controlled Compose files inside the same Bubblewrap scope
    # as the agent. The broker never opens env/config/include files on the host.
    global_args, environment_overrides = compose_project_options(global_args, environment_overrides)
    # The requested name has already been mapped to this task/clone. Do not
    # let an ordinary project alias override that daemon-facing name.
    environment_overrides = {**environment_overrides, "COMPOSE_PROJECT_NAME": project}
    args = [
        GUARD_BIN,
        "--",
        COMPOSE_PLUGIN,
        "--project-name",
        project,
        *global_args,
        "config",
        "--format",
        "json",
    ]
    code, stdout, stderr = run_command(args, cwd, environment_overrides=environment_overrides)
    if code != 0:
        raise BrokerError(f"Docker Compose configuration failed:\n{stderr or stdout}")
    try:
        return json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise BrokerError("Docker Compose returned an invalid configuration model") from exc


def render_model_for_command(
    task_root: Path, cwd: Path, project_directory: Path, host_root: Path,
    project: str, global_args: list[str], command: str, command_args: list[str],
    environment: dict[str, str],
) -> dict[str, Any]:
    """Authorize the model named by this invocation, then save it for existing commands."""
    initial = compose_config(cwd, project, global_args, environment)
    model = validate_model(initial, cwd, task_root, host_root, project)
    require_isolated_recreate(model, command, command_args)
    save_scoped_model(task_root, project_directory, project, model)
    return model


def compose_project_options(
    args: list[str], environment: dict[str, str]
) -> tuple[list[str], dict[str, str]]:
    filtered = []
    environment = dict(environment)
    index = 0
    while index < len(args):
        option, separator, value = args[index].partition("=")
        if option in {"-p", "--project-name"}:
            if not separator:
                index += 1
                value = args[index]
            environment["COMPOSE_PROJECT_NAME"] = value
        elif option in COMPOSE_VALUE_OPTIONS and not separator:
            filtered.extend(args[index:index + 2])
            index += 1
        else:
            filtered.append(args[index])
        index += 1
    return filtered, compose_environment(environment)


def handle_git(
    task_root: Path, cwd: Path, args: list[str], request: dict[str, Any],
    stdin_stream: FramedInput | None,
) -> dict[str, Any]:
    """Run Git in a fresh task guard, picking up newly attached backlinks.

    Arbitrary Git flags, hooks and helpers execute inside Bubblewrap, never in
    the broker's trusted namespace. The guard validates every Git backlink and
    overlays sibling administration directories read-only on each invocation.
    """
    environment = request.get("git_environment", {})
    if not isinstance(environment, dict) or set(environment) - GIT_ENV_KEYS:
        raise BrokerError("invalid Git environment")
    if any(not isinstance(v, str) or len(v) > 65536 for v in environment.values()):
        raise BrokerError("invalid Git environment value")
    # Git may change its worktree with global flags. Validate them before
    # creating a fresh scope; a task must not nominate a source/sibling checkout.
    target = cwd
    index = 0
    while index < len(args) and args[index].startswith("-"):
        option, separator, value = args[index].partition("=")
        if option in {"-C", "--work-tree", "--git-dir"}:
            if not separator:
                index += 1
                if index >= len(args):
                    raise BrokerError("missing Git path option value")
                value = args[index]
            if option == "--git-dir":
                candidate = Path(value) if Path(value).is_absolute() else target / value
                candidate = candidate.resolve(strict=True)
                if not is_within(candidate, task_root):
                    backlink = candidate / "gitdir"
                    if not backlink.is_file():
                        raise BrokerError("Git metadata is outside this task")
                    marker = Path(backlink.read_text().strip())
                    if not marker.is_absolute():
                        marker = candidate / marker
                    marker = resolve_inside(str(marker), target, task_root)
                    if not marker.is_file() or marker.read_text().strip() != f"gitdir: {candidate}":
                        raise BrokerError("Git metadata backlink does not match this task")
            else:
                resolved = resolve_inside(value, target, task_root)
                if option == "-C":
                    target = resolved
        elif option in {"-c", "--config-env", "--namespace"} and not separator:
            index += 1
        index += 1
    code, stdout, stderr = run_command(
        [GUARD_BIN, "--", "/usr/bin/git", *args], cwd,
        environment_overrides=environment, stdin_stream=stdin_stream,
    )
    return {"returncode": code, "stdout": stdout, "stderr": stderr}


def handle_request(
    request: dict[str, Any], key: bytes, stdin_stream: FramedInput | None = None
) -> dict[str, Any]:
    task_root_raw = request.get("task_root")
    cwd_raw = request.get("cwd")
    args = request.get("args")
    token = request.get("token")
    environment_overrides = compose_environment(request.get("compose_environment"))
    if not isinstance(task_root_raw, str) or not isinstance(cwd_raw, str):
        raise BrokerError("missing task scope")
    if not isinstance(args, list) or not all(isinstance(item, str) for item in args):
        raise BrokerError("invalid Docker argument vector")
    if not isinstance(token, str):
        raise BrokerError("missing task token")

    task_root = Path(task_root_raw).resolve(strict=True)
    cwd = Path(cwd_raw).resolve(strict=True)
    if not is_within(cwd, task_root):
        raise BrokerError("working directory is outside this agent task")
    if not hmac.compare_digest(token, expected_token(key, task_root)):
        raise BrokerError("invalid task-scoped Docker token")

    if args[:2] == ["kandev", "git"]:
        return handle_git(task_root, cwd, args[2:], request, stdin_stream)

    if args[:2] == ['kandev', 'artifact-ack']:
        if len(args) != 5:
            raise BrokerError('artifact-ack requires delivery UUID, state, and SHA-256')
        result = artifact_receipt(task_root, args[2], args[3], args[4])
        return {'returncode': 0, 'stdout': json.dumps(result) + '\n', 'stderr': ''}
    if args[:2] == ["kandev", "source"]:
        return handle_coordinator_source(task_root, args)
    if args[:2] == ["kandev", "workspace"]:
        return handle_coordinator_workspace(task_root, args)
    if args[:2] == ["kandev", "support"]:
        return handle_coordinator_support(task_root, args)
    if args[:2] == ["kandev", "network"]:
        return handle_network_reserve(task_root, cwd, args, environment_overrides)
    if args[:2] == ["kandev", "oneoff"]:
        return handle_oneoff(task_root, cwd, args, environment_overrides)
    if args[:1] == ["scout"]:
        return handle_scout_cves(task_root, cwd, args, environment_overrides)
    if args[:1] != ["compose"]:
        operations = runpy.run_path(str(Path(__file__).with_name("kandev-agent-docker-operations.py")))
        return operations["handle"](SimpleNamespace(**globals()), task_root, cwd, args, stdin_stream)

    global_args, command, command_args = split_compose_args(args, cwd, task_root)
    global_args, environment_overrides = compose_project_options(global_args, environment_overrides)
    project_directory = compose_project_directory(cwd, task_root, global_args)
    host_root = translate_to_host(task_root)
    requested_project = environment_overrides.get("COMPOSE_PROJECT_NAME", project_name(task_root))
    try:
        project = scoped_project_name(task_root, environment_overrides, project_directory)
    except BrokerError as exc:
        if command not in DESTRUCTIVE_COMPOSE_COMMANDS:
            raise
        audit_id = str(uuid.uuid4())
        audit_compose(
            task_root, cwd, requested_project, "", command, "deny", "denied", audit_id=audit_id
        )
        raise ComposeAuditError(str(exc), audit_id, "") from exc
    # Compose's own interpolation must observe the same value that the broker
    # passes as --project-name.  This keeps labels/ports deterministic without
    # trusting any environment other than the existing narrow allow-list.
    environment_overrides = {**environment_overrides, "COMPOSE_PROJECT_NAME": project}
    if command == "version":
        code, stdout, stderr = run_command([DOCKER_BIN, "compose", "version", *command_args], cwd)
        return {"returncode": code, "stdout": stdout, "stderr": stderr, "project": project}

    audit_id: str | None = None
    if command in DESTRUCTIVE_COMPOSE_COMMANDS:
        sanitized_model, audit_id = destructive_model_preflight(
            task_root, project_directory, requested_project, project, command
        )
    elif command in SAFE_EXISTING_COMMANDS:
        # Existing/destructive commands must never create or refresh an
        # ownership record.  A sibling clone can only operate its own prior
        # model, not the registered main clone's project.
        sanitized_model = load_scoped_model(task_root, project_directory, project)
    else:
        # A prior config, build, or up may have saved a different model for the
        # project. Never substitute that model for this invocation's files.
        sanitized_model = render_model_for_command(
            task_root, cwd, project_directory, host_root, project, global_args,
            command, command_args, environment_overrides,
        )

    model_file: Path | None = None
    try:
        handle = tempfile.NamedTemporaryFile(
            mode="w", prefix=f"{project}-", suffix=".json", dir="/run/kandev-agent-docker", delete=False
        )
        with handle:
            json.dump(sanitized_model, handle)
        model_file = Path(handle.name)
        command_line = compose_replay_command(
            project, model_file, global_args, command, command_args
        )
        # The rendered model carries explicit ports, but Compose also resolves
        # interpolation while materializing/replaying it.  Preserve only the
        # broker's narrow allow-list for the execution phase; otherwise a
        # saved model rendered with DB_PORT/WEB_PORT can be recreated with
        # Docker's ephemeral published-port default.
        code, stdout, stderr = run_command(
            command_line, cwd, environment_overrides=environment_overrides,
            stdin_stream=stdin_stream,
            timeout=ONEOFF_RUN_TIMEOUT if command == "run" else COMMAND_TIMEOUT,
        )
        if command in DESTRUCTIVE_COMPOSE_COMMANDS:
            audit_compose(
                task_root, cwd, requested_project, project, command,
                "allow", "ok" if code == 0 else "error", audit_id=audit_id or "",
            )
        response = {"returncode": code, "stdout": stdout, "stderr": stderr, "project": project}
        if audit_id:
            response["audit_id"] = audit_id
            response["resolved_project"] = project
        return response
    finally:
        if model_file is not None:
            model_file.unlink(missing_ok=True)


class BrokerHandler(socketserver.StreamRequestHandler):
    def handle(self) -> None:
        line = self.rfile.readline(MAX_REQUEST + 1)
        if len(line) > MAX_REQUEST:
            response = {"returncode": 78, "stdout": "", "stderr": "Docker broker request is too large\n"}
        else:
            try:
                request = json.loads(line)
                response = handle_request(
                    request, self.server.broker_key, FramedInput(self.rfile)
                )  # type: ignore[attr-defined]
            except ComposeAuditError as exc:
                response = {
                    "returncode": 78,
                    "stdout": "",
                    "stderr": f"kandev-agent-docker: {exc}\n",
                    "audit_id": exc.audit_id,
                    "resolved_project": exc.project,
                }
            except (BrokerError, json.JSONDecodeError, OSError) as exc:
                response = {"returncode": 78, "stdout": "", "stderr": f"kandev-agent-docker: {exc}\n"}
            except Exception as exc:  # fail closed without killing the broker
                print(f"kandev-agent-docker-broker: internal error: {exc}", file=sys.stderr)
                response = {"returncode": 70, "stdout": "", "stderr": "kandev-agent-docker: internal broker error\n"}
        self.wfile.write(json.dumps(response).encode() + b"\n")


class ThreadedUnixServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True
    broker_key: bytes


def load_or_create_key() -> bytes:
    KEY_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not KEY_PATH.exists():
        KEY_PATH.write_text(secrets.token_hex(32))
        KEY_PATH.chmod(0o600)
    return KEY_PATH.read_text().strip().encode()


def main() -> int:
    key = load_or_create_key()
    SOCKET_PATH.unlink(missing_ok=True)
    server = ThreadedUnixServer(str(SOCKET_PATH), BrokerHandler)
    server.broker_key = key
    SOCKET_PATH.chmod(0o600)
    print(f"kandev-agent-docker-broker: listening on {SOCKET_PATH}", file=sys.stderr)
    try:
        server.serve_forever()
    finally:
        server.server_close()
        SOCKET_PATH.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
