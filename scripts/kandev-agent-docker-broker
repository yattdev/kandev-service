    "top",
    "unpause",
    "version",
    "wait",
}
# These commands can delete or disrupt resources which were created by a
# previous Compose invocation.  They must be tied to the exact saved model
# owner before the broker even asks Compose to parse current input.
DESTRUCTIVE_COMPOSE_COMMANDS = {"down", "kill", "pause", "restart", "rm", "stop", "unpause"}
FORBIDDEN_RUN_OPTIONS = {
    "-v",
    "--volume",
    "--privileged",
    "--cap-add",
    "--device",
    "--network",
    "--pid",
    "--ipc",
    "--uts",
    "--security-opt",
}


class BrokerError(RuntimeError):
    pass


class ComposeAuditError(BrokerError):
    """A denied destructive request whose durable correlation ID is safe to show."""

    def __init__(self, message: str, audit_id: str, project: str):
        super().__init__(message)
        self.audit_id = audit_id
        self.project = project


def is_within(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def resolve_inside(value: str, cwd: Path, root: Path, *, must_exist: bool = True) -> Path:
    candidate = Path(value)
    if not candidate.is_absolute():
        candidate = cwd / candidate
    try:
        resolved = candidate.resolve(strict=must_exist)
    except OSError as exc:
        raise BrokerError(f"path is unavailable: {value}: {exc}") from exc
    if not is_within(resolved, root):
        raise BrokerError(f"path is outside this agent task: {value}")
    return resolved


def translate_to_host(path: Path) -> Path:
    mappings = [
        (Path("/data/home/Code"), os.environ.get("KANDEV_HOST_CODE_DIR", "")),
        (Path("/data"), os.environ.get("KANDEV_HOST_DATA_DIR", "")),
    ]
    host_code = os.environ.get("KANDEV_HOST_CODE_DIR", "")
    if host_code:
        mappings.insert(0, (Path(host_code), host_code))
    for source, destination in mappings:
        if not destination:
            continue
        try:
            relative = path.relative_to(source)
        except ValueError:
            continue
        return (Path(destination) / relative).resolve(strict=True)
    raise BrokerError(f"task path has no configured host mapping: {path}")


def translate_to_host_lexical(path: Path) -> Path:
    """Map a container path without resolving symlinks.

    Static-backup delivery must reject symlink traversal, so resolving before
    validation would hide a malicious source or registered-root symlink.
    """
    mappings = [
        (Path("/data/home/Code"), os.environ.get("KANDEV_HOST_CODE_DIR", "")),
        (Path("/data"), os.environ.get("KANDEV_HOST_DATA_DIR", "")),
    ]
    host_code = os.environ.get("KANDEV_HOST_CODE_DIR", "")
    if host_code:
        mappings.insert(0, (Path(host_code), host_code))
    for source, destination in mappings:
        if not destination:
            continue
        try:
            relative = path.relative_to(source)
        except ValueError:
            continue
        return Path(destination) / relative
    raise BrokerError(f"task path has no configured host mapping: {path}")


def project_name(task_root: Path) -> str:
    digest = hashlib.sha256(str(task_root).encode()).hexdigest()[:16]
    return f"kd_{digest}"


def scoped_project_name(task_root: Path, environment: dict[str, str]) -> str:
    """Select a project without allowing a task to address a shared project.

    A task may opt into a distinct disposable project through the narrow
    COMPOSE_PROJECT_NAME transport.  Only broker-looking ``kd_`` names are
    accepted; ownership is then established by a saved model scoped to the
    exact task root and working clone below.
    """
    selected = environment.get("COMPOSE_PROJECT_NAME", project_name(task_root))
    if selected != project_name(task_root) and not selected.startswith("kd_"):
        raise BrokerError("explicit Compose project names must use the guarded kd_ prefix")
    return selected


def model_path(task_root: Path, project: str) -> Path:
    owner = hashlib.sha256(str(task_root).encode()).hexdigest()
    key = hashlib.sha256(project.encode()).hexdigest()
    return MODEL_DIR / owner / f"{key}.json"


def project_claim_path(project: str) -> Path:
    return MODEL_DIR / "projects" / f"{hashlib.sha256(project.encode()).hexdigest()}.json"


def project_owner(task_root: Path, cwd: Path, project: str) -> dict[str, str]:
    return {"task_root": str(task_root), "cwd": str(cwd), "project": project}


def claim_project(task_root: Path, cwd: Path, project: str, *, create: bool = True) -> None:
    """Atomically bind a guarded project to one task and one clone."""
    destination = project_claim_path(project)
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    expected = project_owner(task_root, cwd, project)
    try:
        current = json.loads(destination.read_text(encoding="utf-8"))
    except FileNotFoundError:
        if not create:
            raise BrokerError("no saved Compose model is authorized for this task project")
        temporary = destination.parent / f".{destination.name}.{threading.get_ident()}"
        try:
            temporary.write_text(json.dumps(expected), encoding="utf-8")
            os.chmod(temporary, 0o600)
            try:
                os.link(temporary, destination)
            except FileExistsError:
                pass
        finally:
            temporary.unlink(missing_ok=True)
        try:
            current = json.loads(destination.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exc:
            raise BrokerError("cannot establish guarded Compose project ownership") from exc
    except (OSError, json.JSONDecodeError) as exc:
        raise BrokerError("guarded Compose project ownership is unreadable") from exc
    if current != expected:
        raise BrokerError("Compose project is already owned by a different task clone")


def save_scoped_model(task_root: Path, cwd: Path, project: str, model: dict[str, Any]) -> None:
    """Persist a Compose model with immutable task and clone ownership data."""
    claim_project(task_root, cwd, project)
    destination = model_path(task_root, project)
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = destination.parent / f".{destination.name}.{threading.get_ident()}"
    payload = {
        "version": 1,
        "task_root": str(task_root),
        "cwd": str(cwd),
        "project": project,
        "model": model,
    }
    try:
        temporary.write_text(json.dumps(payload), encoding="utf-8")
        os.chmod(temporary, 0o600)
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def load_scoped_model(task_root: Path, cwd: Path, project: str) -> dict[str, Any]:
    """Load only a model established by this task from this exact clone."""
    # Check the global claim before the task-local model: otherwise a second
    # task could create a same-named project and collide at the Docker daemon.
    claim_project(task_root, cwd, project, create=False)
    source = model_path(task_root, project)
    try:
        saved = json.loads(source.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise BrokerError("no saved Compose model is authorized for this task project") from exc
    if not isinstance(saved, dict) or (
        saved.get("version") != 1
        or saved.get("task_root") != str(task_root)
        or saved.get("cwd") != str(cwd)
        or saved.get("project") != project
        or not isinstance(saved.get("model"), dict)
    ):
        raise BrokerError("saved Compose model ownership does not match this task clone")
    return saved["model"]


def audit_compose(
    task_root: Path,
    cwd: Path,
    requested_project: str,
    resolved_project: str,
    command: str,
    ownership_decision: str,
    result: str,
    *,
    audit_id: str,
) -> None:
    """Durably record a destructive decision without command arguments or env."""
    event = {
        "audit_id": audit_id,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "command_class": "destructive",
        "requested_project": requested_project,
        "resolved_project": resolved_project,
        "canonical_project_directory": str(cwd),
        "authenticated_task_scope": str(task_root),
        "command": command,
        "ownership_decision": ownership_decision,
        "result": result,
    }
    try:
        COMPOSE_AUDIT_LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with AUDIT_LOCK, COMPOSE_AUDIT_LOG.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
    except OSError as exc:
        raise BrokerError(f"cannot record Compose destructive-command audit event: {exc}") from exc


def destructive_model_preflight(
    task_root: Path, cwd: Path, requested_project: str, resolved_project: str, command: str
) -> tuple[dict[str, Any], str]:
    """Flush an allow/deny ownership decision before invoking Docker."""
    audit_id = str(uuid.uuid4())
    try:
        model = load_scoped_model(task_root, cwd, resolved_project)
    except BrokerError as exc:
        # The denial itself is part of the security boundary.  If it cannot be
        # persisted, audit_compose raises and the caller fails closed without
        # receiving a misleading correlation ID.
        audit_compose(
            task_root, cwd, requested_project, resolved_project, command,
            "deny", "denied", audit_id=audit_id,
        )
        raise ComposeAuditError(str(exc), audit_id, resolved_project) from exc
    audit_compose(
        task_root, cwd, requested_project, resolved_project, command,
        "allow", "preflight", audit_id=audit_id,
    )
    return model, audit_id


def expected_token(key: bytes, task_root: Path) -> str:
    return hmac.new(key, str(task_root).encode(), hashlib.sha256).hexdigest()


def split_compose_args(args: list[str], cwd: Path, task_root: Path) -> tuple[list[str], str, list[str]]:
    if not args or args[0] != "compose":
        raise BrokerError("guarded Docker access supports 'docker compose' only")

    global_args: list[str] = []
    index = 1
    while index < len(args):
        arg = args[index]
        if not arg.startswith("-"):
            break
        if arg in {"-p", "--project-name"} or arg.startswith("--project-name="):
            raise BrokerError("Compose project names are assigned per Kandev task")
        if arg in COMPOSE_FLAG_OPTIONS:
            global_args.append(arg)
            index += 1
            continue
        option = arg.split("=", 1)[0]
        if option not in COMPOSE_VALUE_OPTIONS:
            raise BrokerError(f"unsupported Compose global option: {arg}")
        if "=" in arg:
            value = arg.split("=", 1)[1]
            if option in PATH_OPTIONS:
                if value == "-":
                    raise BrokerError("Compose files from stdin are not supported")
                resolve_inside(value, cwd, task_root)
            global_args.append(arg)
            index += 1
            continue
        if index + 1 >= len(args):
            raise BrokerError(f"missing value for Compose option: {arg}")
        value = args[index + 1]
        if option in PATH_OPTIONS:
            if value == "-":
                raise BrokerError("Compose files from stdin are not supported")
            resolve_inside(value, cwd, task_root)
        global_args.extend((arg, value))
        index += 2

    if index >= len(args):
        raise BrokerError("a Docker Compose subcommand is required")
    command = args[index]
    command_args = args[index + 1 :]
    if command not in MODEL_COMMANDS | SAFE_EXISTING_COMMANDS:
        raise BrokerError(f"Docker Compose subcommand is not permitted for agents: {command}")
    if command == "run":
        for arg in command_args:
            option = arg.split("=", 1)[0]
            if option in FORBIDDEN_RUN_OPTIONS or arg.startswith("-v") or option in {
                "--env-file",
                "--env-from-file",
                "--name",
            }:
                raise BrokerError(f"Compose run option is not permitted: {arg}")
    if command == "exec" and any(arg in {"--privileged"} for arg in command_args):
        raise BrokerError("privileged Compose exec is not permitted")
    if command == "build":
        for arg in command_args:
            if arg.split("=", 1)[0] in {"--ssh", "--secret", "--builder"}:
                raise BrokerError(f"Compose build option is not permitted: {arg}")
    if command == "down":
        for arg in command_args:
            if arg == "--rmi" or arg.startswith("--rmi="):
                raise BrokerError("Compose down may not remove shared host images")
    if command == "config":
        for arg in command_args:
            if arg in {"-o", "--output"} or arg.startswith("--output="):
                raise BrokerError("Compose config output files are not permitted")
    return global_args, command, command_args


def scoped_path_to_host(value: str, cwd: Path, task_root: Path, host_root: Path) -> Path:
    scoped = resolve_inside(value, cwd, task_root)
    host_path = translate_to_host(scoped)
    if not is_within(host_path, host_root):
        raise BrokerError(f"Compose source is outside this task: {value}")
    return host_path


def validate_named_resources(model: dict[str, Any], project: str) -> None:
    for section in ("volumes", "networks", "configs", "secrets"):
        resources = model.get(section) or {}
        if not isinstance(resources, dict):
            raise BrokerError(f"invalid Compose {section} section")
        for logical_name, config in resources.items():
            if config is None:
                continue
            if not isinstance(config, dict):
                raise BrokerError(f"invalid Compose {section} resource: {logical_name}")
            if config.get("external"):
                raise BrokerError(f"external Compose {section} are not permitted: {logical_name}")
            actual_name = config.get("name")
            if actual_name and not str(actual_name).startswith(f"{project}_"):
                raise BrokerError(
                    f"explicit Compose {section} name escapes the task project: {actual_name}"
                )


def validate_model(
    model: dict[str, Any], cwd: Path, task_root: Path, host_root: Path, project: str
) -> dict[str, Any]:
    sanitized = copy.deepcopy(model)
    sanitized["name"] = project
    validate_named_resources(sanitized, project)
    services = sanitized.get("services")
    if not isinstance(services, dict) or not services:
        raise BrokerError("Compose model has no services")

    for service_name, service in services.items():
        if not isinstance(service, dict):
            raise BrokerError(f"invalid Compose service: {service_name}")
        for key in (
            "privileged",
            "cap_add",
            "devices",
            "device_cgroup_rules",
            "volumes_from",
            "external_links",
            "credential_spec",
        ):
            if service.get(key):
                raise BrokerError(f"Compose service {service_name} uses forbidden setting: {key}")
        for key in ("pid", "ipc", "uts", "cgroup", "userns_mode"):
            if service.get(key):
                raise BrokerError(f"Compose service {service_name} may not select {key}")
        network_mode = str(service.get("network_mode") or "")
        if network_mode == "host" or network_mode.startswith("container:"):
            raise BrokerError(f"Compose service {service_name} uses forbidden network_mode")
        for option in service.get("security_opt") or []:
            if str(option) not in {"no-new-privileges", "no-new-privileges:true"}:
                raise BrokerError(f"Compose service {service_name} uses forbidden security_opt: {option}")
        labels = service.get("labels") or {}
        label_names = labels.keys() if isinstance(labels, dict) else (str(item).split("=", 1)[0] for item in labels)
        if any(str(name).startswith("com.docker.compose.") for name in label_names):
            raise BrokerError(f"Compose service {service_name} overrides reserved project labels")

        build = service.get("build")
        if isinstance(build, str):
            service["build"] = str(scoped_path_to_host(build, cwd, task_root, host_root))
            service["image"] = f"{project}_{service_name}:latest"
        elif isinstance(build, dict):
            context = build.get("context")
            remote_context = context and str(context).startswith(
                ("docker-image://", "git://", "http://", "https://", "ssh://")
            )
            context_inside: Path | None = None
            if context and not remote_context:
                context_inside = resolve_inside(str(context), cwd, task_root)
                build["context"] = str(translate_to_host(context_inside))
            dockerfile = build.get("dockerfile")
            if dockerfile:
                if remote_context:
                    raise BrokerError(
                        f"Compose build for {service_name} may not select a Dockerfile "
                        "with a remote context"
                    )
                dockerfile_path = Path(str(dockerfile))
                if not dockerfile_path.is_absolute():
                    dockerfile_path = (context_inside or cwd) / dockerfile_path
                build["dockerfile"] = str(
                    scoped_path_to_host(str(dockerfile_path), cwd, task_root, host_root)
                )
            for key in (
                "additional_contexts",
                "cache_from",
                "cache_to",
                "entitlements",
                "output",
                "privileged",
                "secrets",
                "ssh",
                "tags",
            ):
                if build.get(key):
                    raise BrokerError(f"Compose build for {service_name} uses forbidden setting: {key}")
            # Never overwrite a host image tag that may belong to another task
            # or a production Compose project.
            service["image"] = f"{project}_{service_name}:latest"

        for mount in service.get("volumes") or []:
            if not isinstance(mount, dict):
                raise BrokerError(f"Compose service {service_name} has an invalid volume")
            source = mount.get("source")
            target = str(mount.get("target") or "")
            if "docker.sock" in target or target in {"/run", "/var/run"}:
                raise BrokerError(f"Compose service {service_name} attempts to expose a daemon path")
            if mount.get("type") == "bind":
                if not source:
                    raise BrokerError(f"Compose service {service_name} has a bind without a source")
                # A bind that resolves inside this task retains its declared
                # mode (Compose defaults to read-write). Test containers may
                # therefore modify the same worktree the agent can already
                # modify, while paths outside the task remain rejected.
                mount["source"] = str(scoped_path_to_host(str(source), cwd, task_root, host_root))

    for section in ("configs", "secrets"):
        for logical_name, config in (sanitized.get(section) or {}).items():
            if isinstance(config, dict) and config.get("file"):
                config["file"] = str(
                    scoped_path_to_host(str(config["file"]), cwd, task_root, host_root)
                )
    return sanitized


def compose_environment(raw: Any) -> dict[str, str]:
    """Validate the only agent-provided environment forwarded to Compose."""
    if raw is None:
        return {}
    if not isinstance(raw, dict) or not all(
        isinstance(key, str) and isinstance(value, str) for key, value in raw.items()
    ):
        raise BrokerError("invalid Compose environment")
    if set(raw) - COMPOSE_ENV_KEYS:
        raise BrokerError("Compose environment contains a non-allow-listed key")
    allowed: dict[str, str] = {}
    for key, value in raw.items():
        if not value or len(value) > 64:
            raise BrokerError(f"invalid Compose environment value: {key}")
        if key in {"DB_PORT", "WEB_PORT"}:
            if not value.isdecimal() or not 1 <= int(value) <= 65535:
                raise BrokerError(f"invalid Compose port: {key}")
        elif not COMPOSE_PROJECT_NAME_RE.fullmatch(value):
            raise BrokerError("invalid Compose project name")
        allowed[key] = value
    return allowed


def clean_environment(overrides: dict[str, str] | None = None) -> dict[str, str]:
    environment = dict(os.environ)
    for key in list(environment):
        if key.startswith("KANDEV_AGENT_DOCKER_") or key in {
            "KANDEV_AGENT_GUARD_ACTIVE",
            "DOCKER_CONTEXT",
            "DOCKER_HOST",
        }:
            environment.pop(key, None)
    if overrides:
        environment.update(overrides)
    return environment


def run_command(
    args: list[str], cwd: Path, timeout: int = COMMAND_TIMEOUT,
    environment_overrides: dict[str, str] | None = None,
) -> tuple[int, str, str]:
    with tempfile.TemporaryFile() as stdout_file, tempfile.TemporaryFile() as stderr_file:
        process = subprocess.Popen(
            args,
            cwd=str(cwd),
            env=clean_environment(environment_overrides),
            stdin=subprocess.DEVNULL,
            stdout=stdout_file,
            stderr=stderr_file,
        )
        try:
            return_code = process.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
            return_code = 124
            stderr_file.write(f"command timed out after {timeout} seconds\n".encode())
        stdout_file.seek(0)
        stderr_file.seek(0)
        stdout = stdout_file.read(MAX_OUTPUT + 1)
        stderr = stderr_file.read(MAX_OUTPUT + 1)
    if len(stdout) > MAX_OUTPUT:
        stdout = stdout[:MAX_OUTPUT] + b"\n[broker output truncated]\n"
    if len(stderr) > MAX_OUTPUT:
        stderr = stderr[:MAX_OUTPUT] + b"\n[broker error output truncated]\n"
    return return_code, stdout.decode(errors="replace"), stderr.decode(errors="replace")


def kandev_db() -> sqlite3.Connection:
    if not KANDEV_DB.is_file():
        raise BrokerError("Kandev task metadata is unavailable")
    connection = sqlite3.connect(f"file:{KANDEV_DB}?mode=ro", uri=True, timeout=5)
    connection.row_factory = sqlite3.Row
    return connection


def coordinator_context(task_root: Path) -> dict[str, str]:
    """Resolve a coordinator's task/workspace from trusted Kandev metadata.

    A repository name or agent-controlled .git file is not sufficient. The
    task's primary materialized workspace must itself be the coordinator repo,
    and that repo must be registered in the same Kandev workspace.
    """
    candidates: list[sqlite3.Row]
    with kandev_db() as database:
        if is_within(task_root, Path("/data/tasks")):
            relative = task_root.relative_to("/data/tasks")
            if len(relative.parts) != 1:
                raise BrokerError("invalid coordinator task root")
            candidates = database.execute(
                """
                SELECT t.id AS task_id, t.workspace_id, w.name AS workspace_name,
                       te.workspace_path, te.task_dir_name
                FROM task_environments te
                JOIN tasks t ON t.id = te.task_id
                JOIN workspaces w ON w.id = t.workspace_id
                WHERE te.task_dir_name = ? AND t.archived_at IS NULL
                """,
                (relative.name,),
            ).fetchall()
        else:
            candidates = database.execute(
                """
                SELECT t.id AS task_id, t.workspace_id, w.name AS workspace_name,
                       te.workspace_path, te.task_dir_name
                FROM task_environments te
                JOIN tasks t ON t.id = te.task_id
                JOIN workspaces w ON w.id = t.workspace_id
                WHERE te.workspace_path = ? AND t.archived_at IS NULL
                """,
                (str(task_root),),
            ).fetchall()

        eligible: list[sqlite3.Row] = []
        for candidate in candidates:
            primary_path = Path(str(candidate["workspace_path"]))
            if task_root == Path(COORDINATOR_REPOSITORY):
                primary_matches = primary_path == task_root
            else:
                # Older/restored task rows can retain the source repository as
                # workspace_path even though task_dir_name now owns a proper
                # linked worktree. The unique task directory plus the trusted
                # single-repository registration below is the authority.
                primary_matches = True
            if not primary_matches:
                continue
            registration = database.execute(
                """
                SELECT COUNT(*) AS repository_count,
                       SUM(CASE WHEN r.workspace_id = ? AND r.local_path = ?
                                     AND r.deleted_at IS NULL
                                THEN 1 ELSE 0 END) AS coordinator_count
                FROM task_repositories tr
                JOIN repositories r ON r.id = tr.repository_id
                WHERE tr.task_id = ?
                """,
                (
                    candidate["workspace_id"],
                    COORDINATOR_REPOSITORY,
                    candidate["task_id"],
                ),
            ).fetchone()
            if (
                registration
                and int(registration["repository_count"] or 0) == 1
                and int(registration["coordinator_count"] or 0) == 1
            ):
                eligible.append(candidate)

    if not eligible:
        raise BrokerError(
            "source access requires a live coordinator task whose primary repository "
            f"is {COORDINATOR_REPOSITORY}"
        )
    if len(eligible) != 1:
        raise BrokerError("coordinator task identity is ambiguous")
    row = eligible[0]
    return {
        "task_id": str(row["task_id"]),
        "workspace_id": str(row["workspace_id"]),
        "workspace_name": str(row["workspace_name"]),
    }


def container_path_for_host(path: str) -> Path | None:
    candidate = Path(os.path.normpath(path))
    if not candidate.is_absolute():
        return None
    mappings = [
        (os.environ.get("KANDEV_HOST_CODE_DIR", ""), Path("/data/home/Code")),
        (os.environ.get("KANDEV_HOST_DATA_DIR", ""), Path("/data")),
    ]
    matches: list[tuple[int, Path]] = []
    for host_prefix, container_prefix in mappings:
        if not host_prefix:
            continue
        try:
            relative = candidate.relative_to(Path(host_prefix))
        except ValueError:
            continue
        matches.append((len(Path(host_prefix).parts), container_prefix / relative))
    if matches:
        return max(matches, key=lambda item: item[0])[1]
    if candidate == Path("/data") or is_within(candidate, Path("/data")):
        return candidate
    return None


def inspected_container_working_dir(info: dict[str, Any]) -> Path | None:
    """Translate a container working directory through its inspected bind mount."""
    config = info.get("Config") or {}
    working_dir_raw = str(config.get("WorkingDir") or "")
    if not working_dir_raw:
        return None
    working_dir = Path(os.path.normpath(working_dir_raw))
    if not working_dir.is_absolute():
        return None

    best_match: tuple[int, Path] | None = None
    for mount in info.get("Mounts") or []:
        if not isinstance(mount, dict) or mount.get("Type") != "bind":
            continue
        source_raw = str(mount.get("Source") or "")
        destination_raw = str(mount.get("Destination") or "")
        if not source_raw or not destination_raw:
            continue
        source = Path(os.path.normpath(source_raw))
        destination = Path(os.path.normpath(destination_raw))
        if not source.is_absolute() or not destination.is_absolute():
            continue
        try:
            relative = working_dir.relative_to(destination)
        except ValueError:
            continue
        translated = container_path_for_host(str(source / relative))
        if translated is None:
            continue
        depth = len(destination.parts)
        if best_match is None or depth > best_match[0]:
            best_match = (depth, translated)
    if best_match is not None:
        return best_match[1]
    return container_path_for_host(str(working_dir))


def registered_runtime_workspace_ids(
    info: dict[str, Any], labels: dict[str, Any], database: sqlite3.Connection
) -> set[str] | None:
    """Resolve one backend-managed runtime through its live DB registration.

    ``None`` means the container has no complete Kandev runtime identity, so an
    independently trusted Compose ownership path may still be considered. A
    complete but stale, conflicting, or spoofed identity returns an empty set
    and cannot fall back to those less specific heuristics.
    """
    if not any(label in labels for label in RUNTIME_IDENTITY_LABELS):
        return None
    task_id = str(labels.get("kandev.task_id") or "")
    session_id = str(labels.get("kandev.session_id") or "")
    environment_id = str(labels.get("kandev.task_environment_id") or "")
    # A partial label set is not authoritative enough to revoke an otherwise
    # valid trusted Compose/workdir association. Once all identity labels are
    # present, however, a stale or conflicting claim must fail closed.
    if not task_id or not session_id or not environment_id:
        return None
    container_id = str(info.get("Id") or "")
    working_dir = inspected_container_working_dir(info)
    if labels.get("kandev.managed") != "true" or not container_id or working_dir is None:
        return set()

    placeholders = ", ".join("?" for _ in ACTIVE_TASK_SESSION_STATES)
    environment_placeholders = ", ".join("?" for _ in ACTIVE_TASK_ENVIRONMENT_STATES)
    executor_placeholders = ", ".join("?" for _ in ACTIVE_EXECUTOR_STATES)
    row = database.execute(
        f"""
        SELECT t.workspace_id, te.workspace_path, te.task_dir_name,
               te.container_id AS environment_container_id,
               er.container_id AS executor_container_id
        FROM tasks t
        JOIN task_sessions ts
          ON ts.id = ? AND ts.task_id = t.id
        JOIN task_environments te
          ON te.id = ? AND te.task_id = t.id
        JOIN executors_running er
          ON er.session_id = ts.id AND er.task_id = t.id
        WHERE t.id = ? AND t.archived_at IS NULL
          AND ts.task_environment_id = te.id
          AND ts.state IN ({placeholders})
          AND te.status IN ({environment_placeholders})
          AND er.status IN ({executor_placeholders})
        """,
        (
            session_id,
            environment_id,
            task_id,
            *sorted(ACTIVE_TASK_SESSION_STATES),
            *sorted(ACTIVE_TASK_ENVIRONMENT_STATES),
            *sorted(ACTIVE_EXECUTOR_STATES),
        ),
    ).fetchone()
    if row is None:
        return set()
    for column in ("environment_container_id", "executor_container_id"):
        persisted_container_id = str(row[column] or "")
        if persisted_container_id and persisted_container_id != container_id:
            return set()

    roots: list[Path] = []
    workspace_path_raw = str(row["workspace_path"] or "")
    if workspace_path_raw:
        workspace_path = container_path_for_host(workspace_path_raw)
        if workspace_path is not None:
            roots.append(workspace_path)
    task_dir_name = str(row["task_dir_name"] or "")
    if TASK_DIR_RE.fullmatch(task_dir_name):
        roots.append(Path("/data/tasks") / task_dir_name)
    if not any(working_dir == root or is_within(working_dir, root) for root in roots):
        return set()
    return {str(row["workspace_id"])}


def container_workspace_ids(info: dict[str, Any]) -> set[str]:
    labels = (info.get("Config") or {}).get("Labels") or {}
    workspace_ids: set[str] = set()
    working_dir_raw = labels.get("com.docker.compose.project.working_dir")
    working_dir = container_path_for_host(str(working_dir_raw)) if working_dir_raw else None

    with kandev_db() as database:
        runtime_workspace_ids = registered_runtime_workspace_ids(info, labels, database)
        if runtime_workspace_ids is not None:
            return runtime_workspace_ids
        if working_dir and is_within(working_dir, Path("/data/tasks")):
            relative = working_dir.relative_to("/data/tasks")
            if relative.parts:
                rows = database.execute(
                    """
                    SELECT t.workspace_id
                    FROM task_environments te
                    JOIN tasks t ON t.id = te.task_id
                    WHERE te.task_dir_name = ? AND t.archived_at IS NULL
                    """,
                    (relative.parts[0],),
                ).fetchall()
                workspace_ids.update(str(row["workspace_id"]) for row in rows)
        elif working_dir:
            rows = database.execute(
                """
                SELECT workspace_id, local_path
                FROM repositories
                WHERE deleted_at IS NULL
                """
            ).fetchall()
            for row in rows:
                repository_path = Path(str(row["local_path"]))
                if working_dir == repository_path or is_within(working_dir, repository_path):
                    workspace_ids.add(str(row["workspace_id"]))

        project = str(labels.get("com.docker.compose.project") or "")
        if project.startswith("kd_"):
            rows = database.execute(
                """
                SELECT t.workspace_id, te.task_dir_name, te.workspace_path
                FROM task_environments te
                JOIN tasks t ON t.id = te.task_id
                WHERE t.archived_at IS NULL
                """
            ).fetchall()
            for row in rows:
                task_dir_name = str(row["task_dir_name"] or "")
                roots = []
                if task_dir_name:
                    roots.append(Path("/data/tasks") / task_dir_name)
                workspace_path_raw = str(row["workspace_path"] or "")
                workspace_path = Path(workspace_path_raw)
                if workspace_path_raw and not is_within(workspace_path, Path("/data/tasks")):
                    roots.append(workspace_path)
                if any(project_name(root) == project for root in roots):
                    workspace_ids.add(str(row["workspace_id"]))
    return workspace_ids


def docker_inspect_container(name: str) -> dict[str, Any]:
    if not CONTAINER_NAME_RE.fullmatch(name):
        raise BrokerError("invalid source container name")
    code, stdout, stderr = run_command(
        [DOCKER_BIN, "inspect", "--type", "container", name], Path("/tmp"), timeout=30
    )
    if code != 0:
        raise BrokerError(f"source container is unavailable: {name}: {stderr or stdout}")
    try:
        documents = json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise BrokerError("Docker returned invalid container metadata") from exc
    if not isinstance(documents, list) or len(documents) != 1:
        raise BrokerError("Docker returned unexpected container metadata")
    return documents[0]


def require_workspace_container(name: str, workspace_id: str) -> dict[str, Any]:
    info = docker_inspect_container(name)
    if workspace_id not in container_workspace_ids(info):
        raise BrokerError(
            f"source container is not associated with the coordinator workspace: {name}"
        )
    return info


def container_summary(info: dict[str, Any]) -> dict[str, Any]:
    labels = (info.get("Config") or {}).get("Labels") or {}
    state = info.get("State") or {}
    health = (state.get("Health") or {}).get("Status")
    ports: list[dict[str, Any]] = []
    for container_port, bindings in sorted(
        ((info.get("NetworkSettings") or {}).get("Ports") or {}).items()
    ):
        host_bindings = []
        for binding in bindings or []:
            host_bindings.append(
                {"address": binding.get("HostIp", ""), "port": binding.get("HostPort", "")}
            )
        ports.append({"container": container_port, "host": host_bindings})
    return {
        "name": str(info.get("Name") or "").lstrip("/"),
        "id": str(info.get("Id") or "")[:12],
        "image": str((info.get("Config") or {}).get("Image") or ""),
        "state": str(state.get("Status") or "unknown"),
        "health": health,
        "compose_project": labels.get("com.docker.compose.project"),
        "compose_service": labels.get("com.docker.compose.service"),
        "ports": ports,
    }


def list_workspace_containers(workspace_id: str) -> list[dict[str, Any]]:
    code, stdout, stderr = run_command(
        [DOCKER_BIN, "container", "ls", "--all", "--quiet"], Path("/tmp"), timeout=30
    )
    if code != 0:
        raise BrokerError(f"cannot list source containers: {stderr or stdout}")
    identifiers = [line.strip() for line in stdout.splitlines() if line.strip()]
    if not identifiers:
        return []
    code, stdout, stderr = run_command(
        [DOCKER_BIN, "inspect", "--type", "container", *identifiers],
        Path("/tmp"),
        timeout=30,
    )
    if code != 0:
        raise BrokerError(f"cannot inspect source containers: {stderr or stdout}")
    try:
        infos = json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise BrokerError("Docker returned invalid container metadata") from exc
    visible = [
        container_summary(info)
        for info in infos
        if workspace_id in container_workspace_ids(info)
    ]
    return sorted(visible, key=lambda item: str(item["name"]))


def redact_logs(value: str) -> str:
    pattern = re.compile(
        r"(?i)(password|passwd|token|secret|authorization|api[_-]?key)"
        r"(\s*[:=]\s*)([^\s,;]+)"
    )
    return pattern.sub(lambda match: f"{match.group(1)}{match.group(2)}<redacted>", value)


def audit_source(context: dict[str, str], operation: str, **fields: Any) -> None:
    event = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "coordinator_task_id": context["task_id"],
        "workspace_id": context["workspace_id"],
        "operation": operation,
        **fields,
    }
    try:
        COORDINATOR_AUDIT_LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        line = json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n"
        with AUDIT_LOCK, COORDINATOR_AUDIT_LOG.open("a", encoding="utf-8") as handle:
            handle.write(line)
        COORDINATOR_AUDIT_LOG.chmod(0o600)
    except OSError as exc:
        raise BrokerError(f"cannot record coordinator source audit event: {exc}") from exc


def target_task_inbox(target_task_id: str, workspace_id: str, output_name: str) -> tuple[Path, str]:
    if not TASK_ID_RE.fullmatch(target_task_id):
        raise BrokerError("target task ID must be a full UUID")
    if not SAFE_OUTPUT_NAME_RE.fullmatch(output_name) or output_name in {".", ".."}:
        raise BrokerError("invalid export output name")
    with kandev_db() as database:
        row = database.execute(
            """
            SELECT te.task_dir_name
            FROM tasks t
            JOIN task_environments te ON te.task_id = t.id
            WHERE t.id = ? AND t.workspace_id = ? AND t.archived_at IS NULL
            """,
            (target_task_id, workspace_id),
        ).fetchone()
    if row is None or not str(row["task_dir_name"] or ""):
        raise BrokerError("target task has no active task-scoped workspace")
    container_root = Path("/data/tasks") / str(row["task_dir_name"])
    host_root = translate_to_host(container_root)
    inbox = host_root / ".kandev-coordinator-inbox"
    inbox.mkdir(mode=0o700, parents=False, exist_ok=True)
    inbox.chmod(0o700)
    resolved_inbox = inbox.resolve(strict=True)
    if not is_within(resolved_inbox, host_root):
        raise BrokerError("target task inbox escapes its workspace")
    destination = resolved_inbox / output_name
    if destination.exists() or destination.is_symlink():
        raise BrokerError("target task export already exists")
    container_destination = f"{container_root}/.kandev-coordinator-inbox/{output_name}"
    return destination, container_destination


def registered_static_backup(source_path: str, workspace_id: str) -> tuple[Path, str]:
    """Return one approved logical backup from a registered source root.

    This is deliberately not a generic file-read API.  The caller must name
    exactly ``last_db.sql`` directly below a live repository registered in the
    coordinator's own workspace.  Both the root and the file are rejected if
    they are symlinks.
    """
    requested = Path(source_path)
    if not requested.is_absolute() or requested.name != STATIC_BACKUP_NAME:
        raise BrokerError(f"static backup must be an absolute {STATIC_BACKUP_NAME} path")
    with kandev_db() as database:
        rows = database.execute(
            """
            SELECT local_path
            FROM repositories
            WHERE workspace_id = ? AND deleted_at IS NULL
            """,
            (workspace_id,),
        ).fetchall()
    for row in rows:
        registered = container_path_for_host(str(row["local_path"] or ""))
        if registered is None or requested != registered / STATIC_BACKUP_NAME:
            continue
        host_root = translate_to_host_lexical(registered)
        host_source = translate_to_host_lexical(requested)
        try:
            root_stat = os.lstat(host_root)
            source_stat = os.lstat(host_source)
        except OSError as exc:
            raise BrokerError(f"static backup is unavailable: {exc}") from exc
        if stat.S_ISLNK(root_stat.st_mode) or not stat.S_ISDIR(root_stat.st_mode):
            raise BrokerError("registered static backup root is not a real directory")
        if stat.S_ISLNK(source_stat.st_mode) or not stat.S_ISREG(source_stat.st_mode):
            raise BrokerError("static backup must be a regular non-symlink file")
        if source_stat.st_size > MAX_STATIC_BACKUP:
            raise BrokerError("static backup exceeds the configured size limit")
        return host_source, str(requested)
    raise BrokerError("static backup is not allow-listed for this coordinator workspace")


def copy_static_backup(source: Path, destination: Path) -> tuple[int, str]:
    """Copy a validated backup without following links or exposing its content."""
    descriptor = os.open(source, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    temporary_path: Path | None = None
    try:
        initial = os.fstat(descriptor)
        if not stat.S_ISREG(initial.st_mode) or initial.st_size > MAX_STATIC_BACKUP:
            raise BrokerError("static backup is not a permitted regular file")
        temporary = tempfile.NamedTemporaryFile(
            mode="wb", prefix=f".{destination.name}.", dir=destination.parent, delete=False
        )
        temporary_path = Path(temporary.name)
        digest = hashlib.sha256()
        total = 0
        with temporary, os.fdopen(descriptor, "rb", closefd=False) as stream:
            while True:
                chunk = stream.read(1024 * 1024)
                if not chunk:
                    break
                total += len(chunk)
                if total > MAX_STATIC_BACKUP:
                    raise BrokerError("static backup exceeds the configured size limit")
                digest.update(chunk)
                temporary.write(chunk)
        final = os.fstat(descriptor)
        if (final.st_dev, final.st_ino, final.st_size, final.st_mtime_ns) != (
            initial.st_dev,
            initial.st_ino,
            initial.st_size,
            initial.st_mtime_ns,
        ):
            raise BrokerError("static backup changed while being copied")
        os.link(temporary_path, destination)
        destination.chmod(0o600)
        return total, digest.hexdigest()
    finally:
        os.close(descriptor)
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def container_environment(info: dict[str, Any]) -> dict[str, str]:
    environment: dict[str, str] = {}
    for item in (info.get("Config") or {}).get("Env") or []:
        key, separator, value = str(item).partition("=")
        if separator:
            environment[key] = value
    return environment


def database_export_command(info: dict[str, Any]) -> tuple[list[str], dict[str, str]]:
    environment = container_environment(info)
    image = str((info.get("Config") or {}).get("Image") or "").lower()
    networks = (info.get("NetworkSettings") or {}).get("Networks") or {}
    addresses = sorted(
        str(network.get("IPAddress") or "")
        for network in networks.values()
        if network.get("IPAddress")
    )
    if not addresses:
        raise BrokerError("source database has no broker-reachable container address")
    host = addresses[0]

    if "mariadb" in image or "mysql" in image or any(
        key in environment for key in ("MARIADB_DATABASE", "MYSQL_DATABASE")
    ):
        database = environment.get("MARIADB_DATABASE") or environment.get("MYSQL_DATABASE")
        user = environment.get("MARIADB_USER") or environment.get("MYSQL_USER")
        password = environment.get("MARIADB_PASSWORD") or environment.get("MYSQL_PASSWORD")
        if not user or not password:
            user = "root"
            password = environment.get("MARIADB_ROOT_PASSWORD") or environment.get(
                "MYSQL_ROOT_PASSWORD"
            )
        if not database or not user or not password:
            raise BrokerError("source MariaDB lacks an exportable database credential set")
        return (
            [
                "/usr/bin/mariadb-dump",
                "--host",
                host,
                "--port",
                "3306",
                "--user",
                user,
                "--single-transaction",
                "--quick",
                "--skip-lock-tables",
                "--hex-blob",
                database,
            ],
            {"MYSQL_PWD": password},
        )

    if "postgres" in image or "POSTGRES_DB" in environment:
        database = environment.get("POSTGRES_DB") or environment.get("POSTGRES_USER")
        user = environment.get("POSTGRES_USER")
        password = environment.get("POSTGRES_PASSWORD")
        if not database or not user or not password:
            raise BrokerError("source PostgreSQL lacks an exportable database credential set")
        return (
            [
                "/usr/bin/pg_dump",
                "--host",
                host,
                "--port",
                "5432",
                "--username",
                user,
                "--dbname",
                database,
                "--no-owner",
                "--no-privileges",
            ],
            {"PGPASSWORD": password},
        )
    raise BrokerError("source container is not a supported MariaDB/MySQL/PostgreSQL database")


def run_bounded_export(
    args: list[str], environment_overrides: dict[str, str], destination: Path
) -> tuple[int, str, int, str]:
    process_environment = clean_environment()
    process_environment.update(environment_overrides)
    temporary = tempfile.NamedTemporaryFile(
        mode="wb", prefix=f".{destination.name}.", dir=destination.parent, delete=False
    )
    temporary_path = Path(temporary.name)
    total = 0
    digest = hashlib.sha256()
    stderr_chunks: list[bytes] = []
    deadline = time.monotonic() + COMMAND_TIMEOUT
    process: subprocess.Popen[bytes] | None = None
    selector: selectors.BaseSelector | None = None
    try:
        process = subprocess.Popen(
            args,
            cwd="/tmp",
            env=process_environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        assert process.stdout is not None and process.stderr is not None
        selector = selectors.DefaultSelector()
        selector.register(process.stdout, selectors.EVENT_READ, "stdout")
        selector.register(process.stderr, selectors.EVENT_READ, "stderr")
        with temporary:
            while selector.get_map():
                if time.monotonic() >= deadline:
                    process.kill()
                    raise BrokerError("database export timed out")
                events = selector.select(timeout=0.25)
                if not events and process.poll() is not None:
                    events = [(key, selectors.EVENT_READ) for key in selector.get_map().values()]
                for key, _ in events:
                    chunk = os.read(key.fileobj.fileno(), 1024 * 1024)
                    if not chunk:
                        selector.unregister(key.fileobj)
                        continue
                    if key.data == "stdout":
                        total += len(chunk)
                        if total > MAX_EXPORT:
                            process.kill()
                            raise BrokerError("database export exceeded the configured size limit")
                        digest.update(chunk)
                        temporary.write(chunk)
                    elif sum(len(item) for item in stderr_chunks) < MAX_OUTPUT:
                        stderr_chunks.append(chunk[: MAX_OUTPUT - sum(len(item) for item in stderr_chunks)])
        return_code = process.wait(timeout=5)
        stderr = b"".join(stderr_chunks).decode(errors="replace")
        if return_code != 0:
            return return_code, stderr, total, digest.hexdigest()
        os.link(temporary_path, destination)
        destination.chmod(0o600)
        return return_code, stderr, total, digest.hexdigest()
    finally:
        if selector is not None:
            selector.close()
        if process is not None and process.poll() is None:
            process.kill()
            process.wait()
        temporary_path.unlink(missing_ok=True)


def source_help() -> str:
    return (
        "Coordinator source commands:\n"
        "  docker kandev source list\n"
        "  docker kandev source inspect <container>\n"
        "  docker kandev source logs <container> [--tail N] [--since 30m]\n"
        "  docker kandev source db-dump <container> --target-task <UUID> [--name dump.sql]\n"
        "  docker kandev source static-backup /data/home/Code/<repo>/last_db.sql --target-task <UUID> --name backup.sql\n"
    )


def workspace_help() -> str:
    return (
        "Coordinator workspace commands:\n"
        "  docker kandev workspace probe <task-uuid>\n"
        "  docker kandev workspace description-update <file>\n"
    )


def support_help() -> str:
    return (
        "Kandev Support commands (validated coordinators only):\n"
        "  docker kandev support send <request.json>\n"
        "  docker kandev support status <request-id>\n"
        "  docker kandev support receive <request-id>\n"
    )


def support_request_file(context: dict[str, str], task_root: Path, file_name: str) -> dict[str, Any]:
    source = resolve_inside(file_name, task_root, task_root)
    if not source.is_file() or source.is_symlink() or source.stat().st_size > 128 * 1024:
        raise BrokerError("support request must be a regular JSON file inside the coordinator task")
    try:
        supplied = json.loads(source.read_text(encoding="utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise BrokerError(f"support request is not valid UTF-8 JSON: {exc}") from exc
    required = ("problem", "evidence", "expected_outcome", "security_constraints")
    if not isinstance(supplied, dict) or any(
        not isinstance(supplied.get(field), str) or not supplied[field].strip()
        for field in required
    ):
        raise BrokerError("support request requires non-empty problem, evidence, expected_outcome, and security_constraints strings")
    request_id = str(uuid.uuid4())
    record = {
        "id": request_id,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "coordinator_task_id": context["task_id"],
        "workspace_id": context["workspace_id"],
        "workspace_name": context["workspace_name"],
        "worktree": str(task_root),
        **{field: supplied[field].strip() for field in required},
    }
    records = SUPPORT_QUEUE / "records"
    pending = SUPPORT_QUEUE / "pending"
    records.mkdir(parents=True, mode=0o700, exist_ok=True)
    pending.mkdir(parents=True, mode=0o700, exist_ok=True)
    record_path = records / f"{request_id}.json"
    temporary = records / f".{request_id}.tmp"
    temporary.write_text(json.dumps(record, indent=2), encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(record_path)
    pending_path = pending / f"{request_id}.json"
    pending_path.write_text(json.dumps(record), encoding="utf-8")
    pending_path.chmod(0o600)
    audit_source(context, "support-send", result="ok", request_id=request_id)
    return {"returncode": 0, "stdout": json.dumps({"request_id": request_id, "status": "queued"}, indent=2) + "\n", "stderr": ""}


def support_result(context: dict[str, str], request_id: str, receive: bool) -> dict[str, Any]:
    if not TASK_ID_RE.fullmatch(request_id):
        raise BrokerError("support request ID must be a full UUID")
    record_path = SUPPORT_QUEUE / "records" / f"{request_id}.json"
    if not record_path.is_file():
        raise BrokerError("support request is unavailable")
    record = json.loads(record_path.read_text(encoding="utf-8"))
    if record.get("coordinator_task_id") != context["task_id"] or record.get("workspace_id") != context["workspace_id"]:
        raise BrokerError("support request belongs to another coordinator/workspace")
    response_path = SUPPORT_QUEUE / "responses" / f"{request_id}.json"
    if not response_path.is_file():
        status = "processing" if (SUPPORT_QUEUE / "processing" / f"{request_id}.json").exists() else "queued"
        return {"returncode": 0, "stdout": json.dumps({"request_id": request_id, "status": status}, indent=2) + "\n", "stderr": ""}
    response = json.loads(response_path.read_text(encoding="utf-8"))
    audit_source(context, "support-receive" if receive else "support-status", result="ok", request_id=request_id)
    if receive:
        return {"returncode": int(response.get("returncode", 70)), "stdout": str(response.get("stdout", "")), "stderr": str(response.get("stderr", ""))}
    result = {
        "request_id": request_id,
        "status": "complete",
        "returncode": response.get("returncode", 70),
    }
    if response.get("resolution_status"):
        result["resolution_status"] = response["resolution_status"]
    return {"returncode": 0, "stdout": json.dumps(result, indent=2) + "\n", "stderr": ""}


def handle_coordinator_support(task_root: Path, args: list[str]) -> dict[str, Any]:
    context = coordinator_context(task_root)
    operation_args = args[2:]
    if not operation_args or operation_args == ["help"]:
        return {"returncode": 0, "stdout": support_help(), "stderr": ""}
    if operation_args[0] == "send" and len(operation_args) == 2:
        return support_request_file(context, task_root, operation_args[1])
    if operation_args[0] in {"status", "receive"} and len(operation_args) == 2:
        return support_result(context, operation_args[1], operation_args[0] == "receive")
    raise BrokerError(f"unsupported support operation\n{support_help()}")


@contextmanager
def temporary_operator_token():
    """Mint a five-minute PAT inside the broker and revoke it after one request.

    The credential never crosses the broker socket. Authorization remains
    coordinator/task-scoped in this process; the backend API performs the task
    mutation so normal events and UI refreshes are preserved.
    """
    if not KANDEV_DB.is_file():
        raise BrokerError("Kandev task metadata is unavailable")
    prefix = secrets.token_hex(4)
    token = f"kandev_pat_{prefix}_{secrets.token_urlsafe(32)}"
    token_hash = hashlib.sha256(token.encode()).hexdigest()
    token_id = str(uuid.uuid4())
    now = datetime.now(timezone.utc)
    expires = now.timestamp() + 300
    database = sqlite3.connect(KANDEV_DB, timeout=30)
    try:
        database.execute("PRAGMA busy_timeout = 30000")
        user = database.execute(
            "SELECT id FROM users WHERE role='admin' AND status='active' "
            "ORDER BY created_at, id LIMIT 1"
        ).fetchone()
        if user is None:
            raise BrokerError("no active Kandev administrator is available for API mutation")
        database.execute(
            "INSERT INTO auth_api_tokens "
            "(id,user_id,name,prefix,token_sha256,created_at,expires_at) "
            "VALUES (?,?,?,?,?,?,datetime(?,'unixepoch'))",
            (token_id, user[0], "coordinator-description-broker", prefix, token_hash,
             now.isoformat(), expires),
        )
        database.commit()
        yield token
    finally:
        try:
            database.execute("DELETE FROM auth_api_tokens WHERE id=?", (token_id,))
            database.commit()
        finally:
            database.close()


def backend_json(method: str, path: str, token: str, payload: dict[str, Any] | None = None) -> Any:
    data = None if payload is None else json.dumps(payload).encode()
    request = urllib.request.Request(
        f"http://127.0.0.1:38429{path}",
        data=data,
        method=method,
        headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read())
    except (urllib.error.URLError, json.JSONDecodeError) as exc:
        raise BrokerError(f"Kandev API request failed: {exc}") from exc


def coordinator_description_update(
    context: dict[str, str], task_root: Path, file_name: str
) -> dict[str, Any]:
    source = resolve_inside(file_name, task_root, task_root)
    if not source.is_file() or source.is_symlink():
        raise BrokerError("description source must be a regular non-symlink file")
    size = source.stat().st_size
    if size > MAX_DESCRIPTION_BYTES:
        raise BrokerError(f"description source exceeds {MAX_DESCRIPTION_BYTES} bytes")
    try:
        description = source.read_text(encoding="utf-8").strip()
    except UnicodeDecodeError as exc:
        raise BrokerError("description source must be UTF-8 text") from exc
    new_sha = hashlib.sha256(description.encode()).hexdigest()
    audit_source(
        context, "description-update", result="attempt", source=str(source),
        bytes=len(description.encode()), sha256=new_sha,
    )
    with temporary_operator_token() as token:
        current = backend_json("GET", f"/api/v1/tasks/{context['task_id']}", token)
        old_description = str(current.get("description") or "")
        old_sha = hashlib.sha256(old_description.encode()).hexdigest()
        if old_description != description:
            updated = backend_json(
                "PATCH", f"/api/v1/tasks/{context['task_id']}", token,
                {"description": description},
            )
            if str(updated.get("description") or "") != description:
                raise BrokerError("Kandev API did not persist the exact description")
    audit_source(
        context, "description-update", result="ok", source=str(source),
        bytes=len(description.encode()), old_sha256=old_sha, sha256=new_sha,
    )
    return {
        "returncode": 0,
        "stdout": json.dumps({
            "task_id": context["task_id"], "source": str(source),
            "bytes": len(description.encode()), "sha256": new_sha,
            "changed": old_sha != new_sha,
        }, indent=2) + "\n",
        "stderr": "",
    }


def workspace_task_probe(context: dict[str, str], target_task_id: str) -> dict[str, Any]:
    """Run a fresh guard-rooted writability probe for one same-workspace task."""
    if not TASK_ID_RE.fullmatch(target_task_id):
        raise BrokerError("target task ID must be a full UUID")
    with kandev_db() as database:
        row = database.execute(
            """
            SELECT te.task_dir_name, te.workspace_path
            FROM tasks t
            JOIN task_environments te ON te.task_id = t.id
            WHERE t.id = ? AND t.workspace_id = ? AND t.archived_at IS NULL
              AND te.task_dir_name <> ''
            ORDER BY te.updated_at DESC
            LIMIT 1
            """,
            (target_task_id, context["workspace_id"]),
        ).fetchone()
    if row is None:
        raise BrokerError("target task has no active task-scoped workspace")
    task_dir_name = str(row["task_dir_name"])
    if not TASK_DIR_RE.fullmatch(task_dir_name):
        raise BrokerError("target task has an invalid task directory")
    task_root = (Path("/data/tasks") / task_dir_name).resolve(strict=True)
    if task_root.parent != Path("/data/tasks"):
        raise BrokerError("target task root escapes the managed task directory")

    workspace_path = Path(str(row["workspace_path"] or ""))
    try:
        probe_cwd = workspace_path.resolve(strict=True)
    except OSError:
        probe_cwd = task_root
    if not is_within(probe_cwd, task_root):
        probe_cwd = task_root
    if not (probe_cwd / ".git").exists():
        candidates = sorted(
            path for path in task_root.iterdir() if path.is_dir() and (path / ".git").exists()
        )
        if candidates:
            probe_cwd = candidates[0]

    script = r"""
set -eu
task_root=$1
printf 'task_root=%s\n' "$task_root"
printf 'task_mount=%s\n' "$(findmnt -T "$task_root" -n -o OPTIONS)"
probe=$(mktemp "$task_root/.kandev-workspace-probe.XXXXXX")
rm -f "$probe"
echo 'task_write=ok'
if git rev-parse --show-toplevel >/dev/null 2>&1; then
    repo=$(git rev-parse --show-toplevel)
    common=$(git rev-parse --git-common-dir)
    gitdir=$(git rev-parse --git-dir)
    printf 'repository=%s\n' "$repo"
    printf 'repository_mount=%s\n' "$(findmnt -T "$repo" -n -o OPTIONS)"
    printf 'git_common=%s\n' "$common"
    printf 'git_common_mount=%s\n' "$(findmnt -T "$common" -n -o OPTIONS)"
    printf 'git_dir=%s\n' "$gitdir"
    printf 'git_dir_mount=%s\n' "$(findmnt -T "$gitdir" -n -o OPTIONS)"
    git add -A --dry-run >/dev/null
    echo 'git_add_dry_run=ok'
fi
"""
    audit_source(context, "workspace-probe", target_task_id=target_task_id, result="attempt")
    code, stdout, stderr = run_command(
        [GUARD_BIN, "--", "sh", "-ceu", script, "sh", str(task_root)],
        probe_cwd,
        timeout=30,
    )
    audit_source(
        context,
        "workspace-probe",
        target_task_id=target_task_id,
        result="ok" if code == 0 else "error",
    )
    return {"returncode": code, "stdout": stdout, "stderr": stderr}


def handle_coordinator_workspace(task_root: Path, args: list[str]) -> dict[str, Any]:
    context = coordinator_context(task_root)
    operation_args = args[2:]
    if not operation_args or operation_args == ["help"]:
        audit_source(context, "workspace-help", result="ok")
        return {"returncode": 0, "stdout": workspace_help(), "stderr": ""}
    if operation_args[0] == "probe" and len(operation_args) == 2:
        return workspace_task_probe(context, operation_args[1])
    if operation_args[0] == "description-update" and len(operation_args) == 2:
        return coordinator_description_update(context, task_root, operation_args[1])
    raise BrokerError(f"unsupported coordinator workspace operation\n{workspace_help()}")


def handle_coordinator_source(
    task_root: Path, args: list[str]
) -> dict[str, Any]:
    context = coordinator_context(task_root)
    operation_args = args[2:]
    if not operation_args or operation_args == ["help"]:
        audit_source(context, "help", result="ok")
        return {"returncode": 0, "stdout": source_help(), "stderr": ""}
    operation = operation_args[0]
    # The attempt record survives validation/runtime failures; successful
    # operations append a result record with only non-secret metadata.
    audit_source(context, operation, result="attempt")

    if operation == "list" and len(operation_args) == 1:
        containers = list_workspace_containers(context["workspace_id"])
        audit_source(context, operation, result="ok", count=len(containers))
        return {
            "returncode": 0,
            "stdout": json.dumps(
                {"workspace": context["workspace_name"], "containers": containers}, indent=2
            )
            + "\n",
            "stderr": "",
        }

    if operation == "inspect" and len(operation_args) == 2:
        name = operation_args[1]
        info = require_workspace_container(name, context["workspace_id"])
        audit_source(context, operation, source=name, result="ok")
        return {
            "returncode": 0,
            "stdout": json.dumps(container_summary(info), indent=2) + "\n",
            "stderr": "",
        }

    if operation == "logs" and len(operation_args) >= 2:
        name = operation_args[1]
        tail = 200
        since = "30m"
        index = 2
        while index < len(operation_args):
            option = operation_args[index]
            if option not in {"--tail", "--since"} or index + 1 >= len(operation_args):
                raise BrokerError(f"unsupported source logs option: {option}")
            value = operation_args[index + 1]
            if option == "--tail":
                if not value.isdigit() or not 1 <= int(value) <= MAX_LOG_LINES:
                    raise BrokerError(f"source log tail must be between 1 and {MAX_LOG_LINES}")
                tail = int(value)
            elif not re.fullmatch(r"[1-9][0-9]*[smhd]", value):
                raise BrokerError("source log --since must be a duration such as 30m or 2h")
            else:
                since = value
            index += 2
        require_workspace_container(name, context["workspace_id"])
        code, stdout, stderr = run_command(
            [DOCKER_BIN, "logs", "--tail", str(tail), "--since", since, name],
            Path("/tmp"),
            timeout=60,
        )
        audit_source(context, operation, source=name, result="ok" if code == 0 else "error")
        return {
            "returncode": code,
            "stdout": redact_logs(stdout),
            "stderr": redact_logs(stderr),
        }

    if operation == "db-dump" and len(operation_args) >= 2:
        name = operation_args[1]
        target_task_id = ""
        output_name = ""
        index = 2
        while index < len(operation_args):
            option = operation_args[index]
            if option not in {"--target-task", "--name"} or index + 1 >= len(operation_args):
                raise BrokerError(f"unsupported source db-dump option: {option}")
            value = operation_args[index + 1]
            if option == "--target-task":
                target_task_id = value
            else:
                output_name = value
            index += 2
        if not target_task_id:
            raise BrokerError("source db-dump requires --target-task <UUID>")
        if not output_name:
            timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
            output_name = f"{name}-{timestamp}.sql"
        info = require_workspace_container(name, context["workspace_id"])
        if str((info.get("State") or {}).get("Status")) != "running":
            raise BrokerError("source database container is not running")
        destination, container_destination = target_task_inbox(
            target_task_id, context["workspace_id"], output_name
        )
        command, environment = database_export_command(info)
        with EXPORT_LOCK:
            code, stderr, size, checksum = run_bounded_export(
                command, environment, destination
            )
        if code != 0:
            destination.unlink(missing_ok=True)
            audit_source(
                context,
                operation,
                source=name,
                target_task_id=target_task_id,
                result="error",
            )
            raise BrokerError(f"logical database export failed: {redact_logs(stderr)}")
        audit_source(
            context,
            operation,
            source=name,
            target_task_id=target_task_id,
            output=container_destination,
            bytes=size,
            sha256=checksum,
            result="ok",
        )
        return {
            "returncode": 0,
            "stdout": json.dumps(
                {
                    "source": name,
                    "target_task_id": target_task_id,
                    "path": container_destination,
                    "bytes": size,
                    "sha256": checksum,
                },
                indent=2,
            )
            + "\n",
            "stderr": "",
        }

    if operation == "static-backup" and len(operation_args) >= 2:
        source_path = operation_args[1]
        target_task_id = ""
        output_name = ""
        index = 2
        while index < len(operation_args):
            option = operation_args[index]
            if option not in {"--target-task", "--name"} or index + 1 >= len(operation_args):
                raise BrokerError(f"unsupported source static-backup option: {option}")
            value = operation_args[index + 1]
            if option == "--target-task":
                target_task_id = value
            else:
                output_name = value
            index += 2
        if not target_task_id or not output_name:
            raise BrokerError("source static-backup requires --target-task <UUID> and --name <backup.sql>")
        if not output_name.endswith(".sql"):
            raise BrokerError("static backup output name must end in .sql")
        source, container_source = registered_static_backup(source_path, context["workspace_id"])
        destination, container_destination = target_task_inbox(
            target_task_id, context["workspace_id"], output_name
        )
        try:
            size, checksum = copy_static_backup(source, destination)
        except Exception:
            destination.unlink(missing_ok=True)
            raise
        audit_source(
            context,
            operation,
            source=container_source,
            target_task_id=target_task_id,
            output=container_destination,
            bytes=size,
            sha256=checksum,
            result="ok",
        )
        return {
            "returncode": 0,
            "stdout": json.dumps(
                {
                    "source": container_source,
                    "target_task_id": target_task_id,
                    "path": container_destination,
                    "bytes": size,
                    "sha256": checksum,
                },
                indent=2,
            )
            + "\n",
            "stderr": "",
        }

    raise BrokerError(f"unsupported coordinator source operation\n{source_help()}")


def compose_config(
    cwd: Path, project: str, global_args: list[str], environment_overrides: dict[str, str]
) -> dict[str, Any]:
    # Parse all agent-controlled Compose files inside the same Bubblewrap scope
    # as the agent. The broker never opens env/config/include files on the host.
    args = [
        GUARD_BIN,
        "--",
        COMPOSE_PLUGIN,
        "--project-name",
        project,
        *global_args,
        "config",
        "--format",
        "json",
    ]
    code, stdout, stderr = run_command(args, cwd, environment_overrides=environment_overrides)
    if code != 0:
        raise BrokerError(f"Docker Compose configuration failed:\n{stderr or stdout}")
    try:
        return json.loads(stdout)
    except json.JSONDecodeError as exc:
        raise BrokerError("Docker Compose returned an invalid configuration model") from exc


def handle_request(request: dict[str, Any], key: bytes) -> dict[str, Any]:
    task_root_raw = request.get("task_root")
    cwd_raw = request.get("cwd")
    args = request.get("args")
    token = request.get("token")
    environment_overrides = compose_environment(request.get("compose_environment"))
    if not isinstance(task_root_raw, str) or not isinstance(cwd_raw, str):
        raise BrokerError("missing task scope")
    if not isinstance(args, list) or not all(isinstance(item, str) for item in args):
        raise BrokerError("invalid Docker argument vector")
    if not isinstance(token, str):
        raise BrokerError("missing task token")

    task_root = Path(task_root_raw).resolve(strict=True)
    cwd = Path(cwd_raw).resolve(strict=True)
    if not is_within(cwd, task_root):
        raise BrokerError("working directory is outside this agent task")
    if not hmac.compare_digest(token, expected_token(key, task_root)):
        raise BrokerError("invalid task-scoped Docker token")

    if args[:2] == ["kandev", "source"]:
        return handle_coordinator_source(task_root, args)
    if args[:2] == ["kandev", "workspace"]:
        return handle_coordinator_workspace(task_root, args)
    if args[:2] == ["kandev", "support"]:
        return handle_coordinator_support(task_root, args)

    host_root = translate_to_host(task_root)
    global_args, command, command_args = split_compose_args(args, cwd, task_root)
    requested_project = environment_overrides.get("COMPOSE_PROJECT_NAME", project_name(task_root))
    try:
        project = scoped_project_name(task_root, environment_overrides)
    except BrokerError as exc:
        if command not in DESTRUCTIVE_COMPOSE_COMMANDS:
            raise
        audit_id = str(uuid.uuid4())
        audit_compose(
            task_root, cwd, requested_project, "", command, "deny", "denied", audit_id=audit_id
        )
        raise ComposeAuditError(str(exc), audit_id, "") from exc
    # Compose's own interpolation must observe the same value that the broker
    # passes as --project-name.  This keeps labels/ports deterministic without
    # trusting any environment other than the existing narrow allow-list.
    environment_overrides = {**environment_overrides, "COMPOSE_PROJECT_NAME": project}
    if command == "version":
        code, stdout, stderr = run_command([DOCKER_BIN, "compose", "version", *command_args], cwd)
        return {"returncode": code, "stdout": stdout, "stderr": stderr, "project": project}

    audit_id: str | None = None
    if command in DESTRUCTIVE_COMPOSE_COMMANDS:
        sanitized_model, audit_id = destructive_model_preflight(
            task_root, cwd, requested_project, project, command
        )
    elif command in SAFE_EXISTING_COMMANDS:
        # Existing/destructive commands must never create or refresh an
        # ownership record.  A sibling clone can only operate its own prior
        # model, not the registered main clone's project.
        sanitized_model = load_scoped_model(task_root, cwd, project)
    else:
        initial_model = compose_config(cwd, project, global_args, environment_overrides)
        sanitized_model = validate_model(initial_model, cwd, task_root, host_root, project)
        save_scoped_model(task_root, cwd, project, sanitized_model)

    model_file: Path | None = None
    try:
        handle = tempfile.NamedTemporaryFile(
            mode="w", prefix=f"{project}-", suffix=".json", dir="/run/kandev-agent-docker", delete=False
        )
        with handle:
            json.dump(sanitized_model, handle)
        model_file = Path(handle.name)
        command_line = [
            DOCKER_BIN,
            "compose",
            "--project-name",
            project,
            "-f",
            str(model_file),
        ]
        # Profiles affect which already-sanitized services Compose selects.
        index = 0
        while index < len(global_args):
            if global_args[index] == "--profile":
                command_line.extend(global_args[index : index + 2])
                index += 2
            elif global_args[index].startswith("--profile="):
                command_line.append(global_args[index])
                index += 1
            else:
                index += 1
        command_line.extend((command, *command_args))
        code, stdout, stderr = run_command(command_line, cwd)
        if command in DESTRUCTIVE_COMPOSE_COMMANDS:
            audit_compose(
                task_root, cwd, requested_project, project, command,
                "allow", "ok" if code == 0 else "error", audit_id=audit_id or "",
            )
        response = {"returncode": code, "stdout": stdout, "stderr": stderr, "project": project}
        if audit_id:
            response["audit_id"] = audit_id
            response["resolved_project"] = project
        return response
    finally:
        if model_file is not None:
            model_file.unlink(missing_ok=True)


class BrokerHandler(socketserver.StreamRequestHandler):
    def handle(self) -> None:
        line = self.rfile.readline(MAX_REQUEST + 1)
        if len(line) > MAX_REQUEST:
            response = {"returncode": 78, "stdout": "", "stderr": "Docker broker request is too large\n"}
        else:
            try:
                request = json.loads(line)
                response = handle_request(request, self.server.broker_key)  # type: ignore[attr-defined]
            except ComposeAuditError as exc:
                response = {
                    "returncode": 78,
                    "stdout": "",
                    "stderr": f"kandev-agent-docker: {exc}\n",
                    "audit_id": exc.audit_id,
                    "resolved_project": exc.project,
                }
            except (BrokerError, json.JSONDecodeError, OSError) as exc:
                response = {"returncode": 78, "stdout": "", "stderr": f"kandev-agent-docker: {exc}\n"}
            except Exception as exc:  # fail closed without killing the broker
                print(f"kandev-agent-docker-broker: internal error: {exc}", file=sys.stderr)
                response = {"returncode": 70, "stdout": "", "stderr": "kandev-agent-docker: internal broker error\n"}
        self.wfile.write(json.dumps(response).encode() + b"\n")


class ThreadedUnixServer(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True
    broker_key: bytes


def load_or_create_key() -> bytes:
    KEY_PATH.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not KEY_PATH.exists():
        KEY_PATH.write_text(secrets.token_hex(32))
        KEY_PATH.chmod(0o600)
    return KEY_PATH.read_text().strip().encode()


def main() -> int:
    key = load_or_create_key()
    SOCKET_PATH.unlink(missing_ok=True)
    server = ThreadedUnixServer(str(SOCKET_PATH), BrokerHandler)
    server.broker_key = key
    SOCKET_PATH.chmod(0o600)
    print(f"kandev-agent-docker-broker: listening on {SOCKET_PATH}", file=sys.stderr)
    try:
        server.serve_forever()
    finally:
        server.server_close()
        SOCKET_PATH.unlink(missing_ok=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
