#!/usr/bin/env python3
"""Narrow host worker for coordinator-to-Codex support requests."""

from __future__ import annotations

import json
import hashlib
import os
from pathlib import Path
import secrets
import sqlite3
import subprocess
import threading
import time
import uuid
from contextlib import contextmanager
from datetime import datetime, timezone


QUEUE = Path(os.environ.get("KANDEV_SUPPORT_QUEUE", Path.home() / ".local/share/kandev/support-broker"))
REPOSITORY = Path(os.environ.get("KANDEV_SUPPORT_REPOSITORY", Path.home() / "Code/kandev"))
SOURCE_REPOSITORY = Path(
    os.environ.get("KANDEV_SUPPORT_SOURCE_REPOSITORY", Path.home() / "Code/kandev-source")
)
THREAD_ID = os.environ.get("KANDEV_SUPPORT_THREAD_ID", "")
CODEX = os.environ.get("KANDEV_SUPPORT_CODEX", "codex")
KANDEV_DB = Path(
    os.environ.get("KANDEV_SUPPORT_DB", Path.home() / ".local/share/kandev/data/kandev.db")
)
NOTIFIER = Path(
    os.environ.get("KANDEV_SUPPORT_NOTIFIER", REPOSITORY / "scripts/kandev-support-notify")
)
WRITER_CONFLICT = "already has an active writer"
STATUS_PREFIX = "KANDEV_SUPPORT_STATUS:"
RESOLVED = "RESOLVED"
BLOCKED = "BLOCKED"
MAX_BLOCKED_ESCALATIONS = 2


@contextmanager
def temporary_operator_token():
    """Mint and revoke a short-lived local token for one coordinator delivery."""
    prefix = secrets.token_hex(4)
    token = f"kandev_pat_{prefix}_{secrets.token_urlsafe(32)}"
    token_id = str(uuid.uuid4())
    now = datetime.now(timezone.utc)
    database = sqlite3.connect(KANDEV_DB, timeout=30)
    try:
        database.execute("PRAGMA busy_timeout = 30000")
        user = database.execute(
            "SELECT id FROM users WHERE role='admin' AND status='active' "
            "ORDER BY created_at, id LIMIT 1"
        ).fetchone()
        if user is None:
            raise RuntimeError("no active Kandev administrator is available")
        database.execute(
            "INSERT INTO auth_api_tokens "
            "(id,user_id,name,prefix,token_sha256,created_at,expires_at) "
            "VALUES (?,?,?,?,?,?,datetime(?,'unixepoch'))",
            (
                token_id,
                user[0],
                "kandev-support-notifier",
                prefix,
                hashlib.sha256(token.encode()).hexdigest(),
                now.isoformat(),
                now.timestamp() + 300,
            ),
        )
        database.commit()
        yield token
    finally:
        try:
            database.execute("DELETE FROM auth_api_tokens WHERE id=?", (token_id,))
            database.commit()
        finally:
            database.close()


def coordinator_session(record: dict[str, str]) -> tuple[str, str]:
    """Resolve the newest live primary session for the requesting coordinator."""
    database = sqlite3.connect(f"file:{KANDEV_DB}?mode=ro", uri=True, timeout=30)
    try:
        row = database.execute(
            "SELECT id,state FROM task_sessions WHERE task_id=? "
            "AND state IN ('RUNNING','WAITING_FOR_INPUT','STARTING') "
            "ORDER BY is_primary DESC, updated_at DESC LIMIT 1",
            (record["coordinator_task_id"],),
        ).fetchone()
    finally:
        database.close()
    if row is None:
        raise RuntimeError("requesting coordinator has no live session")
    return str(row[0]), str(row[1])


def notification_content(record: dict[str, str], response: dict[str, object]) -> str:
    outcome = str(response.get("resolution_status", "failed")).upper()
    stdout = str(response.get("stdout", ""))[-24000:]
    stderr = str(response.get("stderr", ""))[-8000:]
    parts = [
        "KANDEV SUPPORT RESULT",
        f"Request ID: {record['id']}",
        f"Outcome: {outcome}",
        "This result was delivered proactively; no human relay or status polling was required.",
        "Review it, run the requested acceptance check, and reply through a new Support request if the result is incomplete or exposes another platform defect.",
    ]
    if stdout:
        parts.extend(("Support response:", stdout))
    if stderr:
        parts.extend(("Support diagnostics:", stderr))
    return "\n".join(parts)


def delivered_notification_exists(record: dict[str, str]) -> bool:
    database = sqlite3.connect(f"file:{KANDEV_DB}?mode=ro", uri=True, timeout=30)
    try:
        row = database.execute(
            "SELECT 1 FROM task_session_messages WHERE task_id=? AND author_type='user' "
            "AND instr(content, ?) > 0 LIMIT 1",
            (record["coordinator_task_id"], f"Request ID: {record['id']}"),
        ).fetchone()
        return row is not None
    finally:
        database.close()


def queued_notification_entry(record: dict[str, str], session_id: str) -> str:
    database = sqlite3.connect(f"file:{KANDEV_DB}?mode=ro", uri=True, timeout=30)
    try:
        row = database.execute(
            "SELECT id FROM queued_messages WHERE task_id=? AND session_id=? "
            "AND instr(content, ?) > 0 ORDER BY position LIMIT 1",
            (record["coordinator_task_id"], session_id, f"Request ID: {record['id']}"),
        ).fetchone()
        return "" if row is None else str(row[0])
    finally:
        database.close()


def notify_coordinator(record: dict[str, str], response: dict[str, object]) -> str:
    if delivered_notification_exists(record):
        return "already-delivered"
    session_id, session_state = coordinator_session(record)
    entry_id = queued_notification_entry(record, session_id)
    if entry_id:
        mode = "send_now"
    elif session_state in {"RUNNING", "STARTING"}:
        mode = "queue"
    else:
        mode = "add"
    payload = {
        "task_id": record["coordinator_task_id"],
        "session_id": session_id,
        "content": notification_content(record, response),
        "mode": mode,
    }
    if entry_id:
        payload["entry_id"] = entry_id
    with temporary_operator_token() as token:
        payload["token"] = token
        completed = subprocess.run(
            [str(NOTIFIER)],
            input=json.dumps(payload),
            text=True,
            capture_output=True,
            timeout=30,
            check=False,
        )
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.strip() or "coordinator notification failed")
    try:
        message_id = str(json.loads(completed.stdout)["message_id"])
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
        raise RuntimeError("coordinator notification returned no message receipt") from exc
    if mode == "queue":
        if queued_notification_entry(record, session_id) != message_id:
            raise RuntimeError("coordinator notification queue receipt is not durable")
        raise RuntimeError(f"coordinator busy; Support result queued as {message_id}")
    for _ in range(10):
        if delivered_notification_exists(record):
            return message_id
        time.sleep(0.1)
    if not delivered_notification_exists(record):
        raise RuntimeError("coordinator notification was acknowledged but is not durable")
    return message_id


def prompt(record: dict[str, str]) -> str:
    lines = [
        "KANDEV SUPPORT REQUEST",
        f"Coordinator task ID: {record['coordinator_task_id']}",
        f"Workspace/worktree: {record['worktree']}",
        f"Problem: {record['problem']}",
        f"Evidence: {record['evidence']}",
        f"Expected outcome: {record['expected_outcome']}",
        f"Security constraints: {record['security_constraints']}",
        f"Broker request ID: {record['id']}",
        "This request arrived through the reviewed Kandev Support broker.",
        f"Deployment checkout: {REPOSITORY}",
        f"Kandev source checkout: {SOURCE_REPOSITORY}",
        "Inspect both checkouts before declaring a Kandev platform issue upstream-only. The source checkout is an explicitly writable Support scope; preserve unrelated or untracked user files and commit only the requested fix.",
        "For kdlbs/kandev source work, upstream/main is the canonical project base and origin/main is the personal fork. Fetch and verify the named remote/revision before creating any clean worktree; never infer that unqualified origin/main is canonical.",
        "Own safe in-scope support work through implementation and verification. Inspect the live state, apply and persist the fix when the request authorizes it, run proportionate acceptance tests, and send the verified outcome back to the Coordinator. A diagnosis, recommendation, command list, or upstream-only classification alone is not completion when local source, deployment, host-service, or broker remediation remains possible.",
        "Route by capability: use the deployment checkout for host/image/policy fixes and the source checkout for Kandev platform fixes. Request reviewed host escalation when needed. Retry transient contention with bounded backoff. Do not ask the human to relay messages.",
        "When a tool reports that a script is still running and returns a cell or session identifier, wait or poll that exact execution through completion before any dependent command. A yielded tool is not a completed tool; starting another linter, build, or commit can create self-contention and a false terminal blocker.",
        "Interpret security constraints by boundary. A request saying not to expose the raw Docker socket, host paths, devices, credentials, or authority to an AGENT does not prohibit this reviewed host Support worker from using read-only host diagnostics to verify that boundary. It prohibits granting that capability to the coordinator/task or weakening the resulting policy. Only treat a diagnostic as prohibited when the request explicitly forbids Support itself from using it.",
        "If an external authority or irreversible high-stakes decision is truly required, return a precise BLOCKED escalation with evidence and safe options. An initial BLOCKED result is automatically re-routed through a higher scrutiny pass before it can become terminal.",
        "Begin the final response with exactly one of: KANDEV_SUPPORT_STATUS: RESOLVED or KANDEV_SUPPORT_STATUS: BLOCKED. Use RESOLVED only when the expected outcome is actually achieved and verified. Use BLOCKED only after exhausting safe in-scope routes; name the precise missing authority or external dependency and the smallest next action. Never report RESOLVED merely because the Codex turn itself exited successfully.",
    ]
    if record.get("_prior_blocked_response"):
        lines.extend((
            f"AUTOMATIC ESCALATION PASS {record.get('_blocked_escalation_attempts', 1)} of {MAX_BLOCKED_ESCALATIONS}.",
            "The prior pass returned BLOCKED and is not terminal. Audit whether it confused an agent-facing restriction with Support's reviewed host authority, overlooked either checkout, or failed to request an available reviewed escalation. Resolve the request if any safe route remains.",
            "Prior blocked response:",
            str(record["_prior_blocked_response"])[-12000:],
        ))
    return "\n".join(lines)


def resolution_status(stdout: str) -> str | None:
    """Extract the explicit support outcome from the worker-owned final answer."""
    for line in stdout.splitlines():
        if line.startswith(STATUS_PREFIX):
            value = line.removeprefix(STATUS_PREFIX).strip()
            return value if value in {RESOLVED, BLOCKED} else None
    return None


def process(path: Path) -> None:
    processing = QUEUE / "processing" / path.name
    path.replace(processing)
    record = json.loads(processing.read_text(encoding="utf-8"))
    print(f"Kandev Support processing {record['id']}", flush=True)
    try:
        completed = subprocess.run(
            [
                CODEX,
                "exec",
                "--approve-for-me",
                "--add-dir",
                str(SOURCE_REPOSITORY),
                "resume",
                THREAD_ID,
                prompt(record),
            ],
            cwd=REPOSITORY,
            text=True,
            capture_output=True,
            timeout=3600,
            check=False,
            env={**os.environ, "KANDEV_SUPPORT_BROKER_REQUEST_ID": record["id"]},
        )
        response = {"returncode": completed.returncode, "stdout": completed.stdout[-1024 * 1024:], "stderr": completed.stderr[-256 * 1024:]}
    except Exception as exc:
        response = {"returncode": 70, "stdout": "", "stderr": f"Kandev Support worker failed: {exc}\n"}
    if response["returncode"] != 0 and WRITER_CONFLICT in response["stderr"]:
        # A support chat turn and a broker delivery cannot write the same Codex
        # thread concurrently. This is expected backpressure, not completion.
        # Keep the request queued and retry with capped exponential backoff.
        attempts = int(record.get("_writer_conflict_attempts", 0)) + 1
        record["_writer_conflict_attempts"] = attempts
        record["_next_attempt_at"] = time.time() + min(60, 2 ** min(attempts, 6))
        processing.write_text(json.dumps(record), encoding="utf-8")
        processing.replace(QUEUE / "pending" / processing.name)
        print(f"Kandev Support requeued {record['id']}: support thread busy", flush=True)
        return
    if response["returncode"] == 0:
        outcome = resolution_status(response["stdout"])
        response["resolution_status"] = outcome.lower() if outcome else "invalid"
        if outcome == BLOCKED:
            escalations = int(record.get("_blocked_escalation_attempts", 0))
            if escalations < MAX_BLOCKED_ESCALATIONS:
                record["_blocked_escalation_attempts"] = escalations + 1
                record["_prior_blocked_response"] = response["stdout"][-12000:]
                record["_next_attempt_at"] = time.time() + min(30, 2 ** escalations)
                processing.write_text(json.dumps(record), encoding="utf-8")
                processing.replace(QUEUE / "pending" / processing.name)
                print(
                    f"Kandev Support escalated blocked request {record['id']}: "
                    f"pass {escalations + 1}/{MAX_BLOCKED_ESCALATIONS}",
                    flush=True,
                )
                return
            response["returncode"] = 75
        elif outcome != RESOLVED:
            response["returncode"] = 70
            response["stderr"] += (
                "Kandev Support worker contract violation: final response must begin with "
                f"'{STATUS_PREFIX} {RESOLVED}' or '{STATUS_PREFIX} {BLOCKED}'.\n"
            )
    else:
        response["resolution_status"] = "failed"
    responses = QUEUE / "responses"
    responses.mkdir(parents=True, mode=0o700, exist_ok=True)
    temporary = responses / f".{record['id']}.tmp"
    temporary.write_text(json.dumps(response), encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(responses / f"{record['id']}.json")
    processing.unlink(missing_ok=True)
    try:
        message_id = notify_coordinator(record, response)
        response["coordinator_notification"] = "delivered"
        response["coordinator_message_id"] = message_id
        response_path = responses / f"{record['id']}.json"
        response_path.write_text(json.dumps(response), encoding="utf-8")
        response_path.chmod(0o600)
    except Exception as exc:
        response["coordinator_notification"] = "failed"
        response["notification_error"] = str(exc)
        # Persist the delivery failure for automatic retry rather than silently
        # requiring the human or Coordinator to discover it by polling.
        response_path = responses / f"{record['id']}.json"
        response_path.write_text(json.dumps(response), encoding="utf-8")
        response_path.chmod(0o600)
        notification = QUEUE / "notifications"
        notification.mkdir(parents=True, mode=0o700, exist_ok=True)
        notification_path = notification / f"{record['id']}.json"
        notification_path.write_text(json.dumps(record), encoding="utf-8")
        notification_path.chmod(0o600)
        print(f"Kandev Support notification queued {record['id']}: {exc}", flush=True)
    print(
        f"Kandev Support completed {record['id']}: "
        f"status={response['resolution_status']} returncode={response['returncode']}",
        flush=True,
    )


def recover_interrupted() -> None:
    """Return requests interrupted by a worker restart to the pending queue."""
    for processing in (QUEUE / "processing").glob("*.json"):
        request_id = processing.stem
        if (QUEUE / "responses" / f"{request_id}.json").exists():
            processing.unlink(missing_ok=True)
        else:
            processing.replace(QUEUE / "pending" / processing.name)


def retry_notifications(*, ignore_backoff: bool = False) -> bool:
    """Retry result delivery independently from Support request execution."""
    for path in sorted((QUEUE / "notifications").glob("*.json")):
        record = json.loads(path.read_text(encoding="utf-8"))
        if not ignore_backoff and float(record.get("_notification_next_at", 0)) > time.time():
            continue
        response_path = QUEUE / "responses" / path.name
        if not response_path.exists():
            continue
        response = json.loads(response_path.read_text(encoding="utf-8"))
        try:
            message_id = notify_coordinator(record, response)
        except Exception as exc:
            attempts = int(record.get("_notification_attempts", 0)) + 1
            record["_notification_attempts"] = attempts
            record["_notification_next_at"] = time.time() + min(60, 2 ** min(attempts, 6))
            path.write_text(json.dumps(record), encoding="utf-8")
            path.chmod(0o600)
            print(f"Kandev Support notification retry {record['id']}: {exc}", flush=True)
            continue
        response["coordinator_notification"] = "delivered"
        response["coordinator_message_id"] = message_id
        response.pop("notification_error", None)
        response_path.write_text(json.dumps(response), encoding="utf-8")
        response_path.chmod(0o600)
        path.unlink()
        print(f"Kandev Support notification delivered {record['id']}", flush=True)
        return True
    return False


def notification_loop() -> None:
    """Keep delivery live while a long Support remediation turn is running."""
    while True:
        delivered = retry_notifications()
        time.sleep(60 if delivered else 2)


def audit_notifications() -> None:
    """Repair false-positive acknowledgements from older notifier versions."""
    for response_path in (QUEUE / "responses").glob("*.json"):
        response = json.loads(response_path.read_text(encoding="utf-8"))
        if response.get("coordinator_notification") != "delivered" or response.get("coordinator_message_id"):
            continue
        record_path = QUEUE / "records" / response_path.name
        if not record_path.exists():
            continue
        record = json.loads(record_path.read_text(encoding="utf-8"))
        if delivered_notification_exists(record):
            response["coordinator_message_id"] = "legacy-observed"
            response_path.write_text(json.dumps(response), encoding="utf-8")
            response_path.chmod(0o600)
            continue
        response["coordinator_notification"] = "failed"
        response["notification_error"] = "legacy acknowledgement was not durable"
        response_path.write_text(json.dumps(response), encoding="utf-8")
        response_path.chmod(0o600)
        notification_path = QUEUE / "notifications" / response_path.name
        notification_path.write_text(json.dumps(record), encoding="utf-8")
        notification_path.chmod(0o600)
        print(f"Kandev Support recovered undelivered notification {record['id']}", flush=True)


def pending_requests() -> list[Path]:
    """Return requests oldest-first; UUID filenames do not preserve queue order."""
    candidates: list[tuple[str, str, Path]] = []
    for path in (QUEUE / "pending").glob("*.json"):
        try:
            created_at = str(json.loads(path.read_text()).get("created_at", ""))
        except (OSError, ValueError, json.JSONDecodeError):
            created_at = ""
        candidates.append((created_at, path.name, path))
    return [path for _, _, path in sorted(candidates)]


def main() -> int:
    if not THREAD_ID:
        raise SystemExit("KANDEV_SUPPORT_THREAD_ID is required")
    for directory in ("pending", "processing", "records", "responses", "notifications"):
        (QUEUE / directory).mkdir(parents=True, mode=0o700, exist_ok=True)
    recover_interrupted()
    audit_notifications()
    threading.Thread(target=notification_loop, name="support-notifications", daemon=True).start()
    while True:
        pending = pending_requests()
        ready = None
        now = time.time()
        for candidate in pending:
            try:
                if float(json.loads(candidate.read_text()).get("_next_attempt_at", 0)) <= now:
                    ready = candidate
                    break
            except (OSError, ValueError, json.JSONDecodeError):
                ready = candidate
                break
        if ready is not None:
            process(ready)
        else:
            time.sleep(2)


if __name__ == "__main__":
    raise SystemExit(main())
