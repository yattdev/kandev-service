#!/usr/bin/env python3
"""Narrow host worker for coordinator-to-Codex support requests."""

from __future__ import annotations

import json
import os
from pathlib import Path
import subprocess
import time


QUEUE = Path(os.environ.get("KANDEV_SUPPORT_QUEUE", Path.home() / ".local/share/kandev/support-broker"))
REPOSITORY = Path(os.environ.get("KANDEV_SUPPORT_REPOSITORY", Path.home() / "Code/kandev"))
THREAD_ID = os.environ.get("KANDEV_SUPPORT_THREAD_ID", "")
CODEX = os.environ.get("KANDEV_SUPPORT_CODEX", "codex")
WRITER_CONFLICT = "already has an active writer"
STATUS_PREFIX = "KANDEV_SUPPORT_STATUS:"
RESOLVED = "RESOLVED"
BLOCKED = "BLOCKED"


def prompt(record: dict[str, str]) -> str:
    return "\n".join((
        "KANDEV SUPPORT REQUEST",
        f"Coordinator task ID: {record['coordinator_task_id']}",
        f"Workspace/worktree: {record['worktree']}",
        f"Problem: {record['problem']}",
        f"Evidence: {record['evidence']}",
        f"Expected outcome: {record['expected_outcome']}",
        f"Security constraints: {record['security_constraints']}",
        f"Broker request ID: {record['id']}",
        "This request arrived through the reviewed Kandev Support broker.",
        "Own safe in-scope support work through implementation and verification. Inspect the live state, apply and persist the fix when the request authorizes it, run proportionate acceptance tests, and send the verified outcome back to the Coordinator. A diagnosis, recommendation, or command list alone is not completion when the expected outcome asks Support to fix or unblock something.",
        "Begin the final response with exactly one of: KANDEV_SUPPORT_STATUS: RESOLVED or KANDEV_SUPPORT_STATUS: BLOCKED. Use RESOLVED only when the expected outcome is actually achieved and verified. Use BLOCKED only after exhausting safe in-scope routes; name the precise missing authority or external dependency and the smallest next action. Never report RESOLVED merely because the Codex turn itself exited successfully.",
    ))


def resolution_status(stdout: str) -> str | None:
    """Extract the explicit support outcome from the worker-owned final answer."""
    for line in stdout.splitlines():
        if line.startswith(STATUS_PREFIX):
            value = line.removeprefix(STATUS_PREFIX).strip()
            return value if value in {RESOLVED, BLOCKED} else None
    return None


def process(path: Path) -> None:
    processing = QUEUE / "processing" / path.name
    path.replace(processing)
    record = json.loads(processing.read_text(encoding="utf-8"))
    print(f"Kandev Support processing {record['id']}", flush=True)
    try:
        completed = subprocess.run(
            [CODEX, "exec", "--approve-for-me", "resume", THREAD_ID, prompt(record)],
            cwd=REPOSITORY,
            text=True,
            capture_output=True,
            timeout=3600,
            check=False,
            env={**os.environ, "KANDEV_SUPPORT_BROKER_REQUEST_ID": record["id"]},
        )
        response = {"returncode": completed.returncode, "stdout": completed.stdout[-1024 * 1024:], "stderr": completed.stderr[-256 * 1024:]}
    except Exception as exc:
        response = {"returncode": 70, "stdout": "", "stderr": f"Kandev Support worker failed: {exc}\n"}
    if response["returncode"] != 0 and WRITER_CONFLICT in response["stderr"]:
        # A support chat turn and a broker delivery cannot write the same Codex
        # thread concurrently. This is expected backpressure, not completion.
        # Keep the request queued and retry with capped exponential backoff.
        attempts = int(record.get("_writer_conflict_attempts", 0)) + 1
        record["_writer_conflict_attempts"] = attempts
        record["_next_attempt_at"] = time.time() + min(60, 2 ** min(attempts, 6))
        processing.write_text(json.dumps(record), encoding="utf-8")
        processing.replace(QUEUE / "pending" / processing.name)
        print(f"Kandev Support requeued {record['id']}: support thread busy", flush=True)
        return
    if response["returncode"] == 0:
        outcome = resolution_status(response["stdout"])
        response["resolution_status"] = outcome.lower() if outcome else "invalid"
        if outcome == BLOCKED:
            response["returncode"] = 75
        elif outcome != RESOLVED:
            response["returncode"] = 70
            response["stderr"] += (
                "Kandev Support worker contract violation: final response must begin with "
                f"'{STATUS_PREFIX} {RESOLVED}' or '{STATUS_PREFIX} {BLOCKED}'.\n"
            )
    else:
        response["resolution_status"] = "failed"
    responses = QUEUE / "responses"
    responses.mkdir(parents=True, mode=0o700, exist_ok=True)
    temporary = responses / f".{record['id']}.tmp"
    temporary.write_text(json.dumps(response), encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(responses / f"{record['id']}.json")
    processing.unlink(missing_ok=True)
    print(
        f"Kandev Support completed {record['id']}: "
        f"status={response['resolution_status']} returncode={response['returncode']}",
        flush=True,
    )


def recover_interrupted() -> None:
    """Return requests interrupted by a worker restart to the pending queue."""
    for processing in (QUEUE / "processing").glob("*.json"):
        request_id = processing.stem
        if (QUEUE / "responses" / f"{request_id}.json").exists():
            processing.unlink(missing_ok=True)
        else:
            processing.replace(QUEUE / "pending" / processing.name)


def pending_requests() -> list[Path]:
    """Return requests oldest-first; UUID filenames do not preserve queue order."""
    candidates: list[tuple[str, str, Path]] = []
    for path in (QUEUE / "pending").glob("*.json"):
        try:
            created_at = str(json.loads(path.read_text()).get("created_at", ""))
        except (OSError, ValueError, json.JSONDecodeError):
            created_at = ""
        candidates.append((created_at, path.name, path))
    return [path for _, _, path in sorted(candidates)]


def main() -> int:
    if not THREAD_ID:
        raise SystemExit("KANDEV_SUPPORT_THREAD_ID is required")
    for directory in ("pending", "processing", "records", "responses"):
        (QUEUE / directory).mkdir(parents=True, mode=0o700, exist_ok=True)
    recover_interrupted()
    while True:
        pending = pending_requests()
        ready = None
        now = time.time()
        for candidate in pending:
            try:
                if float(json.loads(candidate.read_text()).get("_next_attempt_at", 0)) <= now:
                    ready = candidate
                    break
            except (OSError, ValueError, json.JSONDecodeError):
                ready = candidate
                break
        if ready is not None:
            process(ready)
        else:
            time.sleep(2)


if __name__ == "__main__":
    raise SystemExit(main())
