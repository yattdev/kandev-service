#!/usr/bin/env bash
# Kernel-enforced per-agent filesystem boundary for Kandev.
set -euo pipefail

GUARD_NAME="kandev-agent-guard"

deny() {
    echo "ERROR: $GUARD_NAME: $*" >&2
    exit 78
}

[[ "${1:-}" == "--" ]] && shift
[[ "$#" -gt 0 ]] || deny "no agent command supplied"
command -v bwrap >/dev/null 2>&1 || deny "bubblewrap is not installed"

cwd="$(pwd -P)" || deny "cannot resolve working directory"
host_code="${KANDEV_HOST_CODE_DIR:-}"
kandev_db="${KANDEV_DB:-/data/data/kandev.db}"
coordinator_source="/data/home/Code/coordinator"
coordinator_host_source="${host_code:+$host_code/coordinator}"
coordinator_task_id=""
coordinator_session_id=""
coordinator_workspace_id=""
coordinator_workspace_name=""
declare -a coordinator_scope_paths
coordinator_scope_paths=()

# Return the first child below a managed root. Dot-prefixed children are
# intentionally excluded so recovery/staging directories can never become an
# agent workspace.
managed_child() {
    local base="$1" path="$2" rel child
    [[ "$path" == "$base"/* ]] || return 1
    rel="${path#"$base"/}"
    child="${rel%%/*}"
    [[ -n "$child" && "$child" != .* && "$child" != "." && "$child" != ".." ]] || return 1
    printf '%s/%s\n' "$base" "$child"
}

# Resolve the nearest Git repository containing path, without granting an
# entire first-level Code directory when repositories are nested below it.
# Hidden path components remain reserved for recovery/control data.
git_root_below() {
    local base="$1" path="$2" probe rel component
    [[ "$path" == "$base"/* ]] || return 1
    probe="$path"
    while [[ "$probe" == "$base"/* ]]; do
        if [[ -e "$probe/.git" && ! -L "$probe/.git" ]]; then
            rel="${probe#"$base"/}"
            while IFS= read -r component; do
                [[ -n "$component" && "$component" != .* ]] || return 1
            done < <(printf '%s\n' "$rel" | tr '/' '\n')
            printf '%s\n' "$probe"
            return 0
        fi
        probe="$(dirname "$probe")"
    done
    return 1
}

writable_root=""
case "$cwd" in
    /data/tasks/*)
        writable_root="$(managed_child /data/tasks "$cwd")" || true
        ;;
    /data/quick-chat/*)
        writable_root="$(managed_child /data/quick-chat "$cwd")" || true
        ;;
    /data/repos/workspaces/*)
        # Managed clones are deeper than the workspace UUID. Prefer the nearest
        # Git root so one clone cannot modify another clone in the workspace.
        boundary="$(managed_child /data/repos/workspaces "$cwd")" || true
        probe="$cwd"
        while [[ -n "${boundary:-}" && "$probe" == "$boundary"/* ]]; do
            if [[ -e "$probe/.git" ]]; then
                writable_root="$probe"
                break
            fi
            probe="$(dirname "$probe")"
        done
        [[ -n "$writable_root" ]] || writable_root="${boundary:-}"
        ;;
    /data/home/Code/*)
        writable_root="$(git_root_below /data/home/Code "$cwd")" || true
        ;;
    *)
        if [[ -n "$host_code" && "$cwd" == "$host_code"/* ]]; then
            writable_root="$(git_root_below "$host_code" "$cwd")" || true
        fi
        ;;
esac

[[ -n "$writable_root" ]] || deny "working directory is outside an approved project/task root: $cwd"
[[ -d "$writable_root" ]] || deny "approved writable root does not exist: $writable_root"
writable_root="$(realpath -e -- "$writable_root")" || deny "cannot resolve writable root"
[[ "$cwd" == "$writable_root" || "$cwd" == "$writable_root"/* ]] || deny "working directory escapes writable root"

agent_docker_socket="/run/kandev-agent-docker/broker.sock"
agent_docker_target="/run/kandev-agent-docker.sock"
agent_docker_token=""
declare -a agent_docker_env
agent_docker_env=()
if [[ -S "$agent_docker_socket" && -x /usr/local/bin/kandev-agent-docker-token ]]; then
    agent_docker_token="$(/usr/local/bin/kandev-agent-docker-token "$writable_root")" \
        || deny "cannot mint task-scoped Docker token"
    agent_docker_env=(
        --setenv KANDEV_AGENT_DOCKER_SOCKET "$agent_docker_target"
        --setenv KANDEV_AGENT_DOCKER_ROOT "$writable_root"
        --setenv KANDEV_AGENT_DOCKER_TOKEN "$agent_docker_token"
    )
fi

declare -a bwrap_args
declare -A bound
bwrap_args=(
    --die-with-parent
    --new-session
    --unshare-user
    --unshare-pid
    --unshare-ipc
    --unshare-uts
    --ro-bind / /
    --dev /dev
    --tmpfs /tmp
    --tmpfs /run
    --bind "$writable_root" "$writable_root"
)
bound["$writable_root"]=1

# Expose only the constrained broker socket, never /var/run/docker.sock or the
# broker's HMAC key. /run is otherwise a fresh tmpfs inside the agent boundary.
if [[ -n "$agent_docker_token" ]]; then
    bwrap_args+=(--bind "$agent_docker_socket" "$agent_docker_target")
fi

add_rw_bind() {
    local path="$1" resolved
    [[ -e "$path" && ! -L "$path" ]] || return 0
    resolved="$(realpath -e -- "$path")" || deny "cannot resolve writable support path: $path"
    case "$resolved" in
        /data/home/Code|/data/home/Code/*)
            deny "support path resolves into protected Code tree: $path"
            ;;
    esac
    if [[ -n "$host_code" && ( "$resolved" == "$host_code" || "$resolved" == "$host_code"/* ) ]]; then
        deny "support path resolves into protected host Code tree: $path"
    fi
    [[ -z "${bound[$resolved]:-}" ]] || return 0
    bwrap_args+=(--bind "$resolved" "$resolved")
    bound["$resolved"]=1
}

add_coordinator_rw_bind() {
    local kind="$1" path="$2" resolved child
    [[ -e "$path" && ! -L "$path" ]] || return 0
    resolved="$(realpath -e -- "$path")" || deny "cannot resolve coordinator workspace path: $path"
    case "$kind:$resolved" in
        task:/data/tasks/*)
            child="$(managed_child /data/tasks "$resolved")" \
                || deny "invalid coordinator task scope: $resolved"
            [[ "$child" == "$resolved" ]] \
                || deny "coordinator task scope is not a direct task root: $resolved"
            ;;
        repo:/data/home/Code/*|folder:/data/home/Code/*)
            ;;
        repo:/data/repos/workspaces/"$coordinator_workspace_id"/*|folder:/data/repos/workspaces/"$coordinator_workspace_id"/*)
            ;;
        repo:/data/tasks/*|folder:/data/tasks/*)
            ;;
        *)
            deny "registered coordinator workspace path is outside approved roots: $resolved"
            ;;
    esac
    [[ "$resolved" != "/data/home/Code" && "$resolved" != "/data/tasks" ]] \
        || deny "coordinator scope cannot make a managed parent writable: $resolved"
    [[ -z "${bound[$resolved]:-}" ]] || return 0
    bwrap_args+=(--bind "$resolved" "$resolved")
    bound["$resolved"]=1
    coordinator_scope_paths+=("$kind:$resolved")
}

coordinator_metadata() {
    local task_dir rows attested_task attested_session attested_workspace
    [[ -f "$kandev_db" && "$writable_root" == /data/tasks/* ]] || return 1
    attested_task="${KANDEV_TASK_ID:-}"
    attested_session="${KANDEV_SESSION_ID:-}"
    attested_workspace="${KANDEV_WORKSPACE_ID:-}"
    task_dir="${writable_root#/data/tasks/}"
    [[ "$task_dir" != */* && "$task_dir" =~ ^[A-Za-z0-9_-]+$ ]] || return 1

    # Newer backends can explicitly attest all three launch identifiers. Any
    # partial or malformed attestation fails closed instead of falling back to
    # inference, so an agent cannot selectively unset a mismatched identifier.
    if [[ -n "$attested_task" || -n "$attested_session" || -n "$attested_workspace" ]]; then
        [[ "$attested_task" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ \
           && "$attested_session" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ \
           && "$attested_workspace" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 1
        rows="$(sqlite3 -noheader -separator '|' "file:$kandev_db?mode=ro" "
            SELECT DISTINCT t.id, t.workspace_id, w.name, ts.id
            FROM task_environments te
            JOIN tasks t ON t.id = te.task_id
            JOIN workspaces w ON w.id = t.workspace_id
            JOIN task_sessions ts ON ts.task_id = t.id
            WHERE te.task_dir_name = '$task_dir'
              AND t.id = '$attested_task'
              AND t.workspace_id = '$attested_workspace'
              AND ts.id = '$attested_session'
              AND ts.state IN ('CREATED', 'STARTING', 'RUNNING', 'WAITING_FOR_INPUT')
              AND t.archived_at IS NULL
              AND (SELECT COUNT(*) FROM task_repositories tr WHERE tr.task_id = t.id) = 1
              AND EXISTS (
                  SELECT 1
                  FROM task_repositories tr
                  JOIN repositories r ON r.id = tr.repository_id
                  WHERE tr.task_id = t.id
                    AND r.workspace_id = t.workspace_id
                    AND r.local_path = '$coordinator_source'
                    AND r.deleted_at IS NULL
              );
        ")" || return 1
    else
        # Kandev v0.92 does not export launch identifiers to agent commands.
        # In that case, derive them from the exact materialized task root and
        # require one—and only one—currently starting/running session. The DB,
        # not an agent-controlled name or environment value, is authoritative.
        rows="$(sqlite3 -noheader -separator '|' "file:$kandev_db?mode=ro" "
            SELECT DISTINCT t.id, t.workspace_id, w.name, ts.id
            FROM task_environments te
            JOIN tasks t ON t.id = te.task_id
            JOIN workspaces w ON w.id = t.workspace_id
            JOIN task_sessions ts ON ts.task_id = t.id
            WHERE te.task_dir_name = '$task_dir'
              AND t.archived_at IS NULL
              AND ts.state IN ('STARTING', 'RUNNING')
              AND (ts.workspace_path = '$writable_root'
                   OR ts.workspace_path LIKE '$writable_root/%')
              AND (SELECT COUNT(*) FROM task_repositories tr WHERE tr.task_id = t.id) = 1
              AND EXISTS (
                  SELECT 1
                  FROM task_repositories tr
                  JOIN repositories r ON r.id = tr.repository_id
                  WHERE tr.task_id = t.id
                    AND r.workspace_id = t.workspace_id
                    AND r.local_path = '$coordinator_source'
                    AND r.deleted_at IS NULL
              );
        ")" || return 1
    fi
    [[ -n "$rows" && "$rows" != *$'\n'* ]] || return 1
    IFS='|' read -r coordinator_task_id coordinator_workspace_id coordinator_workspace_name coordinator_session_id <<<"$rows"
    [[ "$coordinator_task_id" =~ ^[0-9a-f-]{36}$ \
       && "$coordinator_session_id" =~ ^[0-9a-f-]{36}$ \
       && "$coordinator_workspace_id" =~ ^[0-9a-f-]{36}$ ]] || return 1
}

coordinator_still_authorized() {
    local rows
    rows="$(sqlite3 -noheader "file:$kandev_db?mode=ro" "
        SELECT t.id
        FROM task_environments te
        JOIN tasks t ON t.id = te.task_id
        JOIN task_sessions ts ON ts.task_id = t.id
        WHERE te.task_dir_name = '${writable_root#/data/tasks/}'
          AND t.id = '$coordinator_task_id'
          AND t.workspace_id = '$coordinator_workspace_id'
          AND ts.id = '$coordinator_session_id'
          AND ts.state IN ('CREATED', 'STARTING', 'RUNNING', 'WAITING_FOR_INPUT')
          AND t.archived_at IS NULL
          AND (SELECT COUNT(*) FROM task_repositories tr WHERE tr.task_id = t.id) = 1
          AND EXISTS (
              SELECT 1
              FROM task_repositories tr
              JOIN repositories r ON r.id = tr.repository_id
              WHERE tr.task_id = t.id
                AND r.workspace_id = t.workspace_id
                AND r.local_path = '$coordinator_source'
                AND r.deleted_at IS NULL
          );
    ")" || return 1
    [[ "$rows" == "$coordinator_task_id" ]]
}

audit_coordinator_scope() {
    local event="$1"
    shift
    /usr/bin/python3 - "$event" "$coordinator_task_id" "$coordinator_session_id" "$coordinator_workspace_id" \
        "$cwd" "${coordinator_scope_paths[@]}" <<'PY'
import datetime
import json
import os
import sys

event, task_id, session_id, workspace_id, cwd, *paths = sys.argv[1:]
audit_path = os.environ.get(
    "KANDEV_COORDINATOR_SCOPE_AUDIT_LOG",
    "/data/logs/coordinator-workspace-audit.jsonl",
)
record = {
    "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "event": event,
    "task_id": task_id,
    "session_id": session_id,
    "workspace_id": workspace_id,
    "cwd": cwd,
    "rw_scope": paths,
}
os.makedirs(os.path.dirname(audit_path), mode=0o700, exist_ok=True)
with open(audit_path, "a", encoding="utf-8") as handle:
    handle.write(json.dumps(record, sort_keys=True) + "\n")
PY
}

# Language runtimes, package caches, and per-agent state remain usable. SSH and
# the global Git config are deliberately omitted and therefore stay read-only.
for support_path in \
    /data/.npm-global \
    /data/home/.bundle \
    /data/home/.cache \
    /data/home/.cargo \
    /data/home/.claude \
    /data/home/.claude.json \
    /data/home/.codex \
    /data/home/.composer \
    /data/home/.config \
    /data/home/.copilot \
    /data/home/.gem \
    /data/home/.local \
    /data/home/.npm \
    /data/home/.rustup
do
    add_rw_bind "$support_path"
done

path_is_code_repo_gitdir() {
    local path="$1" base rel repo_rel component
    for base in /data/home/Code "$host_code"; do
        [[ -n "$base" && "$path" == "$base"/*/.git ]] || continue
        rel="${path#"$base"/}"
        repo_rel="${rel%/.git}"
        [[ -n "$repo_rel" && "$repo_rel" != "$rel" ]] || continue
        while IFS= read -r component; do
            [[ -n "$component" && "$component" != .* ]] || continue 2
        done < <(printf '%s\n' "$repo_rel" | tr '/' '\n')
        [[ -d "$base/$repo_rel" && ! -L "$base/$repo_rel" ]] && return 0
    done
    return 1
}

# Linked task worktrees store objects/refs in the source repository's .git
# directory. The common directory must be writable for normal Git operations,
# but its worktrees registry is overlaid read-only and only this worktree's
# administrative entry is rebound writable. This prevents an ordinary task
# from corrupting a sibling worktree's index/HEAD metadata.
declare -a git_markers
git_markers=("$writable_root/.git")
coordinator_backlink=0
while IFS= read -r -d '' marker; do
    git_markers+=("$marker")
done < <(find "$writable_root" -mindepth 2 -maxdepth 2 -name .git -print0 2>/dev/null)

for marker in "${git_markers[@]}"; do
    [[ -f "$marker" && ! -L "$marker" ]] || continue
    gitdir_line="$(sed -n 's/^gitdir: //p' "$marker" | head -n 1)"
    [[ -n "$gitdir_line" ]] || deny "invalid Git worktree marker: $marker"
    if [[ "$gitdir_line" != /* ]]; then
        gitdir_line="$(dirname "$marker")/$gitdir_line"
    fi
    gitdir="$(realpath -e -- "$gitdir_line")" || deny "missing Git worktree directory for $marker"
    common="$gitdir"
    if [[ -f "$gitdir/commondir" ]]; then
        common_rel="$(head -n 1 "$gitdir/commondir")"
        common="$(realpath -e -- "$gitdir/$common_rel")" || deny "missing Git common directory for $marker"
    fi
    path_is_code_repo_gitdir "$common" || deny "Git common directory is outside an approved Code repository: $common"

    # A task-controlled .git file must not be able to nominate some unrelated
    # repository. Git records the reverse link in .git/worktrees/<id>/gitdir;
    # require that registration to point back to this exact marker.
    [[ "$gitdir" == "$common"/worktrees/* ]] || deny "Git worktree directory is outside its common directory: $gitdir"
    gitdir_id="${gitdir#"$common"/worktrees/}"
    [[ -n "$gitdir_id" && "$gitdir_id" != */* ]] || deny "invalid Git worktree directory: $gitdir"
    [[ -f "$gitdir/gitdir" ]] || deny "Git worktree backlink is missing: $gitdir/gitdir"
    backlink_line="$(head -n 1 "$gitdir/gitdir")"
    [[ -n "$backlink_line" ]] || deny "Git worktree backlink is empty: $gitdir/gitdir"
    if [[ "$backlink_line" != /* ]]; then
        backlink_line="$gitdir/$backlink_line"
    fi
    backlink="$(realpath -e -- "$backlink_line")" || deny "Git worktree backlink is invalid: $gitdir/gitdir"
    marker_real="$(realpath -e -- "$marker")" || deny "cannot resolve Git worktree marker: $marker"
    [[ "$backlink" == "$marker_real" ]] || deny "Git worktree backlink does not match marker: $marker"
    if [[ -z "${bound[$common]:-}" ]]; then
        bwrap_args+=(--bind "$common" "$common")
        bound["$common"]=1
    fi

    if [[ -d "$common/worktrees" ]]; then
        bwrap_args+=(--ro-bind "$common/worktrees" "$common/worktrees")
        bwrap_args+=(--bind "$gitdir" "$gitdir")
    fi

    # The backlink is necessary but not sufficient for coordinator elevation;
    # live platform metadata is validated below on every guarded launch.
    source_root="${common%/.git}"
    if [[ "$source_root" == "$coordinator_source" \
          || ( -n "$coordinator_host_source" && "$source_root" == "$coordinator_host_source" ) ]]; then
        coordinator_backlink=1
    fi
done

# A validated Coordinator receives exact registered resources from its own
# workspace. The parent Code/tasks mounts remain read-only, and eligibility is
# derived from the live task/session registration rather than an agent claim or
# directory name. Re-evaluation below revokes a long-lived process promptly if
# that registration ceases to be valid.
if [[ "$coordinator_backlink" == "1" ]] && coordinator_metadata; then
    while IFS='|' read -r kind path; do
        [[ -n "$kind" && -n "$path" ]] || continue
        add_coordinator_rw_bind "$kind" "$path"
    done < <(sqlite3 -noheader -separator '|' "file:$kandev_db?mode=ro" "
        SELECT 'task', '/data/tasks/' || te.task_dir_name
        FROM task_environments te
        JOIN tasks t ON t.id = te.task_id
        WHERE t.workspace_id = '$coordinator_workspace_id'
          AND t.archived_at IS NULL
          AND te.task_dir_name <> ''
        UNION
        SELECT 'repo', r.local_path
        FROM repositories r
        WHERE r.workspace_id = '$coordinator_workspace_id'
          AND r.deleted_at IS NULL
          AND r.local_path <> ''
        UNION
        SELECT 'folder', twf.local_path
        FROM task_workspace_folders twf
        JOIN tasks t ON t.id = twf.task_id
        WHERE t.workspace_id = '$coordinator_workspace_id'
          AND t.archived_at IS NULL
          AND twf.local_path <> '';
    ")
    audit_coordinator_scope "scope_granted" \
        || deny "cannot audit coordinator workspace scope"
fi

if [[ "${KANDEV_AGENT_GUARD_DEBUG:-0}" == "1" ]]; then
    echo "$GUARD_NAME: cwd=$cwd writable_root=$writable_root" >&2
    for path in "${!bound[@]}"; do echo "$GUARD_NAME: rw=$path" >&2; done
fi

run_guarded=(
    bwrap "${bwrap_args[@]}"
    --setenv KANDEV_AGENT_GUARD_ACTIVE 1
    --setenv TMPDIR /tmp
    "${agent_docker_env[@]}"
    --chdir "$cwd"
    -- "$@"
)

if [[ -z "$coordinator_task_id" ]]; then
    exec "${run_guarded[@]}"
fi

"${run_guarded[@]}" &
guarded_pid=$!
forward_signal() {
    kill -TERM "$guarded_pid" 2>/dev/null || true
}
trap forward_signal HUP INT TERM
authorization_ticks=0
while kill -0 "$guarded_pid" 2>/dev/null; do
    sleep 1
    kill -0 "$guarded_pid" 2>/dev/null || break
    authorization_ticks=$((authorization_ticks + 1))
    (( authorization_ticks >= 15 )) || continue
    authorization_ticks=0
    if ! coordinator_still_authorized; then
        audit_coordinator_scope "scope_revoked" || true
        kill -TERM "$guarded_pid" 2>/dev/null || true
        wait "$guarded_pid" 2>/dev/null || true
        deny "coordinator workspace authorization was revoked"
    fi
done
wait "$guarded_pid"
